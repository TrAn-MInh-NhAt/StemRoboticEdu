<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Quản Lý Học Liệu - STEM Robotic Edu' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    :root {
      --c-bg: #F4F6F8;
      --c-surface: #FFFFFF;
      --c-text-main: #0B0F19;
      --c-text-dim: #505F79;
      --c-primary: #5A52FF;
      --c-secondary: #FF5E5E;
      --c-accent: #FFB800;
      --c-success: #047857;
      --c-error: #DC2626;
      --c-dark-pod: #0B0F19;
      --c-telemetry: #38BDF8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--c-bg);
      background-image: radial-gradient(rgba(11, 15, 25, 0.05) 2px, transparent 2px);
      background-size: 32px 32px;
      color: var(--c-text-main);
      min-height: 100vh;
      padding: 32px 24px;
      position: relative;
    }

    .blob {
      position: fixed;
      width: 450px;
      height: 450px;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.15;
      pointer-events: none;
      z-index: 0;
    }
    .blob-1 { top: -100px; left: -100px; background: var(--c-primary); }
    .blob-2 { bottom: -100px; right: -100px; background: var(--c-accent); }

    .container {
      max-width: 1360px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    /* HEADER */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 28px;
      background: var(--c-surface);
      border: 1px solid rgba(11, 15, 25, 0.08);
      border-radius: 24px;
      padding: 16px 24px;
      box-shadow: 4px 4px 0 #0B0F19;
    }

    .brand-title {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 800;
      font-size: 24px;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-badge {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 50px;
      background: #0B0F19;
      color: #F4F6F8;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 13px;
      font-weight: 600;
    }

    .nav-links {
      display: flex;
      gap: 10px;
    }

    .nav-btn {
      padding: 8px 16px;
      border-radius: 50px;
      border: 1.5px solid #0B0F19;
      text-decoration: none;
      color: #0B0F19;
      font-weight: 600;
      font-size: 13px;
      background: #FFFFFF;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .nav-btn:hover {
      background: var(--c-primary);
      color: #FFFFFF;
      box-shadow: 2px 2px 0 #0B0F19;
      transform: translate(-2px, -2px);
    }
    .nav-btn.active {
      background: #0B0F19;
      color: #F4F6F8;
    }

    /* BANNER CANH BAO DF-05 */
    .df05-banner {
      background: #FFF1F2;
      border: 2px solid var(--c-error);
      border-radius: 24px;
      padding: 18px 24px;
      margin-bottom: 28px;
      box-shadow: 4px 4px 0 var(--c-error);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }
    .df05-content {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .telemetry-pulse {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--c-error);
      box-shadow: 0 0 0 rgba(220, 38, 38, 0.5);
      animation: pulse 1.8s infinite;
      flex-shrink: 0;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); }
      100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
    .df05-text h4 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 16px;
      color: var(--c-error);
      margin-bottom: 4px;
    }
    .df05-text p {
      font-size: 13px;
      color: #7F1D1D;
    }

    /* BENTO GRID */
    .bento-grid {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 24px;
    }

    @media (max-width: 1024px) {
      .bento-grid { grid-template-columns: 1fr; }
    }

    .bento-card {
      background: var(--c-surface);
      border: 1px solid rgba(11, 15, 25, 0.08);
      border-radius: 32px;
      padding: 28px;
      box-shadow: 6px 6px 0 #0B0F19;
    }

    .card-head {
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1.5px dashed rgba(11, 15, 25, 0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .card-head h3 {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-weight: 700;
      font-size: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* FORM STYLES */
    .form-group {
      margin-bottom: 18px;
    }
    .form-label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--c-text-main);
    }
    .form-control {
      width: 100%;
      padding: 12px 16px;
      font-family: inherit;
      font-size: 14px;
      background: #F9FAFB;
      border: 1.5px solid rgba(11, 15, 25, 0.12);
      border-radius: 16px;
      outline: none;
      transition: all 0.2s ease;
    }
    .form-control:focus {
      border-color: var(--c-primary);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(90, 82, 255, 0.15);
    }
    textarea.form-control {
      resize: vertical;
      min-height: 110px;
      line-height: 1.5;
    }

    .btn-playful {
      background: #0B0F19;
      color: #FFFFFF;
      border: 2px solid #0B0F19;
      border-radius: 50px;
      padding: 12px 24px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 4px 4px 0 var(--c-primary);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      width: 100%;
    }
    .btn-playful:hover {
      transform: translate(-3px, -3px);
      box-shadow: 7px 7px 0 var(--c-primary);
    }
    .btn-playful:active {
      transform: translate(1px, 1px);
      box-shadow: 2px 2px 0 var(--c-primary);
    }

    /* FILTERS BAR */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1.5px dashed rgba(11, 15, 25, 0.12);
    }
    .chip {
      padding: 6px 14px;
      border-radius: 50px;
      font-size: 12px;
      font-weight: 600;
      border: 1px solid rgba(11, 15, 25, 0.12);
      background: #FFFFFF;
      color: var(--c-text-dim);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .chip:hover, .chip.active {
      background: var(--c-primary);
      color: #FFFFFF;
      border-color: var(--c-primary);
      box-shadow: 2px 2px 0 #0B0F19;
    }

    /* MATERIAL TABLE / LIST */
    .mat-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 10px;
    }
    .mat-table th {
      text-align: left;
      font-size: 12px;
      font-weight: 700;
      color: var(--c-text-dim);
      text-transform: uppercase;
      padding: 8px 14px;
    }
    .mat-row {
      background: #FFFFFF;
      border: 1px solid rgba(11, 15, 25, 0.08);
      box-shadow: 2px 2px 0 rgba(11, 15, 25, 0.08);
      transition: all 0.15s ease;
    }
    .mat-row:hover {
      box-shadow: 4px 4px 0 #0B0F19;
      transform: translate(-2px, -2px);
    }
    .mat-row td {
      padding: 14px;
      vertical-align: middle;
      font-size: 13px;
    }
    .mat-row td:first-child {
      border-top-left-radius: 16px;
      border-bottom-left-radius: 16px;
      border-left: 1px solid rgba(11, 15, 25, 0.08);
      border-top: 1px solid rgba(11, 15, 25, 0.08);
      border-bottom: 1px solid rgba(11, 15, 25, 0.08);
    }
    .mat-row td:last-child {
      border-top-right-radius: 16px;
      border-bottom-right-radius: 16px;
      border-right: 1px solid rgba(11, 15, 25, 0.08);
      border-top: 1px solid rgba(11, 15, 25, 0.08);
      border-bottom: 1px solid rgba(11, 15, 25, 0.08);
    }

    .badge-status {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 50px;
      font-size: 11px;
      font-weight: 700;
    }
    .badge-published { background: #ECFDF5; color: var(--c-success); border: 1px solid #A7F3D0; }
    .badge-draft { background: #F3F4F6; color: var(--c-text-dim); border: 1px solid #E5E7EB; }
    .badge-hidden { background: #FEF2F2; color: var(--c-error); border: 1px solid #FECACA; }
    .badge-warn { background: #FFFBEB; color: #B45309; border: 1px solid #FDE68A; }

    .action-btn {
      padding: 6px 12px;
      border-radius: 50px;
      border: 1.5px solid #0B0F19;
      background: #FFFFFF;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .action-btn:hover {
      box-shadow: 2px 2px 0 #0B0F19;
      transform: translate(-1px, -1px);
    }
    .action-btn.hide-btn {
      background: #FEF2F2;
      color: var(--c-error);
      border-color: var(--c-error);
    }
    .action-btn.hide-btn:hover {
      background: var(--c-error);
      color: #FFFFFF;
      box-shadow: 2px 2px 0 #0B0F19;
    }

    /* MODAL CANH BAO BLOCKED */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(11, 15, 25, 0.6);
      z-index: 1000;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .modal-card {
      background: #FFFFFF;
      border: 2px solid #0B0F19;
      border-radius: 28px;
      max-width: 520px;
      width: 100%;
      padding: 28px;
      box-shadow: 8px 8px 0 var(--c-secondary);
      animation: popIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes popIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body>
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <div class="container">
    <!-- TOP BAR -->
    <header class="top-bar">
      <div class="brand-title">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0B0F19" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span>STEM Robotic Edu</span>
        <span class="brand-badge">Phân hệ 2 - QTHL & TCPP</span>
      </div>

      <nav class="nav-links">
        <a href="/materials/quan-ly" class="nav-btn active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Quản trị Học liệu (GV)
        </a>
        <a href="/materials/tra-cuu" class="nav-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Tra cứu Linh kiện & Pinout (HS)
        </a>
        <a href="/" class="nav-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          Trang chủ
        </a>
      </nav>

      <div class="user-info">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5A52FF" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
        <span><%= typeof user !== 'undefined' ? user.HoTen : 'Phạm Thị Hà Vy' %> (Giáo viên)</span>
      </div>
    </header>

    <!-- BANNER CANH BAO DF-05 -->
    <% if (typeof warnings !== 'undefined' && warnings.length > 0) { %>
    <section class="df05-banner">
      <div class="df05-content">
        <div class="telemetry-pulse"></div>
        <div class="df05-text">
          <h4>Cảnh báo Tỷ lệ Làm bài Lỗi > 30% (Luồng DF-05)</h4>
          <p>Hệ thống máy chấm tự động phát hiện <strong><%= warnings.length %></strong> học liệu có học sinh mắc lỗi biên dịch / phần cứng cao. Giảng viên cần bổ sung thêm mẹo sửa lỗi hoặc code mẫu.</p>
        </div>
      </div>
      <div>
        <a href="#table-section" class="action-btn" style="background: #0B0F19; color: #FFFFFF;">
          Xem danh sách cần cập nhật
        </a>
      </div>
    </section>
    <% } %>

    <!-- BENTO GRID -->
    <div class="bento-grid">
      <!-- FORM THEM / SUA HOC LIEU (QTHL.01) -->
      <aside class="bento-card">
        <div class="card-head">
          <h3 id="form-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Thêm Mới Học Liệu
          </h3>
          <span class="badge-status badge-draft" id="mode-badge">QTHL.01</span>
        </div>

        <form id="form-hoc-lieu" onsubmit="handleFormSubmit(event)">
          <input type="hidden" id="edit-id" value="">

          <div class="form-group">
            <label class="form-label">Tiêu đề học liệu / Tên bài giảng *</label>
            <input type="text" id="tenHocLieu" class="form-control" placeholder="VD: Cảm biến TCRT5000 — Pinout & Đấu nối" required>
          </div>

          <div class="form-group">
            <label class="form-label">Lộ trình / Khóa học</label>
            <select id="maLoTrinh" class="form-control">
              <option value="">-- Chọn lộ trình học tập --</option>
              <% if (typeof loTrinhList !== 'undefined') { %>
                <% loTrinhList.forEach(lt => { %>
                  <option value="<%= lt.MaLoTrinh %>">[<%= lt.ChuDe %>] <%= lt.TenLoTrinh %></option>
                <% }) %>
              <% } %>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Loại học liệu *</label>
            <select id="loaiHocLieu" class="form-control" onchange="checkLoaiHocLieuNotice(this.value)">
              <option value="Tài liệu">Tài liệu văn bản</option>
              <option value="Code mẫu">Code mẫu (.ino / .cpp)</option>
              <option value="Linh kiện">Thông số Linh kiện & Pinout</option>
              <option value="Sơ đồ 3D">Sơ đồ 3D / Lắp ráp cơ khí</option>
              <option value="Video">Video bài giảng (hỗ trợ tua chậm)</option>
            </select>
            <small id="loai-notice" style="display: none; color: var(--c-primary); font-size: 11px; margin-top: 4px; display: block;">
              Ràng buộc QTHL.01: Sơ đồ 3D bắt buộc phải có thông số linh kiện và sơ đồ chân Pinout đi kèm.
            </small>
          </div>

          <div class="form-group">
            <label class="form-label">Nội dung chi tiết & Thông số Pinout *</label>
            <textarea id="noiDung" class="form-control" placeholder="Nhập mô tả, nguyên lý hoạt động, bảng chân Pinout, lưu ý điện áp..." required></textarea>
          </div>

          <div class="form-group">
            <label class="form-label">Đường dẫn tệp đính kèm / Video</label>
            <input type="text" id="duongDanTep" class="form-control" placeholder="/uploads/materials/guide_tcrt5000.pdf">
          </div>

          <div class="form-group">
            <label class="form-label">Trạng thái xuất bản</label>
            <select id="trangThai" class="form-control">
              <option value="Xuất bản">Xuất bản (Học sinh xem được)</option>
              <option value="Bản nháp">Bản nháp (Lưu tạm)</option>
              <option value="Ẩn">Ẩn khỏi người dùng</option>
            </select>
          </div>

          <button type="submit" class="btn-playful" id="btn-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Lưu Học Liệu
          </button>
          <button type="button" class="action-btn" id="btn-cancel" style="display: none; width: 100%; margin-top: 8px; justify-content: center;" onclick="resetForm()">
            Hủy chỉnh sửa
          </button>
        </form>
      </aside>

      <!-- DANH SACH HOC LIEU (QTHL.02) -->
      <main class="bento-card" id="table-section">
        <div class="card-head">
          <h3>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            Danh Sách Học Liệu Hiện Có
          </h3>
          <span style="font-size: 13px; font-weight: 700; color: var(--c-text-dim);">
            Tổng cộng: <strong><%= typeof hocLieuList !== 'undefined' ? hocLieuList.length : 0 %></strong> học liệu
          </span>
        </div>

        <!-- FILTER BAR -->
        <div class="filter-bar">
          <a href="/materials/quan-ly" class="chip <%= (!filters || (!filters.chuDe && !filters.trangThai)) ? 'active' : '' %>">Tất cả</a>
          <a href="/materials/quan-ly?chuDe=Cơ khí" class="chip <%= (filters && filters.chuDe === 'Cơ khí') ? 'active' : '' %>">Cơ khí</a>
          <a href="/materials/quan-ly?chuDe=Mạch điện" class="chip <%= (filters && filters.chuDe === 'Mạch điện') ? 'active' : '' %>">Mạch điện</a>
          <a href="/materials/quan-ly?chuDe=Lập trình" class="chip <%= (filters && filters.chuDe === 'Lập trình') ? 'active' : '' %>">Lập trình</a>
          <a href="/materials/quan-ly?trangThai=Xuất bản" class="chip <%= (filters && filters.trangThai === 'Xuất bản') ? 'active' : '' %>">Đã Xuất Bản</a>
          <a href="/materials/quan-ly?trangThai=Ẩn" class="chip <%= (filters && filters.trangThai === 'Ẩn') ? 'active' : '' %>">Đang Ẩn</a>
        </div>

        <!-- TABLE -->
        <div style="overflow-x: auto;">
          <table class="mat-table">
            <thead>
              <tr>
                <th style="width: 60px;">Mã</th>
                <th>Tên Học Liệu / Bài Giảng</th>
                <th>Chủ Đề</th>
                <th>Phân Loại</th>
                <th>Trạng Thái</th>
                <th style="text-align: right;">Thao Tác</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof hocLieuList !== 'undefined' && hocLieuList.length > 0) { %>
                <% hocLieuList.forEach(item => { %>
                  <tr class="mat-row" id="row-<%= item.MaHocLieu %>">
                    <td>
                      <span style="font-family: monospace; font-weight: 700;">#<%= item.MaHocLieu %></span>
                    </td>
                    <td>
                      <div style="font-weight: 700; color: #0B0F19; margin-bottom: 2px;">
                        <%= item.TenHocLieu %>
                      </div>
                      <% if (item.CoCanCapNhat) { %>
                        <span class="badge-status badge-warn">
                          DF-05: Cần bổ sung mẹo sửa lỗi (>30% học sinh mắc lỗi)
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <span style="font-size: 12px; font-weight: 600; color: var(--c-text-dim);">
                        <%= item.ChuDe || 'Chung' %>
                      </span>
                    </td>
                    <td>
                      <span class="badge-status badge-draft"><%= item.LoaiHocLieu %></span>
                    </td>
                    <td>
                      <% if (item.TrangThai === 'Xuất bản') { %>
                        <span class="badge-status badge-published">Xuất bản</span>
                      <% } else if (item.TrangThai === 'Ẩn') { %>
                        <span class="badge-status badge-hidden">Đang Ẩn</span>
                      <% } else { %>
                        <span class="badge-status badge-draft">Bản nháp</span>
                      <% } %>
                    </td>
                    <td style="text-align: right; white-space: nowrap;">
                      <button class="action-btn" onclick="populateEdit(<%= JSON.stringify(item) %>)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Sửa
                      </button>

                      <button class="action-btn <%= item.TrangThai !== 'Ẩn' ? 'hide-btn' : '' %>" onclick="toggleHide(<%= item.MaHocLieu %>, '<%= item.TrangThai %>')">
                        <% if (item.TrangThai !== 'Ẩn') { %>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                          Ẩn
                        <% } else { %>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                          Hiện
                        <% } %>
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; padding: 40px; color: var(--c-text-dim);">
                    Không có học liệu nào phù hợp với bộ lọc hiện tại.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <!-- MODAL RANG BUOC CHIEU SAU (QTHL.02 - TINH LIEN MACH) -->
  <div class="modal-overlay" id="block-modal">
    <div class="modal-card">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 14px;">
        <div style="background: #FEF2F2; color: var(--c-error); width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2px solid var(--c-error);">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <h3 style="font-family: 'Bricolage Grotesque', sans-serif; font-size: 18px; color: #0B0F19;">
            Từ Chối Ẩn Học Liệu (Ràng buộc QTHL.02)
          </h3>
          <span style="font-size: 12px; color: var(--c-error); font-weight: 700;">Vi phạm tính liền mạch bài tập</span>
        </div>
      </div>

      <p id="block-message" style="font-size: 14px; color: #374151; line-height: 1.5; margin-bottom: 16px;">
        Học liệu này không thể ẩn vì đang có dự án bài tập mở hoặc kỳ thi trực tuyến đang diễn ra.
      </p>

      <div style="background: #F9FAFB; border: 1.5px dashed rgba(11, 15, 25, 0.15); border-radius: 16px; padding: 14px; margin-bottom: 20px;">
        <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 8px; color: var(--c-text-dim);">
          Dự án bài tập đang mở:
        </div>
        <ul id="block-list" style="font-size: 13px; padding-left: 20px; color: #1F2937;">
        </ul>
      </div>

      <div style="display: flex; justify-content: flex-end;">
        <button class="action-btn" style="background: #0B0F19; color: #FFFFFF; padding: 10px 20px;" onclick="closeModal()">
          Đã hiểu, giữ lại học liệu
        </button>
      </div>
    </div>
  </div>

  <script>
    function checkLoaiHocLieuNotice(val) {
      const notice = document.getElementById('loai-notice');
      if (val === 'Sơ đồ 3D') {
        notice.style.display = 'block';
        notice.innerText = 'Ràng buộc QTHL.01: Bắt buộc điền thông số linh kiện và thứ tự chân Pinout vào ô nội dung.';
      } else if (val === 'Video') {
        notice.style.display = 'block';
        notice.innerText = 'Chuẩn QTHL.01: Trình phát video bài giảng hỗ trợ tính năng tua chậm (0.5x, 0.75x).';
      } else {
        notice.style.display = 'none';
      }
    }

    function populateEdit(item) {
      document.getElementById('edit-id').value = item.MaHocLieu;
      document.getElementById('tenHocLieu').value = item.TenHocLieu;
      document.getElementById('maLoTrinh').value = item.MaLoTrinh || '';
      document.getElementById('loaiHocLieu').value = item.LoaiHocLieu;
      document.getElementById('noiDung').value = item.NoiDung || '';
      document.getElementById('duongDanTep').value = item.DuongDanTep || '';
      document.getElementById('trangThai').value = item.TrangThai;

      document.getElementById('form-title').innerText = 'Chỉnh Sửa Học Liệu #' + item.MaHocLieu;
      document.getElementById('mode-badge').innerText = 'Chỉnh sửa';
      document.getElementById('btn-cancel').style.display = 'inline-flex';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetForm() {
      document.getElementById('edit-id').value = '';
      document.getElementById('form-hoc-lieu').reset();
      document.getElementById('form-title').innerText = 'Thêm Mới Học Liệu';
      document.getElementById('mode-badge').innerText = 'QTHL.01';
      document.getElementById('btn-cancel').style.display = 'none';
      document.getElementById('loai-notice').style.display = 'none';
    }

    async function handleFormSubmit(e) {
      e.preventDefault();
      const id = document.getElementById('edit-id').value;
      const payload = {
        tenHocLieu: document.getElementById('tenHocLieu').value.trim(),
        maLoTrinh: document.getElementById('maLoTrinh').value || null,
        loaiHocLieu: document.getElementById('loaiHocLieu').value,
        noiDung: document.getElementById('noiDung').value,
        duongDanTep: document.getElementById('duongDanTep').value.trim() || null,
        trangThai: document.getElementById('trangThai').value
      };

      const url = id ? `/materials/api/update/${id}` : '/materials/api/create';
      const method = id ? 'PUT' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Thao tác thành công!');
          window.location.reload();
        } else {
          alert('Lỗi: ' + data.message);
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ: ' + err.message);
      }
    }

    async function toggleHide(id, currentStatus) {
      try {
        const res = await fetch(`/materials/api/hide/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();

        if (data.success) {
          window.location.reload();
        } else if (data.blocked) {
          // Hien modal canh bao rang buoc BU-04
          document.getElementById('block-message').innerText = data.message;
          const listEl = document.getElementById('block-list');
          listEl.innerHTML = '';
          if (data.activeExercises && data.activeExercises.length > 0) {
            data.activeExercises.forEach(ex => {
              const li = document.createElement('li');
              li.innerText = `${ex.TenDuAn} (Hạn nộp: ${new Date(ex.HanNop).toLocaleDateString('vi-VN')})`;
              listEl.appendChild(li);
            });
          }
          document.getElementById('block-modal').style.display = 'flex';
        } else {
          alert('Lỗi: ' + data.message);
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ: ' + err.message);
      }
    }

    function closeModal() {
      document.getElementById('block-modal').style.display = 'none';
    }
  </script>
</body>
</html>
