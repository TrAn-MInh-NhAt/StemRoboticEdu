<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cộng đồng STEM Robotic &amp; Bảng Vinh Danh (Wall of Fame)</title>
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <!-- Nền Blobs lơ lửng -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="app-shell">
    <!-- Sidebar Studio Kỹ Thuật (Neo-Brutalist Slate) -->
    <aside class="sidebar">
      <a href="<%= user.VaiTro === 'Admin' ? '/admin' : (user.VaiTro === 'Giáo viên' ? '/teacher' : '/student') %>" class="sidebar-brand" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px;" title="Về Không gian làm việc">
        <div class="brand-symbol">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="#FFF" fill="none" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <div class="brand-title">STEM Robotic</div>
          <div class="brand-tag">Cộng đồng &amp; Vinh danh</div>
        </div>
      </a>

      <!-- Thẻ người dùng: Bấm để vào Hồ sơ cá nhân -->
      <a href="/profile" class="sidebar-user-card" title="Xem & Cập nhật Hồ sơ cá nhân">
        <div class="user-avatar-circle" style="background: var(--c-primary); color: #FFF;">
          <%= user.HoTen.charAt(user.HoTen.lastIndexOf(' ') + 1) || 'C' %>
        </div>
        <div class="user-meta">
          <div class="user-name" style="display: flex; align-items: center; gap: 6px;">
            <span><%= user.HoTen %></span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="user-role-label">Hồ sơ cá nhân · #<%= user.MaNguoiDung %></div>
        </div>
      </a>

      <!-- Menu Điều Hướng Đồng Bộ Theo Vai Trò -->
      <ul class="sidebar-nav">
        <% if (user.VaiTro === 'Học sinh') { %>
          <li class="sidebar-nav-item">
            <a href="/student" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Lộ trình &amp; Dự án</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/student?view=submission" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span>Nộp bài thực hành</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/student?view=judge" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
              <span>Khoang máy chấm</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/student?view=lookup" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              <span>Tra cứu linh kiện &amp; Lỗi</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/student?view=history" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Lịch sử &amp; Bảng điểm</span>
            </a>
          </li>
        <% } else if (user.VaiTro === 'Giáo viên') { %>
          <li class="sidebar-nav-item">
            <a href="/teacher" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
              <span>Duyệt Video Thẩm Định</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/teacher?view=createProject" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
              <span>Giao dự án &amp; TestCase</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/teacher?view=materials" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Học liệu &amp; Bài giảng</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/teacher?view=allSubs" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <span>Tất cả bài nộp</span>
            </a>
          </li>
        <% } else if (user.VaiTro === 'Admin') { %>
          <li class="sidebar-nav-item">
            <a href="/admin" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
              <span>Tổng quan Hệ thống</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/admin?view=accounts" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Quản lý Tài khoản</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/admin?view=tickets" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span>Phiếu Sự Cố</span>
            </a>
          </li>
          <li class="sidebar-nav-item">
            <a href="/admin?view=announcements" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <span>Thông Báo HT</span>
            </a>
          </li>
        <% } %>

        <!-- Cộng đồng & Vinh danh (Đang hoạt động - Mở sẵn) -->
        <li class="sidebar-nav-item sidebar-dropdown open" id="commDropdownPage">
          <button type="button" class="sidebar-dropdown-toggle active" onclick="toggleSidebarDropdown(this)">
            <div style="display: flex; align-items: center; gap: 12px;">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              <span>Cộng đồng &amp; Vinh danh</span>
            </div>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="sidebar-submenu">
            <li>
              <a href="#wallOfFameSection" class="sidebar-sub-link active">
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Bảng Vinh Danh</span>
              </a>
            </li>
            <li>
              <a href="#forumSection" class="sidebar-sub-link">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>Diễn đàn Trao đổi</span>
              </a>
            </li>
            <li>
              <a href="javascript:void(0)" onclick="openNewPostModal()" class="sidebar-sub-link">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span>Đăng thảo luận mới</span>
              </a>
            </li>
          </ul>
        </li>

        <% if (user.VaiTro === 'Học sinh' || user.VaiTro === 'Giáo viên') { %>
          <li class="sidebar-nav-item">
            <a href="/exam" class="sidebar-nav-link" style="color: var(--c-secondary);">
              <svg viewBox="0 0 24 24" style="stroke: var(--c-secondary);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Phòng thi trực tuyến</span>
            </a>
          </li>
        <% } %>

        <% if (user.VaiTro === 'Giáo viên' || user.VaiTro === 'Admin') { %>
          <li class="sidebar-nav-item">
            <a href="/api/reports/grades-csv" target="_blank" class="sidebar-nav-link">
              <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span>Xuất bảng điểm (.CSV)</span>
            </a>
          </li>
        <% } %>

        <li class="sidebar-nav-item" style="margin-top: 14px;">
          <a href="/" class="sidebar-nav-link" style="color: #94A3B8;">
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            <span>Về Trang Chủ (/)</span>
          </a>
        </li>
      </ul>

      <div class="sidebar-footer">
        <a href="/logout" class="btn-sidebar-logout">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Đăng xuất tài khoản</span>
        </a>
      </div>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <!-- Breadcrumb -->
      <div style="font-size: 0.85rem; color: var(--c-text-dim); margin-bottom: 24px; font-weight: 600;">
        <span>Không gian sáng tạo</span>
        <span style="margin: 0 8px;">/</span>
        <span style="color: var(--c-primary);">Cộng đồng &amp; Bảng Vinh Danh Robotic</span>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
        <div>
          <h1 style="font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em;">
            Cộng Đồng &amp; <span class="title-highlight">Bảng Vinh Danh</span>
          </h1>
          <p style="font-size: 0.95rem; color: var(--c-text-dim); margin-top: 4px;">
            Không gian trao đổi thuật toán điều khiển, chia sẻ giải pháp phần cứng và vinh danh các dự án Robot xuất sắc của phòng Lab.
          </p>
        </div>
        <button class="btn-playful btn-playful-primary btn-sm" onclick="openNewPostModal()">
          + Đăng Thảo Luận Mới
        </button>
      </div>

      <!-- 1. BẢNG VINH DANH -->
      <section id="wallOfFameSection" style="margin-bottom: 40px;">
        <div class="bento-card" style="background: linear-gradient(145deg, #3730A3, #1E1B4B); color: #FFFFFF; padding: 28px 32px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <div>
            <span class="tech-chip" style="background: rgba(255,255,255,0.2); color: #FFFFFF; font-weight: 700; margin-bottom: 8px; display: inline-block;">
              Top Dự Án Tiêu Biểu Phòng Lab
            </span>
            <h2 style="font-size: 1.6rem; font-weight: 800; color: #FFF;">
              Bảng Vinh Danh Dự Án Robotic Xuất Sắc
            </h2>
            <p style="font-size: 0.95rem; color: #FFFFFF; opacity: 0.92; margin-top: 4px; text-wrap: pretty;">
              Tự động xếp hạng và tôn vinh các công trình Robot đạt điểm tối đa (100% TestCase và Video vận hành đạt chuẩn phần cứng).
            </p>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="loadWallOfFame()">Làm mới</button>
        </div>

        <div class="bento-grid" id="fameGrid">
          <p class="text-muted" style="font-size: 0.95rem; padding: 20px 0; grid-column: 1/-1;">Đang tải danh sách dự án vinh danh...</p>
        </div>
      </section>

      <!-- 2. DIỄN ĐÀN TRAO ĐỔI & TOP TRENDING -->
      <section id="forumSection" class="card" style="border: 1.5px solid rgba(11, 15, 25, 0.08); margin-bottom: 36px;">
        <div class="card-header">
          <div>
            <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: #3730A3; font-weight: 700; margin-bottom: 8px; display: inline-block;">
              Cộng Đồng Kỹ Thuật Robotics
            </span>
            <h2 class="card-title" style="font-size: 1.4rem; font-weight: 800;">Diễn Đàn Thảo Luận Kỹ Thuật &amp; Gỡ Lỗi</h2>
            <p class="card-subtitle">
              Nơi giao lưu học hỏi, chia sẻ mẹo chống nhiễu cảm biến, tối ưu Timer/PWM và giải quyết lỗi vi điều khiển.
            </p>
          </div>
          <button class="btn btn-primary" onclick="openNewPostModal()" id="newPostModalBtn">
            + Đăng Thảo Luận Mới
          </button>
        </div>

        <!-- Bộ lọc tab & DF-03 -->
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 24px;">
          <button class="btn btn-secondary btn-sm active" data-filter="all" onclick="filterPosts('all', this)">Tất cả chủ đề</button>
          <button class="btn btn-secondary btn-sm" data-filter="trending" onclick="filterPosts('trending', this)">Top Trending (DF-03)</button>
          <button class="btn btn-secondary btn-sm" data-filter="Thảo luận" onclick="filterPosts('Thảo luận', this)">Thảo luận chung</button>
          <button class="btn btn-secondary btn-sm" data-filter="Chia sẻ lỗi" onclick="filterPosts('Chia sẻ lỗi', this)">Kinh nghiệm gỡ lỗi</button>
        </div>

        <div id="postsContainer">
          <p class="text-muted" style="font-size: 0.95rem; padding: 24px 0;">Đang tải các chủ đề thảo luận...</p>
        </div>
      </section>
    </main>
  </div>

  <!-- Modal Đăng bài mới (TTCĐ.01) -->
  <div class="modal-overlay" id="postModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3 style="font-size: 1.15rem; font-weight: 800;">Tạo Chủ Đề Thảo Luận Mới</h3>
        <button class="btn btn-secondary btn-sm" onclick="closeNewPostModal()">Đóng</button>
      </div>
      <div style="padding: 24px;">
        <form id="newPostForm">
          <div class="form-group">
            <label class="form-label" for="postTitle">Tiêu đề bài viết *</label>
            <input type="text" id="postTitle" name="tieuDe" class="form-control" placeholder="Ví dụ: Cách khắc phục sụt áp motor khi xe khởi động" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div class="form-group">
              <label class="form-label" for="postCategory">Chuyên mục thảo luận *</label>
              <select id="postCategory" name="loaiNoiDung" class="form-control">
                <option value="Thảo luận">Thảo luận kỹ thuật</option>
                <option value="Chia sẻ lỗi">Chia sẻ &amp; Khắc phục lỗi</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="postProject">Liên kết Dự án (Tùy chọn)</label>
              <select id="postProject" name="maDuAn" class="form-control">
                <option value="">-- Không gắn dự án --</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="postContent">Nội dung chi tiết bài viết *</label>
            <textarea id="postContent" name="noiDung" class="form-control" rows="5" placeholder="Mô tả hiện tượng, mã lỗi, giải pháp hoặc kinh nghiệm thực chiến..." required></textarea>
          </div>

          <div id="postAlert" style="display:none; padding: 12px; border-radius: var(--radius-input); font-size: 0.88rem; margin-bottom: 16px;"></div>

          <div style="text-align: right;">
            <button type="button" class="btn btn-secondary" onclick="closeNewPostModal()" style="margin-right: 8px;">Hủy bỏ</button>
            <button type="submit" id="btnSubmitPost" class="btn-playful btn-playful-primary magnet-btn" style="padding: 10px 24px;">Đăng bài viết</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    let allCommunityPosts = [];
    let currentFilter = 'all';

    // 1. Tải Bảng Vinh Danh (Wall of Fame)
    async function loadWallOfFame() {
      try {
        const res = await fetch('/api/community/wall-of-fame');
        const data = await res.json();
        if (!data.success) return;

        const grid = document.getElementById('fameGrid');
        grid.innerHTML = '';

        if (!data.wallOfFame || data.wallOfFame.length === 0) {
          grid.innerHTML = '<p class="text-muted" style="grid-column: 1/-1; padding: 20px 0;">Chưa có dự án nào được ghi nhận trên Bảng vinh danh.</p>';
          return;
        }

        data.wallOfFame.forEach((f, idx) => {
          const card = document.createElement('div');
          card.className = 'bento-card';
          card.style.cssText = 'border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary); display: flex; flex-direction: column; justify-content: space-between;';

          const embedUrl = f.EmbedUrl || 'https://www.youtube-nocookie.com/embed/fJWR73zp1Pc';

          // Video responsive container
          const videoHtml = `
            <div style="background: #000; border-radius: 16px; overflow: hidden; margin-bottom: 16px; position: relative; aspect-ratio: 16/9; border: 1.5px solid rgba(11,15,25,0.15);">
              <iframe width="100%" height="100%" src="${embedUrl}" title="Video vận hành ${f.TenHocSinh}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border:none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
            </div>
          `;

          // Màu huy hiệu xếp hạng
          const rankColors = ['var(--c-accent)', '#94A3B8', '#D97706', 'var(--c-primary)', '#047857'];
          const rankColor = rankColors[idx] || 'var(--c-primary)';

          card.innerHTML = `
            <div>
              ${videoHtml}
              <!-- Header thông tin học sinh & Điểm -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                  <div class="r-badge" style="width: 32px; height: 32px;">
                    <svg viewBox="0 0 32 32" fill="${rankColor}">
                      <path d="M16 0 L32 8 L32 24 L16 32 L0 24 L0 8 Z"/>
                    </svg>
                    <span style="color: ${idx === 0 ? '#0B0F19' : '#FFF'}; font-weight: 800;">${idx + 1}</span>
                  </div>
                  <div>
                    <div style="font-weight: 800; font-size: 1.05rem; color: var(--c-text-main);">${f.TenHocSinh}</div>
                    <div style="font-size: 0.78rem; color: var(--c-text-dim);">
                      <strong>Lớp ${f.Lop || '10/1'}</strong> · ${f.TruongHoc || 'THPT Chuyên STEM'}
                    </div>
                  </div>
                </div>
                <div style="text-align: right;">
                  <div style="font-family: var(--f-heading); font-size: 1.35rem; font-weight: 800; color: var(--c-primary); line-height: 1;">
                    ${f.TongDiem} <span style="font-size: 0.85rem; font-weight: 700; color: var(--c-text-dim);">/ 10đ</span>
                  </div>
                  <span class="badge badge-success" style="font-size: 0.72rem; padding: 2px 8px; margin-top: 4px;">
                    Đạt chuẩn 100%
                  </span>
                </div>
              </div>

              <!-- Cấp độ danh hiệu & Thanh tiến trình hoàn thành -->
              <div style="background: rgba(90, 82, 255, 0.05); border: 1px dashed rgba(90, 82, 255, 0.2); border-radius: 12px; padding: 10px 14px; margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <span style="font-size: 0.78rem; font-weight: 800; color: var(--c-primary); text-transform: uppercase; display: flex; align-items: center; gap: 4px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--c-primary)"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    ${f.DanhHieu || 'Bậc Thầy Robotics'}
                  </span>
                  <span style="font-size: 0.78rem; font-weight: 700; color: #047857;">
                    ${f.TienTrinhPhanTram || 100}% (${f.SoDuAnDat || '5/5 Dự án'})
                  </span>
                </div>
                <div style="background: #E2E8F0; height: 6px; border-radius: 4px; overflow: hidden;">
                  <div style="background: #047857; width: ${f.TienTrinhPhanTram || 100}%; height: 100%;"></div>
                </div>
              </div>

              <!-- Tên công trình & Giới thiệu -->
              <h4 style="font-size: 0.98rem; font-weight: 800; color: var(--c-text-main); margin-bottom: 6px; line-height: 1.35;">
                ${f.TenDuAn}
              </h4>
              <p style="font-size: 0.85rem; color: var(--c-text-dim); line-height: 1.5; margin-bottom: 12px;">
                ${f.LoiGioiThieu || 'Dự án chế tạo và lập trình robot điều khiển tự động hoàn thành xuất sắc tất cả kịch bản kiểm thử.'}
              </p>
            </div>

            ${f.NhanXet ? `
              <div style="padding: 10px 12px; background: #F8FAFC; border: 1px solid rgba(11,15,25,0.06); border-radius: 10px; font-size: 0.8rem; color: var(--c-text-main); margin-top: auto;">
                <strong style="color: var(--c-primary);">TS. Đặng Hùng Vĩ nhận xét:</strong> "${f.NhanXet}"
              </div>
            ` : ''}
          `;
          grid.appendChild(card);
        });
      } catch (err) {
        console.error('Lỗi loadWallOfFame:', err);
      }
    }

    // 2. Tải danh sách bài viết & Top Trending (DF-03)
    async function loadCommunityPosts() {
      try {
        const res = await fetch('/api/community/posts');
        const data = await res.json();
        if (!data.success) return;

        allCommunityPosts = data.posts;
        renderPosts();
      } catch (err) {
        console.error('Lỗi loadCommunityPosts:', err);
      }
    }

    function renderPosts() {
      const container = document.getElementById('postsContainer');
      container.innerHTML = '';

      let filtered = allCommunityPosts;
      if (currentFilter === 'trending') {
        filtered = allCommunityPosts.filter(p => p.isTopTrending);
      } else if (currentFilter !== 'all') {
        filtered = allCommunityPosts.filter(p => p.LoaiNoiDung === currentFilter);
      }

      if (filtered.length === 0) {
        container.innerHTML = '<p class="text-muted" style="text-align:center; padding: 24px;">Không có bài viết nào trong chuyên mục này.</p>';
        return;
      }

      filtered.forEach(p => {
        const card = document.createElement('div');
        card.style.cssText = `
          background: #FFFFFF;
          border-radius: var(--radius-card);
          padding: 24px;
          margin-bottom: 16px;
          border: 1.5px solid ${p.isTopTrending ? 'var(--c-primary)' : 'rgba(11, 15, 25, 0.08)'};
          box-shadow: ${p.isTopTrending ? '4px 4px 0 var(--c-primary)' : 'var(--shadow-soft)'};
          transition: all 0.3s ease;
        `;

        let trendingBadge = p.isTopTrending
          ? '<span class="badge badge-warning" style="margin-left:8px; font-weight:700;">Top Nổi Bật</span>'
          : '';

        let badgeTypeClass = 'badge-primary';
        if (p.LoaiNoiDung === 'Chia sẻ lỗi') badgeTypeClass = 'badge-danger';
        if (p.LoaiNoiDung === 'Vinh danh') badgeTypeClass = 'badge-success';

        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 12px; flex-wrap:wrap; gap:10px;">
            <div>
              <span class="badge ${badgeTypeClass}">${p.LoaiNoiDung}</span>
              ${trendingBadge}
              ${p.TenDuAn ? `<span class="badge badge-locked" style="margin-left:6px;">Dự án: ${p.TenDuAn}</span>` : ''}
              <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--c-text-main); margin-top: 8px;">
                ${p.TieuDe}
              </h3>
            </div>
            <div>
              <button class="btn btn-secondary btn-sm" onclick="votePost(${p.MaNoiDung}, this)" style="display:inline-flex; align-items:center; gap:6px; font-weight:700;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
                <span>${p.SoLuotBinhChon || 0}</span> Bình chọn
              </button>
            </div>
          </div>
          <p style="font-size: 0.92rem; color: var(--c-text-dim); line-height: 1.6; margin-bottom: 16px; white-space: pre-wrap;">${p.NoiDung}</p>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size: 0.8rem; color: var(--c-text-dim); border-top: 1px solid rgba(11, 15, 25, 0.05); padding-top: 12px;">
            <div>Tác giả: <strong>${p.TenTacGia}</strong> (${p.VaiTroTacGia})</div>
            <div>${new Date(p.NgayDang).toLocaleDateString('vi-VN')}</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function filterPosts(filter, el) {
      currentFilter = filter;
      document.querySelectorAll('#forumSection .btn-secondary').forEach(b => b.classList.remove('btn-primary'));
      if (el) {
        el.classList.add('btn-primary');
      }
      renderPosts();
    }

    async function votePost(postId, btn) {
      try {
        btn.disabled = true;
        const res = await fetch(`/api/community/posts/${postId}/vote`, { method: 'POST' });
        const result = await res.json();
        if (result.success) {
          const span = btn.querySelector('span');
          if (span) span.textContent = result.votes;
          btn.style.background = 'var(--c-primary)';
          btn.style.color = '#FFF';
        }
      } catch (err) {
        console.error('Lỗi vote:', err);
      } finally {
        btn.disabled = false;
      }
    }

    function openNewPostModal() {
      document.getElementById('postModal').style.display = 'flex';
      setTimeout(() => { document.getElementById('postModal').classList.add('active'); }, 10);
      loadProjectsDropdown();
    }
    function closeNewPostModal() {
      document.getElementById('postModal').classList.remove('active');
      setTimeout(() => { document.getElementById('postModal').style.display = 'none'; }, 200);
    }

    async function loadProjectsDropdown() {
      try {
        const res = await fetch('/api/projects');
        const data = await res.json();
        if (data.success) {
          const sel = document.getElementById('postProject');
          sel.innerHTML = '<option value="">-- Không gắn dự án --</option>';
          data.projects.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.MaDuAn;
            opt.textContent = p.TenDuAn;
            sel.appendChild(opt);
          });
        }
      } catch (e) {
        console.error('Lỗi load projects:', e);
      }
    }

    document.getElementById('newPostForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const alertBox = document.getElementById('postAlert');
      const btn = document.getElementById('btnSubmitPost');
      btn.disabled = true;

      const payload = {
        tieuDe: document.getElementById('postTitle').value.trim(),
        loaiNoiDung: document.getElementById('postCategory').value,
        maDuAn: document.getElementById('postProject').value || null,
        noiDung: document.getElementById('postContent').value.trim()
      };

      try {
        const res = await fetch('/api/community/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        if (result.success) {
          alertBox.style.display = 'block';
          alertBox.style.background = 'var(--c-success-bg)';
          alertBox.style.color = '#047857';
          alertBox.textContent = result.message;

          setTimeout(() => {
            closeNewPostModal();
            loadCommunityPosts();
          }, 800);
        } else {
          alertBox.style.display = 'block';
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.textContent = result.message;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = err.message;
      } finally {
        btn.disabled = false;
      }
    });

    loadWallOfFame();
    loadCommunityPosts();
  </script>
  <script src="/js/theme-engine.js"></script>
</body>
</html>
