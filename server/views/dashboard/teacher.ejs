    // Mở Modal Chỉnh sửa Học liệu (QTHL.02)
    async function openEditMaterialModal(id) {
      try {
        const res = await fetch(`/api/materials/${id}`);
        const data = await res.json();
        if (!data.success) {
          alert('Không tìm thấy học liệu: ' + data.message);
          return;
        }

        const m = data.material;
        document.getElementById('editMatId').value = m.MaHocLieu;
        document.getElementById('editMatTenHocLieu').value = m.TenHocLieu || '';
        document.getElementById('editMatLoaiHocLieu').value = m.LoaiHocLieu || 'Bài giảng';
        document.getElementById('editMatMaLoTrinh').value = m.MaLoTrinh || '';
        document.getElementById('editMatTrangThai').value = m.TrangThai || 'Xuất bản';
        document.getElementById('editMatDuongDanTep').value = m.DuongDanTep || '';
        document.getElementById('editMatNoiDung').value = m.NoiDung || '';

        const alertBox = document.getElementById('editMaterialAlert');
        alertBox.style.display = 'none';

        const modal = document.getElementById('editMaterialModal');
        modal.style.display = 'flex';
        setTimeout(() => { modal.classList.add('active'); }, 10);
      } catch (err) {
        alert('Lỗi khi tải chi tiết học liệu: ' + err.message);
      }
    }

    function closeEditMaterialModal() {
      const modal = document.getElementById('editMaterialModal');
      modal.classList.remove('active');
      setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

