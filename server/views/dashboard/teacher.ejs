    // Ẩn / Hiện học liệu (QTHL.02)
    async function toggleMaterialStatus(id, force = false) {
      try {
        const res = await fetch(`/api/materials/${id}/toggle-status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ force })
        });
        const result = await res.json();

        if (result.requireConfirmation) {
          // Lộ trình có bài thi/dự án đang mở -> Hiển thị Modal xác nhận cảnh báo
          pendingHideMaterialId = id;
          document.getElementById('confirmHideMessage').innerHTML = `
            <strong>Cảnh báo học vụ quan trọng:</strong> Lộ trình của học liệu này hiện đang có 
            <strong style="color:#DC2626;">${result.activeProjectsCount} dự án đang mở</strong> cho học sinh làm bài.<br><br>
            Việc ẩn tài liệu hướng dẫn/linh kiện này có thể khiến học sinh gặp khó khăn hoặc thiếu thông tin khi nộp bài thực hành.<br><br>
            Bạn có chắc chắn muốn tiếp tục <strong>Ẩn học liệu</strong> này không?
          `;
          const modal = document.getElementById('confirmHideModal');
          modal.style.display = 'flex';
          setTimeout(() => { modal.classList.add('active'); }, 10);
          return;
        }

        if (result.success) {
          loadMaterials();
        } else {
          alert('Không thể đổi trạng thái học liệu: ' + result.message);
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    function closeConfirmHideModal() {
      pendingHideMaterialId = null;
      const modal = document.getElementById('confirmHideModal');
      modal.classList.remove('active');
      setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

    document.getElementById('btnForceHideMaterial').addEventListener('click', async () => {
      if (pendingHideMaterialId) {
        const id = pendingHideMaterialId;
        closeConfirmHideModal();
        await toggleMaterialStatus(id, true);
      }
    });

    // 8. Kiểm tra Luồng tự động DF-05 (Cảnh báo cập nhật học liệu)
    async function checkDF05QualityAlert() {
      try {
        const res = await fetch('/api/exam/analytics/df05-check');
        const data = await res.json();

        if (data.success && data.hasWarning) {
          const alertBox = document.getElementById('df05Alert');
          const summary = document.getElementById('df05AlertSummary');
          const list = document.getElementById('df05FlaggedList');

          if (alertBox) alertBox.style.display = 'block';
          if (summary) {
            summary.textContent = `Hệ thống phân tích chất lượng phát hiện có ${data.allFlaggedMaterials ? data.allFlaggedMaterials.length : 0} học liệu cần cập nhật nội dung để hỗ trợ học sinh thực hành tốt hơn.`;
          }

          if (list && data.allFlaggedMaterials && data.allFlaggedMaterials.length > 0) {
            let html = '<div style="font-weight:700; margin-bottom:8px; color:#991B1B;">Danh sách học liệu đã tự động gắn cờ CoCanCapNhat = 1:</div><ul style="padding-left: 20px;">';
            data.allFlaggedMaterials.forEach(m => {
              html += `<li style="margin-bottom:4px;"><strong>[Mã HL #${m.MaHocLieu}] ${m.TenHocLieu || m.TieuDe}</strong> (Loại: ${m.LoaiHocLieu}) · Lộ trình: <em>${m.TenLoTrinh || 'Toàn hệ thống'}</em></li>`;
            });
            html += '</ul>';
            list.innerHTML = html;
          }
        }
      } catch (e) {
        console.error('Lỗi kiểm tra DF-05:', e);
      }
    }

    // ==============================================================================
    // 9. BÁO CÁO SỰ CỐ (HTTB.01) & THÔNG BÁO HỆ THỐNG (HTTB.02)
    // ==============================================================================
    function openTeacherIssueModal() {
      const modal = document.getElementById('teacherReportIssueModal');
      modal.style.display = 'flex';
      setTimeout(() => { modal.classList.add('active'); }, 10);
    }

    function closeTeacherIssueModal() {
      const modal = document.getElementById('teacherReportIssueModal');
      modal.classList.remove('active');
      setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

    document.getElementById('teacherReportIssueForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitTeacherIssue');
      const alertBox = document.getElementById('teacherReportAlert');

      btn.disabled = true;
      btn.textContent = 'Đang gửi sự cố...';
      alertBox.style.display = 'none';

      const payload = {
        tieuDe: document.getElementById('teacherIssueTitle').value.trim(),
        mucDoUuTien: document.getElementById('teacherIssuePriority').value,
        noiDung: document.getElementById('teacherIssueContent').value.trim()
      };

      try {
        const res = await fetch('/api/support/report-issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        alertBox.style.display = 'block';
        if (result.success) {
          alertBox.style.background = 'var(--c-success-bg)';
          alertBox.style.color = '#047857';
          alertBox.style.border = '1.5px solid rgba(16, 185, 129, 0.3)';
          alertBox.innerHTML = `<strong>Thành công:</strong> ${result.message}`;
          document.getElementById('teacherReportIssueForm').reset();
          setTimeout(() => {
            closeTeacherIssueModal();
          }, 2000);
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1.5px solid rgba(239, 68, 68, 0.3)';
          alertBox.innerHTML = `<strong>Lỗi:</strong> ${result.message}`;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Gửi Báo Cáo Sự Cố';
      }
    });

    async function loadSystemBroadcasts() {
      const container = document.getElementById('systemBroadcastContainer');
      if (!container) return;

      try {
        const res = await fetch('/api/support/active-notifications');
        const data = await res.json();

        if (!data.success || !data.notifications || data.notifications.length === 0) {
          container.innerHTML = '';
          return;
        }

        let html = '';
        data.notifications.forEach(n => {
          const isUrgent = (n.MucDoUuTien === 'Khẩn cấp');

          if (isUrgent) {
            html += `
              <div class="bento-card" style="background: #FFF5F5; border: 2px solid var(--c-secondary); box-shadow: 4px 4px 0 var(--c-secondary); padding: 18px 24px; position: relative; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                  <div style="display: flex; gap: 14px; align-items: flex-start;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #FEE2E2; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #DC2626;">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                    <div>
                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                        <span class="badge badge-danger" style="animation: pulse-core 2s infinite;">THÔNG BÁO KHẨN CẤP</span>
                        <span style="font-size: 0.78rem; color: #991B1B; font-weight: 600;">Phát lúc: ${n.NgayTaoFmt || n.NgayTao} · Bởi: ${n.NguoiGui || 'Ban Quản Trị'}</span>
                      </div>
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #991B1B; margin-bottom: 6px;">${n.TieuDe}</h3>
                      <p style="font-size: 0.92rem; color: #7F1D1D; line-height: 1.55; margin-bottom: 0;">${n.NoiDung}</p>
                    </div>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="this.closest('.bento-card').remove()" style="color: #991B1B; border-color: rgba(220, 38, 38, 0.3);">Đã hiểu &times;</button>
                </div>
              </div>
            `;
          } else {
            html += `
              <div class="bento-card" style="background: #F0FDF4; border: 1.5px solid rgba(16, 185, 129, 0.4); box-shadow: 3px 3px 0 rgba(16, 185, 129, 0.3); padding: 16px 20px; position: relative; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                  <div style="display: flex; gap: 12px; align-items: flex-start;">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #DCFCE7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #047857;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </div>
                    <div>
                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                        <span class="badge badge-success">THÔNG BÁO HỆ THỐNG</span>
                        <span style="font-size: 0.78rem; color: #065F46;">${n.NgayTaoFmt || n.NgayTao}</span>
                      </div>
                      <h4 style="font-size: 1.05rem; font-weight: 800; color: #065F46; margin-bottom: 4px;">${n.TieuDe}</h4>
                      <p style="font-size: 0.88rem; color: #064E3B; line-height: 1.5; margin-bottom: 0;">${n.NoiDung}</p>
                    </div>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="this.closest('.bento-card').remove()" style="color: #065F46; border-color: rgba(16, 185, 129, 0.3);">Đóng</button>
                </div>
              </div>
            `;
          }
        });

        container.innerHTML = html;
      } catch (e) {
        console.error('Lỗi loadSystemBroadcasts:', e);
      }
    }

    // =========================================================================
    // QUẢN LÝ LỚP HỌC 10/1 & DUYỆT THẺ HỌC SINH (GIÁO VIÊN CHỦ NHIỆM)
    // =========================================================================
    async function loadClassRoster() {
      try {
        const res = await fetch('/api/teacher/class-roster');
        const data = await res.json();
        if (!data.success) {
          console.error('Không thể tải danh sách lớp:', data.message);
          return;
        }

        const students = data.students || [];
        const activeStudents = students.filter(s => s.TrangThai === 'Đang hoạt động');
        const pendingStudents = students.filter(s => s.TrangThai === 'Chờ duyệt' || (s.TrangThaiXacThucThe && s.TrangThaiXacThucThe.includes('Chờ duyệt')));

        // 1. Cập nhật thẻ chỉ số
        const countEl = document.getElementById('classStudentCount');
        if (countEl) countEl.textContent = `${activeStudents.length} học sinh`;

        const avgProgressEl = document.getElementById('classAvgProgress');
        if (avgProgressEl) {
          const avgProg = activeStudents.length > 0
            ? Math.round(activeStudents.reduce((acc, s) => acc + (s.TienTrinhPhanTram || 0), 0) / activeStudents.length)
            : 0;
          avgProgressEl.textContent = `${avgProg}%`;
        }

        const avgScoreEl = document.getElementById('classAvgScore');
        if (avgScoreEl) {
          const avgScore = activeStudents.length > 0
            ? (activeStudents.reduce((acc, s) => acc + (s.DiemTrungBinh || 0), 0) / activeStudents.length).toFixed(1)
            : '0.0';
          avgScoreEl.textContent = `${avgScore} / 10đ`;
        }

        const cardVerifiedEl = document.getElementById('classCardVerifiedCount');
        if (cardVerifiedEl) {
          const verifiedCount = activeStudents.filter(s => s.TrangThaiXacThucThe && s.TrangThaiXacThucThe.includes('Đã xác thực')).length;
          cardVerifiedEl.textContent = `${verifiedCount} / ${activeStudents.length} thẻ`;
        }

        // 2. Hàng đợi chờ duyệt thẻ (nếu có học sinh đăng ký vào lớp 10/1)
        const pendingSec = document.getElementById('classPendingApprovalSection');
        const pendingBadge = document.getElementById('classPendingCountBadge');
        const pendingList = document.getElementById('classPendingStudentsList');

        if (pendingStudents.length > 0) {
          pendingSec.style.display = 'block';
          pendingBadge.textContent = `${pendingStudents.length} yêu cầu`;
          pendingList.innerHTML = '';

          pendingStudents.forEach(ps => {
            const card = document.createElement('div');
            card.style.cssText = 'background:#FFF; border-radius:16px; padding:16px; border:1.5px solid #FCA5A5; display:flex; flex-direction:column; justify-content:space-between; gap:12px;';
            card.innerHTML = `
              <div style="display:flex; gap:12px; align-items:center;">
                <div style="width:48px; height:48px; border-radius:50%; background:rgba(90,82,255,0.1); color:var(--c-primary); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1.1rem; flex-shrink:0;">
                  ${ps.HoTen ? ps.HoTen.charAt(0) : 'H'}
                </div>
                <div>
                  <h4 style="font-size:1rem; font-weight:800; color:var(--c-text-main); margin-bottom:2px;">${ps.HoTen}</h4>
                  <div style="font-size:0.8rem; color:var(--c-text-dim);">${ps.Email}</div>
                  <div style="font-size:0.75rem; color:#DC2626; font-weight:600; margin-top:2px;">
                    ${ps.TrangThaiXacThucThe || 'Chờ duyệt thẻ'}
                  </div>
                </div>
              </div>
              ${ps.AnhTheHocSinh ? `
                <div style="border-radius:8px; overflow:hidden; border:1px solid #E2E8F0; max-height:100px; display:flex; align-items:center; justify-content:center; background:#F8FAFC;">
                  <img src="${ps.AnhTheHocSinh}" alt="Thẻ học sinh" style="max-height:100px; width:auto; object-fit:contain;">
                </div>
              ` : ''}
              <button class="btn btn-primary btn-sm" onclick="approveStudentFromTeacher(${ps.MaNguoiDung})" style="width:100%; justify-content:center;">
                Duyệt Vào Lớp 10/1
              </button>
            `;
            pendingList.appendChild(card);
          });
        } else {
          pendingSec.style.display = 'none';
        }

        // 3. Render danh sách học sinh chính thức
        const tbody = document.getElementById('classStudentsTableBody');
        tbody.innerHTML = '';

        if (activeStudents.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-muted" style="text-align:center; padding:24px;">Chưa có học sinh nào trong lớp.</td></tr>';
          return;
        }

        activeStudents.forEach((s) => {
          const tr = document.createElement('tr');
          const isCardVerified = s.TrangThaiXacThucThe && s.TrangThaiXacThucThe.includes('Đã xác thực');

          tr.innerHTML = `
            <td><strong>#${s.MaNguoiDung}</strong></td>
            <td>
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:36px; height:36px; border-radius:50%; background:rgba(90,82,255,0.12); color:var(--c-primary); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:0.95rem; flex-shrink:0;">
                  ${s.HoTen.charAt(0)}
                </div>
                <div>
                  <strong style="color:var(--c-text-main); font-size:0.95rem;">${s.HoTen}</strong>
                  <br><small class="text-muted">${s.Email}</small>
                </div>
              </div>
            </td>
            <td>
              <span class="badge badge-primary" style="font-weight:700; font-size:0.75rem;">
                ${s.DanhHieu || 'Bậc Thầy Robotics'}
              </span>
            </td>
            <td>
              <div style="min-width:140px;">
                <div style="display:flex; justify-content:space-between; font-size:0.8rem; font-weight:700; margin-bottom:4px;">
                  <span style="color:var(--c-primary);">${s.TienTrinhPhanTram || 100}%</span>
                  <span style="color:var(--c-text-dim);">${s.SoDuAnDat || 5}/5 dự án</span>
                </div>
                <div style="background:#E2E8F0; height:6px; border-radius:3px; overflow:hidden;">
                  <div style="background:var(--c-primary); width:${s.TienTrinhPhanTram || 100}%; height:100%;"></div>
                </div>
              </div>
            </td>
            <td>
              <strong style="font-size:1.05rem; color:var(--c-text-main);">${s.DiemTrungBinh ? s.DiemTrungBinh.toFixed(1) : '10.0'}</strong>
              <small class="text-muted">/ 10</small>
            </td>
            <td>
              ${isCardVerified
                ? '<span class="badge badge-success" style="display:inline-flex; align-items:center; gap:4px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Đã xác thực thẻ</span>'
                : '<span class="badge badge-warning">Chờ duyệt thẻ</span>'}
            </td>
            <td style="text-align:right;">
              <a href="/profile" class="btn btn-secondary btn-sm" title="Xem hồ sơ">
                Hồ sơ ↗
              </a>
            </td>
          `;
          tbody.appendChild(tr);
        });

      } catch (err) {
        console.error('Lỗi loadClassRoster:', err);
      }
    }

    async function approveStudentFromTeacher(userId) {
      if (!confirm(`Xác nhận phê duyệt thẻ học sinh và chấp thuận vào lớp 10/1 cho học sinh #${userId}?`)) return;
      try {
        const res = await fetch(`/api/teacher/approve-student/${userId}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert(data.message || 'Đã duyệt học sinh vào lớp 10/1 thành công!');
          loadClassRoster();
        } else {
          alert('Lỗi: ' + data.message);
        }
      } catch (err) {
        alert('Lỗi kết nối: ' + err.message);
      }
    }

    // Khởi chạy khi load trang
    syncTeacherViewFromHash();
    loadSubmissions();
    loadClassRoster();
    loadFormDropdowns();
    loadMaterials();
    checkDF05QualityAlert();
    loadSystemBroadcasts();
  </script>
  <script src="/js/theme-engine.js"></script>
</body>
</html>
