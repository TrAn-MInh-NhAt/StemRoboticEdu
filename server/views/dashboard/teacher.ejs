<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Không gian Giáo viên — STEM Robotic</title>
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <!-- Nền Blobs lơ lửng -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="app-shell">
    <!-- Sidebar Studio Kỹ Thuật (Neo-Brutalist Slate) -->
    <aside class="sidebar">
      <div class="sidebar-brand">
        <div class="brand-symbol">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="#FFF" fill="none" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <div class="brand-title">STEM Robotic</div>
          <div class="brand-tag">Cổng thông tin Giảng viên</div>
        </div>
      </div>

      <!-- Thẻ người dùng -->
      <div class="sidebar-user-card">
        <div class="user-avatar-circle" style="background: var(--c-accent); color: var(--c-text-main);">
          <%= user.HoTen.charAt(user.HoTen.lastIndexOf(' ') + 1) || 'G' %>
        </div>
        <div class="user-meta">
          <div class="user-name"><%= user.HoTen %></div>
          <div class="user-role-label">Giáo viên · Mã #<%= user.MaNguoiDung %></div>
        </div>
      </div>

      <!-- Menu Điều Hướng -->
      <ul class="sidebar-nav">
        <li class="sidebar-nav-item">
          <a href="#pendingSection" class="sidebar-nav-link active">
            <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <span>Duyệt Video (DF-01)</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="#createProjectSection" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span>Giao dự án &amp; TestCase</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="#allSubsCard" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Tất cả bài nộp</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/community" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
            <span>Cộng đồng &amp; Vinh danh</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/api/reports/grades-csv" target="_blank" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Xuất bảng điểm (.CSV)</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="/exam" class="sidebar-nav-link" style="color: var(--c-secondary);">
            <svg viewBox="0 0 24 24" style="stroke: var(--c-secondary);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Giám sát kỳ thi</span>
          </a>
        </li>
        <li class="sidebar-nav-item" style="margin-top: 20px;">
          <a href="/" class="sidebar-nav-link" style="color: var(--c-accent);">
            <svg viewBox="0 0 24 24" style="stroke: var(--c-accent);"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
            <span>Về Trang Chủ (/)</span>
          </a>
        </li>
      </ul>

      <div class="sidebar-footer">
        <a href="/logout" class="btn-sidebar-logout">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Đăng xuất tài khoản</span>
        </a>
      </div>
    </aside>

    <!-- Main content -->
    <main class="main-content">
      <!-- Breadcrumb -->
      <div style="font-size: 0.85rem; color: var(--c-text-dim); margin-bottom: 24px; font-weight: 600;">
        <span>Bàn làm việc Giảng viên</span>
        <span style="margin: 0 8px;">/</span>
        <span style="color: var(--c-primary);">Quản trị Giảng dạy, Giao Dự Án &amp; Chốt Điểm</span>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 16px;">
        <div>
          <h1 style="font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em;">
            Quản Trị Giảng Dạy &amp; <span class="title-highlight">Chốt Điểm</span>
          </h1>
          <p style="font-size: 0.95rem; color: var(--c-text-dim); margin-top: 4px;">
            Giáo viên: <strong><%= user.HoTen %></strong> (<%= user.Email %>) · Mã GV: #<%= user.MaNguoiDung %>
          </p>
        </div>
        <div style="display:flex; gap: 12px;">
          <a href="/api/reports/grades-csv" class="btn btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Xuất bảng điểm (.CSV)
          </a>
        </div>
      </div>

      <!-- Banner cảnh báo đỏ DF-05 (Thẻ Bento nổi bật) -->
      <div id="df05Alert" class="bento-card" style="display:none; border: 2px solid var(--c-secondary); box-shadow: 4px 4px 0 var(--c-secondary); margin-bottom: 32px; background: #FFF5F5;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap: wrap; gap: 16px;">
          <div>
            <span class="tech-chip" style="background: #FEE2E2; color: #991B1B; font-weight: 700; margin-bottom: 8px; display: inline-block;">
              Luồng Tự Động DF-05 · Cảnh Báo Chất Lượng Giảng Dạy
            </span>
            <h2 style="font-size: 1.35rem; font-weight: 800; color: #991B1B; margin-top: 4px;">
              Phát hiện bài tập có tỷ lệ học sinh mắc lỗi vượt ngưỡng 30%
            </h2>
            <p style="margin-top: 6px; font-size: 0.9rem; color: #7F1D1D;" id="df05AlertSummary">
              Hệ thống phân tích log lỗi (TKDL.02) phát hiện tỷ lệ bài nộp bị lỗi cao. Cột CoCanCapNhat ở các học liệu liên quan đã được hệ thống tự động kích hoạt để nhắc Giáo viên bổ sung hướng dẫn.
            </p>
          </div>
          <span class="badge badge-danger">Gắn cờ DF-05</span>
        </div>
        <div id="df05FlaggedList" style="margin-top: 16px; font-size: 0.88rem; padding-top: 14px; border-top: 1px dashed rgba(239, 68, 68, 0.3);"></div>
      </div>

      <!-- Banner thông báo DF-02 -->
      <div id="df02Alert" class="alert alert-success" style="display:none; margin-bottom: 24px; padding: 16px 20px; border-radius: var(--radius-card); background: var(--c-success-bg); border: 1.5px solid rgba(16, 185, 129, 0.3);">
        <strong style="font-size: 1rem; color: #047857;">Thông báo Luồng tự động DF-02:</strong>
        <p id="df02AlertText" style="margin-top: 4px; font-size: 0.9rem; color: #065F46;"></p>
      </div>

      <!-- 1. Danh sách bài nộp đang ở trạng thái N'Chờ duyệt Video' (DF-01) -->
      <section id="pendingSection" class="card" style="border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary); margin-bottom: 36px;">
        <div class="card-header">
          <div>
            <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: #3730A3; font-weight: 700; margin-bottom: 8px; display: inline-block;">Trigger Nghiệp Vụ DF-01</span>
            <h2 class="card-title" style="font-size: 1.35rem;">Bài nộp Đang ở Trạng thái N'Chờ duyệt Video'</h2>
            <p class="card-subtitle">
              Các bài nộp đã chạy đạt 100% TestCase tự động qua Máy chấm (XLBN.02/DF-01), sẵn sàng cho Giáo viên kiểm duyệt phần cứng robot.
            </p>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="loadSubmissions()">Làm mới</button>
        </div>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Mã bài</th>
                <th>Học sinh</th>
                <th>Dự án</th>
                <th>Điểm Code</th>
                <th>Minh chứng Video</th>
                <th>Thời điểm nộp</th>
                <th>Thao tác thẩm định</th>
              </tr>
            </thead>
            <tbody id="pendingSubmissionsBody">
              <tr>
                <td colspan="7" class="text-muted" style="text-align:center; padding: 24px;">Đang tải bài nộp chờ duyệt...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 2. Khung Xem Video Vận Hành & Chốt điểm (KQBN.01, KQBN.02) -->
      <section class="card" id="gradingCard" style="display: none; border: 2px solid var(--c-primary); box-shadow: 6px 6px 0 var(--c-text-main); margin-bottom: 36px;">
        <div class="card-header" style="background: rgba(90, 82, 255, 0.06); margin: -28px -28px 24px; padding: 18px 28px; border-bottom: 1.5px solid rgba(11, 15, 25, 0.08);">
          <h2 class="card-title" style="color: var(--c-primary);" id="gradingTitle">
            Kiểm duyệt Video Vận hành &amp; Chốt điểm: Bài nộp #...
          </h2>
          <button class="btn btn-secondary btn-sm" onclick="closeGradingCard()">Đóng</button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 28px;">
          <!-- Cột trái: Khung xem Video và minh chứng -->
          <div>
            <label class="form-label">Khung Video Vận hành Robot Thực tế (KQBN.01):</label>
            <div id="videoContainer" style="background: #0B0F19; border-radius: 16px; overflow: hidden; min-height: 240px; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; border: 1.5px solid rgba(11, 15, 25, 0.1); padding: 16px;">
              <span id="videoPlaceholder" style="color: #94A3B8;">Đang tải video...</span>
            </div>
            
            <div style="padding: 12px 0; border-top: 1px dashed rgba(11, 15, 25, 0.12); font-size: 0.88rem; line-height: 1.7;">
              <p style="margin-bottom: 6px;">Học sinh: <strong id="gradeStudentName">--</strong></p>
              <p style="margin-bottom: 6px;">Dự án: <strong id="gradeProjectName">--</strong></p>
              <p style="margin-bottom: 6px;">
                Kết quả Máy chấm: <strong style="color:var(--c-primary);" id="gradeCodeScore">10 / 10 (100% TestCase Pass)</strong>
              </p>
              <p style="margin-bottom: 0;">
                Liên kết gốc: <a id="gradeVideoLink" href="#" target="_blank" rel="noopener" style="word-break: break-all;">--</a>
              </p>
            </div>
          </div>

          <!-- Cột phải: Form Chốt điểm & Đánh giá KQBN.02 -->
          <div>
            <form id="gradingForm">
              <input type="hidden" id="gradeMaBaiNop" name="maBaiNop">

              <div class="form-group">
                <label class="form-label">Kiểm duyệt Video vận hành phần cứng (KQBN.01) *</label>
                <div style="display:flex; gap: 24px; margin-top: 8px;">
                  <label style="display:inline-flex; align-items:center; gap: 8px; font-size: 0.95rem; cursor:pointer;">
                    <input type="radio" name="ketQuaVideo" value="Đạt" checked> 
                    <strong style="color: #047857;">Đạt yêu cầu (Pass)</strong>
                  </label>
                  <label style="display:inline-flex; align-items:center; gap: 8px; font-size: 0.95rem; cursor:pointer;">
                    <input type="radio" name="ketQuaVideo" value="Không đạt"> 
                    <strong style="color: #DC2626;">Không đạt (Fail)</strong>
                  </label>
                </div>
                <small style="display:block; margin-top: 6px; font-size: 0.8rem; color: var(--c-text-dim);">
                  Quy tắc DF-02: Khi chọn Đạt và chốt điểm, dự án tiếp theo sẽ được tự động mở khóa cho học sinh.
                </small>
              </div>

              <div class="form-group">
                <label class="form-label" for="tongDiem">Tổng điểm bài tập (thang điểm 10) *</label>
                <input type="number" id="tongDiem" name="tongDiem" class="form-control" step="0.5" min="0" max="10" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="nhanXet">Nhận xét chi tiết của Giáo viên (KQBN.02)</label>
                <textarea id="nhanXet" name="nhanXet" class="form-control" rows="3" placeholder="Nhận xét chất lượng lắp ráp mạch, độ mượt động cơ, xử lý cảm biến..."></textarea>
              </div>

              <button type="submit" id="btnGrade" class="btn-playful btn-playful-primary magnet-btn" style="width: 100%; padding: 14px;">
                Chốt điểm &amp; Lưu minh chứng (Kích hoạt DF-02)
                <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- 3. Form Giao Dự Án Mới + Thêm TestCase (QLDA.01) -->
      <section id="createProjectSection" class="card" style="border: 1.5px solid rgba(11, 15, 25, 0.08); margin-bottom: 36px;">
        <div class="card-header">
          <div>
            <span class="tech-chip" style="background: #FEF3C7; color: #92400E; font-weight: 700; margin-bottom: 8px; display: inline-block;">
              Mô đun QLDA.01 &amp; Ràng Buộc Tiên Quyết
            </span>
            <h2 class="card-title" style="font-size: 1.35rem;">Giao Dự án Thực hành Mới &amp; Thiết lập TestCase</h2>
            <p class="card-subtitle">
              Tạo đề bài dự án STEM, thiết lập điều kiện tiên quyết (DF-02) và đính kèm bộ dữ liệu kiểm thử tự động cho máy chấm.
            </p>
          </div>
          <span class="badge badge-primary">MOD-03 IPO</span>
        </div>

        <form id="createProjectForm">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div>
              <div class="form-group">
                <label class="form-label" for="tenDuAn">Tên Dự án Thực hành *</label>
                <input type="text" id="tenDuAn" name="tenDuAn" class="form-control" placeholder="Ví dụ: Dự án 3: Cánh tay Robot gắp vật thể 3 bậc tự do" required>
              </div>

              <div class="form-group">
                <label class="form-label" for="maLoTrinh">Thuộc Lộ trình học (KhoaHocLoTrinh) *</label>
                <select id="maLoTrinh" name="maLoTrinh" class="form-control" required>
                  <option value="">-- Đang tải lộ trình học --</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="maDuAnTienQuyet">Dự án Tiên quyết (Ràng buộc mở khóa DF-02)</label>
                <select id="maDuAnTienQuyet" name="maDuAnTienQuyet" class="form-control">
                  <option value="">-- Không có (Mở khóa mặc định) --</option>
                </select>
                <small style="font-size: 0.78rem; color: var(--c-text-dim);">Nếu chọn, học sinh bắt buộc phải đạt dự án này mới được làm dự án mới.</small>
              </div>
            </div>

            <div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div class="form-group">
                  <label class="form-label" for="capDo">Cấp độ</label>
                  <select id="capDo" name="capDo" class="form-control">
                    <option value="Cơ bản">Cơ bản</option>
                    <option value="Nâng cao">Nâng cao</option>
                    <option value="Chuyên sâu">Chuyên sâu</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label" for="hanNop">Hạn chót nộp bài (Deadline)</label>
                  <input type="date" id="hanNop" name="hanNop" class="form-control">
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="yeuCauDuAn">Yêu cầu &amp; Hướng dẫn thực hiện dự án *</label>
                <textarea id="yeuCauDuAn" name="yeuCauDuAn" class="form-control" rows="4" placeholder="Mô tả chi tiết nguyên lý hoạt động, sơ đồ nối dây cảm biến, định dạng dữ liệu đầu vào và đầu ra cần xuất qua Serial/Console..." required></textarea>
              </div>
            </div>
          </div>

          <!-- Bộ TestCase (ENT-05) -->
          <div style="margin-top: 24px; padding-top: 20px; border-top: 1.5px dashed rgba(11, 15, 25, 0.12);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 14px;">
              <div>
                <strong style="font-size: 1rem; color: var(--c-text-main);">Bộ Dữ liệu Kiểm thử Tự động (TestCase)</strong>
                <p style="font-size: 0.8rem; color: var(--c-text-dim);">Máy chấm sẽ chạy file code đối chiếu với từng dòng kiểm thử này.</p>
              </div>
              <button type="button" class="btn btn-secondary btn-sm" onclick="addTestCaseRow()">+ Thêm TestCase</button>
            </div>

            <div class="table-responsive">
              <table class="data-table" id="testCaseTable">
                <thead>
                  <tr>
                    <th style="width: 25%;">Dữ liệu Đầu vào (Input)</th>
                    <th style="width: 25%;">Kết quả Chuẩn (Expected Output) *</th>
                    <th style="width: 15%;">Trọng số (Điểm)</th>
                    <th style="width: 30%;">Gợi ý Sửa lỗi (Hint)</th>
                    <th style="width: 5%;">Xóa</th>
                  </tr>
                </thead>
                <tbody id="testCaseBody">
                  <tr>
                    <td><input type="text" class="form-control tc-input" placeholder="Ví dụ: 1"></td>
                    <td><input type="text" class="form-control tc-output" placeholder="Ví dụ: LED_ON" required></td>
                    <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
                    <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý kiểm tra chân Digital"></td>
                    <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
                  </tr>
                  <tr>
                    <td><input type="text" class="form-control tc-input" placeholder="Ví dụ: 0"></td>
                    <td><input type="text" class="form-control tc-output" placeholder="Ví dụ: LED_OFF" required></td>
                    <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
                    <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý kiểm tra lệnh LOW"></td>
                    <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div id="projectCreateAlert" style="display:none; padding: 14px; border-radius: var(--radius-input); font-size: 0.88rem; margin-top: 16px;"></div>

          <div style="margin-top: 24px; text-align: right;">
            <button type="submit" id="btnCreateProject" class="btn-playful btn-playful-primary magnet-btn" style="padding: 12px 28px;">
              Khởi tạo &amp; Giao Dự án Thực hành (QLDA.01)
              <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </form>
      </section>

      <!-- 4. Toàn bộ lịch sử bài nộp -->
      <section class="card" id="allSubsCard">
        <div class="card-header">
          <div>
            <h2 class="card-title">Tất cả Bài nộp của Học sinh</h2>
            <p class="card-subtitle">Theo dõi tiến độ, điểm số và xuất báo cáo kết quả học tập chi tiết.</p>
          </div>
          <div style="display:flex; align-items:center; gap: 12px;">
            <a href="/api/reports/grades-csv" class="btn btn-secondary btn-sm">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Xuất CSV (TKDL.01)
            </a>
            <span class="badge badge-primary" id="totalSubsCount">0 bài</span>
          </div>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Mã</th>
                <th>Học sinh</th>
                <th>Dự án</th>
                <th>Thời điểm nộp</th>
                <th>Điểm Code</th>
                <th>Đánh giá Video</th>
                <th>Tổng điểm</th>
                <th>Trạng thái</th>
                <th>Nhận xét Giáo viên</th>
              </tr>
            </thead>
            <tbody id="allSubmissionsBody">
              <tr>
                <td colspan="9" class="text-muted" style="text-align:center; padding: 24px;">Đang tải danh sách bài nộp...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script>
    let currentSubmissions = [];

    // 1. Tải danh sách bài nộp
    async function loadSubmissions() {
      try {
        const res = await fetch('/api/teacher/submissions');
        const data = await res.json();
        if (!data.success) return;

        currentSubmissions = data.submissions;
        document.getElementById('totalSubsCount').textContent = `${currentSubmissions.length} bài`;

        const pendingBody = document.getElementById('pendingSubmissionsBody');
        const allBody = document.getElementById('allSubmissionsBody');
        pendingBody.innerHTML = '';
        allBody.innerHTML = '';

        const pendingSubs = currentSubmissions.filter(s => s.TrangThai === 'Chờ duyệt Video');

        // Bảng 1: Pending (DF-01)
        if (pendingSubs.length === 0) {
          pendingBody.innerHTML = '<tr><td colspan="7" class="text-muted" style="text-align:center; padding: 20px;">Hiện không có bài nộp nào đang chờ duyệt video.</td></tr>';
        } else {
          pendingSubs.forEach(s => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><strong>#${s.MaBaiNop}</strong></td>
              <td><strong>${s.TenHocSinh}</strong><br><small class="text-muted">${s.Email}</small></td>
              <td><strong>${s.TenDuAn}</strong></td>
              <td><strong style="color:var(--c-primary);">${s.DiemCode}</strong> / 10</td>
              <td><a href="${s.VideoVanHanh}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Xem Video ↗</a></td>
              <td>${new Date(s.ThoiGianNop).toLocaleString('vi-VN')}</td>
              <td>
                <button class="btn btn-primary btn-sm" onclick="openGrading(${s.MaBaiNop})">
                  Duyệt Video &amp; Chốt điểm
                </button>
              </td>
            `;
            pendingBody.appendChild(tr);
          });
        }

        // Bảng 2: Tất cả bài
        if (currentSubmissions.length === 0) {
          allBody.innerHTML = '<tr><td colspan="9" class="text-muted" style="text-align:center; padding: 20px;">Chưa có dữ liệu bài nộp.</td></tr>';
        } else {
          currentSubmissions.forEach(s => {
            const tr = document.createElement('tr');
            let badgeClass = 'badge-locked';
            if (s.TrangThai === 'Chờ duyệt Video') badgeClass = 'badge-warning';
            if (s.TrangThai === 'Đã chốt điểm') badgeClass = 'badge-success';

            tr.innerHTML = `
              <td><strong>#${s.MaBaiNop}</strong></td>
              <td><strong>${s.TenHocSinh}</strong></td>
              <td>${s.TenDuAn}</td>
              <td>${new Date(s.ThoiGianNop).toLocaleDateString('vi-VN')}</td>
              <td>${s.DiemCode !== null ? s.DiemCode : '--'}</td>
              <td>${s.KetQuaVideo || '<span class="text-muted">Chưa duyệt</span>'}</td>
              <td><strong style="font-size:1.05rem; color:${s.TongDiem >= 8 ? '#047857' : (s.TongDiem >= 5 ? '#B45309' : '#DC2626')};">${s.TongDiem !== null ? s.TongDiem : '--'}</strong></td>
              <td><span class="badge ${badgeClass}">${s.TrangThai}</span></td>
              <td style="max-width: 220px; font-size:0.85rem; color:var(--c-text-dim);">${s.NhanXet || '--'}</td>
            `;
            allBody.appendChild(tr);
          });
        }
      } catch (e) {
        console.error('Lỗi loadSubmissions:', e);
      }
    }

    // 2. Khung duyệt & xem video nhúng (KQBN.01, KQBN.02)
    function openGrading(maBaiNop) {
      const sub = currentSubmissions.find(s => s.MaBaiNop === maBaiNop);
      if (!sub) return;

      document.getElementById('gradeMaBaiNop').value = sub.MaBaiNop;
      document.getElementById('gradingTitle').textContent = `Kiểm duyệt Video Vận hành & Chốt điểm: Bài nộp #${sub.MaBaiNop}`;
      document.getElementById('gradeStudentName').textContent = `${sub.TenHocSinh} (#${sub.MaNguoiDung})`;
      document.getElementById('gradeProjectName').textContent = sub.TenDuAn;
      document.getElementById('gradeCodeScore').textContent = `${sub.DiemCode || 10} / 10 (Đạt 100% TestCase)`;
      
      const vLink = document.getElementById('gradeVideoLink');
      vLink.href = sub.VideoVanHanh;
      vLink.textContent = sub.VideoVanHanh;

      document.getElementById('tongDiem').value = sub.DiemCode || 10;
      document.getElementById('nhanXet').value = 'Robot lắp ráp đúng sơ đồ linh kiện, phản hồi cảm biến nhạy và thuật toán vận hành mượt mà.';

      // Tự động nhúng video nếu là YouTube
      const vContainer = document.getElementById('videoContainer');
      const ytMatch = sub.VideoVanHanh ? sub.VideoVanHanh.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i) : null;
      
      if (ytMatch && ytMatch[1]) {
        vContainer.innerHTML = `<iframe width="100%" height="240" src="https://www.youtube.com/embed/${ytMatch[1]}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border:none;"></iframe>`;
      } else {
        vContainer.innerHTML = `
          <div style="text-align:center; padding: 24px;">
            <p style="font-size:0.9rem; margin-bottom:12px; color:#E2E8F0;">Liên kết video lưu trữ đám mây ngoài YouTube</p>
            <a href="${sub.VideoVanHanh}" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="padding: 10px 18px;">
              Mở Video trong Tab Mới ↗
            </a>
          </div>
        `;
      }

      const card = document.getElementById('gradingCard');
      card.style.display = 'block';
      card.scrollIntoView({ behavior: 'smooth' });
    }

    function closeGradingCard() {
      document.getElementById('gradingCard').style.display = 'none';
      document.getElementById('videoContainer').innerHTML = '<span id="videoPlaceholder">Đang tải video...</span>';
    }

    // 3. Submit Form Chốt điểm (KQBN.02)
    document.getElementById('gradingForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnGrade');
      btn.disabled = true;
      btn.textContent = 'Đang lưu minh chứng & cập nhật hệ thống...';

      const maBaiNop = parseInt(document.getElementById('gradeMaBaiNop').value);
      const ketQuaVideo = form.querySelector('input[name="ketQuaVideo"]:checked').value;
      const tongDiem = parseFloat(document.getElementById('tongDiem').value);
      const nhanXet = document.getElementById('nhanXet').value;

      try {
        const res = await fetch('/api/teacher/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            maBaiNop,
            ketQuaVideo,
            tongDiem,
            nhanXet
          })
        });
        const result = await res.json();

        if (result.success) {
          closeGradingCard();
          loadSubmissions();

          const alertBox = document.getElementById('df02Alert');
          const alertText = document.getElementById('df02AlertText');
          alertBox.style.display = 'block';

          if (result.df02_unlocked && result.unlockedProjects.length > 0) {
            const pNames = result.unlockedProjects.map(p => `"${p.tenDuAn}"`).join(', ');
            alertText.textContent = `Học sinh đã đạt yêu cầu! Hệ thống tự động mở khóa dự án tiếp theo (${pNames}) cho học sinh theo quy tắc DF-02.`;
          } else {
            alertText.textContent = `Đã chốt điểm bài tập #${maBaiNop} với kết quả: ${ketQuaVideo}, Tổng điểm: ${tongDiem}.`;
          }
          alertBox.scrollIntoView({ behavior: 'smooth' });
        } else {
          alert('Lỗi: ' + result.message);
        }
      } catch (err) {
        alert('Lỗi kết nối server: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Chốt điểm & Lưu minh chứng (Kích hoạt DF-02)';
      }
    });

    // 4. Quản lý danh mục Lộ trình & Dự án tiên quyết cho Form Giao bài
    async function loadFormDropdowns() {
      try {
        const ltRes = await fetch('/api/lotrinh');
        const ltData = await ltRes.json();
        if (ltData.success) {
          const ltSelect = document.getElementById('maLoTrinh');
          ltSelect.innerHTML = '<option value="">-- Chọn lộ trình học --</option>';
          ltData.lotrinhList.forEach(lt => {
            const opt = document.createElement('option');
            opt.value = lt.MaLoTrinh;
            opt.textContent = `${lt.TenLoTrinh} (${lt.CapDo})`;
            ltSelect.appendChild(opt);
          });
        }

        const daRes = await fetch('/api/projects');
        const daData = await daRes.json();
        if (daData.success) {
          const tqSelect = document.getElementById('maDuAnTienQuyet');
          tqSelect.innerHTML = '<option value="">-- Không có (Mở khóa mặc định) --</option>';
          daData.projects.forEach(da => {
            const opt = document.createElement('option');
            opt.value = da.MaDuAn;
            opt.textContent = `${da.TenDuAn} (${da.CapDo})`;
            tqSelect.appendChild(opt);
          });
        }
      } catch (e) {
        console.error('Lỗi loadFormDropdowns:', e);
      }
    }

    // 5. Thao tác Thêm / Xóa dòng TestCase
    function addTestCaseRow() {
      const tbody = document.getElementById('testCaseBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input type="text" class="form-control tc-input" placeholder="Dữ liệu đầu vào"></td>
        <td><input type="text" class="form-control tc-output" placeholder="Kết quả chuẩn" required></td>
        <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
        <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý sửa lỗi"></td>
        <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
      `;
      tbody.appendChild(tr);
    }

    function removeTestCaseRow(btn) {
      const tbody = document.getElementById('testCaseBody');
      if (tbody.children.length > 1) {
        btn.closest('tr').remove();
      } else {
        alert('Phải có ít nhất 1 TestCase kiểm thử!');
      }
    }

    // 6. Submit Form Giao Dự Án Mới
    document.getElementById('createProjectForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnCreateProject');
      const alertBox = document.getElementById('projectCreateAlert');

      btn.disabled = true;
      btn.textContent = 'Đang khởi tạo dự án và bộ TestCase...';
      alertBox.style.display = 'none';

      // Thu thập TestCase
      const tcRows = document.querySelectorAll('#testCaseBody tr');
      const testCases = [];
      tcRows.forEach(row => {
        const inp = row.querySelector('.tc-input').value.trim();
        const out = row.querySelector('.tc-output').value.trim();
        const wt = parseFloat(row.querySelector('.tc-weight').value) || 1.0;
        const ht = row.querySelector('.tc-hint').value.trim();
        if (out) {
          testCases.push({ input: inp, expectedOutput: out, weight: wt, hint: ht });
        }
      });

      const payload = {
        tenDuAn: document.getElementById('tenDuAn').value.trim(),
        maLoTrinh: document.getElementById('maLoTrinh').value,
        maDuAnTienQuyet: document.getElementById('maDuAnTienQuyet').value || null,
        capDo: document.getElementById('capDo').value,
        hanNop: document.getElementById('hanNop').value || null,
        yeuCauDuAn: document.getElementById('yeuCauDuAn').value.trim(),
        testCases
      };

      try {
        const res = await fetch('/api/teacher/projects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        alertBox.style.display = 'block';

        if (result.success) {
          alertBox.style.background = 'var(--c-success-bg)';
          alertBox.style.color = '#047857';
          alertBox.style.border = '1.5px solid rgba(16, 185, 129, 0.3)';
          alertBox.innerHTML = `<strong>Thành công:</strong> ${result.message} (Đã thêm ${result.testCasesCount} TestCase vào cơ sở dữ liệu)`;

          form.reset();
          loadFormDropdowns();
          alertBox.scrollIntoView({ behavior: 'smooth' });
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1.5px solid rgba(239, 68, 68, 0.3)';
          alertBox.innerHTML = `<strong>Lỗi:</strong> ${result.message}`;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Khởi tạo & Giao Dự án Thực hành (QLDA.01)';
      }
    });

    // 7. Kiểm tra Luồng tự động DF-05 (Cảnh báo cập nhật học liệu)
    async function checkDF05QualityAlert() {
      try {
        const res = await fetch('/api/exam/analytics/check-df05');
        const data = await res.json();

        if (data.success && data.hasWarning) {
          const alertBox = document.getElementById('df05Alert');
          const summary = document.getElementById('df05AlertSummary');
          const list = document.getElementById('df05FlaggedList');

          alertBox.style.display = 'block';
          summary.textContent = `Hệ thống phân tích log lỗi (TKDL.02) phát hiện có ${data.stats.totalFailures} lượt nộp bài không đạt. Bài tập "${data.stats.sampleExercise || 'Dự án STEM'}" có tỷ lệ lỗi lên tới ${data.stats.failureRate}% (> ngưỡng 30%). Hệ thống đã tự động bật cờ CoCanCapNhat = 1 ở bảng HocLieu để nhắc Giảng viên cập nhật.`;

          if (data.allFlaggedMaterials && data.allFlaggedMaterials.length > 0) {
            let html = '<div style="font-weight:700; margin-bottom:8px; color:#991B1B;">Danh sách học liệu đã tự động gắn cờ CoCanCapNhat = 1 (DF-05):</div><ul style="padding-left: 20px;">';
            data.allFlaggedMaterials.forEach(m => {
              html += `<li style="margin-bottom:4px;"><strong>[Mã HL #${m.MaHocLieu}] ${m.TieuDe}</strong> (Loại: ${m.LoaiHocLieu}) · Lộ trình: <em>${m.TenLoTrinh}</em></li>`;
            });
            html += '</ul>';
            list.innerHTML = html;
          }
        }
      } catch (e) {
        console.error('Lỗi kiểm tra DF-05:', e);
      }
    }

    // Khởi chạy khi load trang
    loadSubmissions();
    loadFormDropdowns();
    checkDF05QualityAlert();
  </script>
</body>
</html>
