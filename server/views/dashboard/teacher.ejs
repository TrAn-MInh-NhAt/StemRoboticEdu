    <div class="modal-box" style="max-width: 700px;">
      <div class="modal-header">
        <h3 style="font-size: 1.2rem; font-weight: 800; display:flex; align-items:center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          Chỉnh Sửa Học Liệu &amp; Bài Giảng
        </h3>
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeEditMaterialModal()">&times;</button>
      </div>
      <div style="padding: 24px;">
        <div class="alert alert-info" style="margin-bottom: 20px; font-size: 0.88rem; background: rgba(90, 82, 255, 0.08); border: 1.5px solid rgba(90, 82, 255, 0.2); padding: 12px 16px; border-radius: var(--radius-input); color: #3730A3;">
          <strong>Hỗ trợ học vụ:</strong> Khi bạn lưu cập nhật nội dung học liệu, hệ thống sẽ tự động gỡ cờ nhắc nhở và cập nhật tức thì đến giao diện học sinh.
        </div>

        <form id="editMaterialForm">
          <input type="hidden" id="editMatId">

          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="editMatTenHocLieu">Tên học liệu / Linh kiện *</label>
              <input type="text" id="editMatTenHocLieu" class="form-control" required>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="editMatLoaiHocLieu">Loại học liệu *</label>
              <select id="editMatLoaiHocLieu" class="form-control" required>
                <option value="Bài giảng">Bài giảng lý thuyết</option>
                <option value="Linh kiện">Linh kiện phần cứng</option>
                <option value="Code mẫu">Code mẫu (.ino, .py)</option>
                <option value="Tài liệu kỹ thuật">Datasheet / Tài liệu</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="editMatMaLoTrinh">Gắn với Lộ trình đào tạo</label>
              <select id="editMatMaLoTrinh" class="form-control">
                <option value="">-- Dùng chung toàn hệ thống --</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label" for="editMatTrangThai">Trạng thái *</label>
              <select id="editMatTrangThai" class="form-control">
                <option value="Xuất bản">Xuất bản</option>
                <option value="Bản nháp">Bản nháp</option>
                <option value="Đã ẩn">Đã ẩn</option>
              </select>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label" for="editMatDuongDanTep">Đường dẫn tệp đính kèm / Datasheet / Video URL</label>
            <input type="text" id="editMatDuongDanTep" class="form-control">
          </div>

          <div class="form-group" style="margin-bottom: 20px;">
            <label class="form-label" for="editMatNoiDung">Nội dung chi tiết, thông số kỹ thuật hoặc mã nguồn *</label>
            <textarea id="editMatNoiDung" class="form-control" rows="5" required></textarea>
          </div>

          <div id="editMaterialAlert" style="display:none; padding: 12px 16px; border-radius: var(--radius-input); font-size: 0.88rem; margin-bottom: 16px;"></div>

          <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button type="button" class="btn btn-secondary" onclick="closeEditMaterialModal()">Hủy</button>
            <button type="submit" id="btnSaveEditMaterial" class="btn-playful btn-playful-primary magnet-btn" style="padding: 10px 24px;">
              Lưu Cập Nhật Học Liệu
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal Cảnh báo An toàn khi Ẩn Học liệu có Dự án mở -->
  <div class="modal-overlay" id="confirmHideModal" style="display: none;">
    <div class="modal-box" style="max-width: 520px; border: 2px solid var(--c-secondary); box-shadow: 6px 6px 0 var(--c-text-main);">
      <div class="modal-header" style="background: #FFF5F5;">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: #991B1B; display: flex; align-items: center; gap: 8px;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Cảnh Báo An Toàn Học Vụ
        </h3>
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeConfirmHideModal()">&times;</button>
      </div>
      <div style="padding: 24px;">
        <p id="confirmHideMessage" style="font-size: 0.95rem; line-height: 1.6; color: var(--c-text-main); margin-bottom: 24px;">
          Lộ trình này hiện đang có dự án mở cho học sinh nộp bài. Bạn có chắc chắn muốn ẩn học liệu không?
        </p>
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeConfirmHideModal()">Hủy thao tác</button>
          <button type="button" id="btnForceHideMaterial" class="btn-playful btn-playful-danger magnet-btn" style="padding: 10px 20px;">
            Vẫn tiếp tục Ẩn học liệu
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Báo Cáo Sự Cố Kỹ Thuật Dành Cho Giảng Viên -->
  <div class="modal-overlay" id="teacherReportIssueModal" style="display: none;">
    <div class="modal-box" style="max-width: 580px;">
      <div class="modal-header">
        <h3 style="font-size: 1.15rem; font-weight: 800; display:flex; align-items:center; gap: 8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--c-secondary)" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Báo Cáo Sự Cố &amp; Hỗ Trợ Kỹ Thuật
        </h3>
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeTeacherIssueModal()">&times;</button>
      </div>
      <form id="teacherReportIssueForm" style="padding: 24px;">
        <p style="font-size: 0.88rem; color: var(--c-text-dim); margin-bottom: 20px; line-height: 1.5;">
          Gặp trục trặc khi chấm bài, video học sinh không tải được hoặc cần cập nhật máy chấm Judge Engine? Hãy gửi phiếu sự cố để Quản trị viên xử lý ngay.
        </p>

        <div class="form-group">
          <label class="form-label" for="teacherIssueTitle">Tiêu đề sự cố / Kiến nghị kỹ thuật *</label>
          <input type="text" id="teacherIssueTitle" class="form-control" placeholder="Ví dụ: Máy chấm cổng 5000 phản hồi chậm khi kiểm thử nhiều TestCase" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="teacherIssuePriority">Mức độ ưu tiên *</label>
          <select id="teacherIssuePriority" class="form-control" required>
            <option value="Bình thường">Bình thường (Đề xuất tính năng, hỗ trợ bài học)</option>
            <option value="Khẩn cấp">Khẩn cấp (Máy chấm lỗi, nghẽn duyệt bài kỳ thi)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="teacherIssueContent">Mô tả chi tiết nội dung sự cố *</label>
          <textarea id="teacherIssueContent" class="form-control" rows="4" placeholder="Nhập chi tiết lỗi, mã bài nộp hoặc tình trạng hệ thống..." required></textarea>
        </div>

        <div id="teacherReportAlert" style="display:none; padding: 12px 16px; border-radius: var(--radius-input); font-size: 0.88rem; margin-bottom: 16px;"></div>

        <div style="display: flex; justify-content: flex-end; gap: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeTeacherIssueModal()">Hủy</button>
          <button type="submit" id="btnSubmitTeacherIssue" class="btn-playful btn-playful-primary magnet-btn" style="padding: 10px 24px;">
            Gửi Báo Cáo Sự Cố
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // =========================================================================
    // HỆ THỐNG ĐIỀU HƯỚNG TÁCH TRANG ĐỘC LẬP (Mỗi view là một chức năng riêng biệt)
    // =========================================================================
    const teacherViews = {
      'pending': { elId: 'view-pending', title: 'Duyệt Video Thẩm Định Phần Cứng' },
      'classRoster': { elId: 'view-classRoster', title: 'Quản Lý Học Sinh Lớp 10/1 & Duyệt Thẻ' },
      'createProject': { elId: 'view-createProject', title: 'Giao Dự Án Thực Hành & Thiết Lập TestCase' },
      'materials': { elId: 'view-materials', title: 'Quản Lý Học Liệu, Bài Giảng & Linh Kiện Robotic' },
      'allSubs': { elId: 'view-allSubs', title: 'Tất Cả Bài Nộp Của Học Sinh & Báo Cáo Đào Tạo' }
    };

    function switchTeacherView(viewName) {
      if (!teacherViews[viewName]) viewName = 'pending';
      const target = teacherViews[viewName];

      // 1. Ẩn tất cả view
      document.querySelectorAll('.dashboard-view').forEach(v => {
        v.classList.remove('active');
        v.style.display = 'none';
      });

      // 2. Hiện view được chọn
      const activeEl = document.getElementById(target.elId);
      if (activeEl) {
        activeEl.style.display = 'block';
        activeEl.classList.add('active');
      }

      // 3. Cập nhật breadcrumb
      const breadcrumb = document.getElementById('teacherPageBreadcrumb');
      if (breadcrumb) {
        breadcrumb.textContent = target.title;
      }

      // 4. Tô sáng menu bên trái
      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-view') === viewName) {
          link.classList.add('active');
        }
      });

      // 5. Cập nhật hash URL
      if (history.replaceState) {
        history.replaceState(null, null, '#' + viewName);
      }

      // 6. Làm mới dữ liệu nếu cần
      if (viewName === 'classRoster' && typeof loadClassRoster === 'function') {
        loadClassRoster();
      }
      if (viewName === 'materials' && typeof loadMaterials === 'function') {
        loadMaterials();
      }
      if (viewName === 'allSubs' && typeof loadSubmissions === 'function') {
        loadSubmissions();
      }

      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    function syncTeacherViewFromHash() {
      const hash = (window.location.hash || '').replace('#', '');
      if (hash && teacherViews[hash]) {
        switchTeacherView(hash);
      } else {
        switchTeacherView('pending');
      }
    }
    window.addEventListener('hashchange', syncTeacherViewFromHash);

    let currentSubmissions = [];

    // 1. Tải danh sách bài nộp
    async function loadSubmissions() {
      try {
        const res = await fetch('/api/teacher/submissions');
        const data = await res.json();
        if (!data.success) return;

        currentSubmissions = data.submissions;
        document.getElementById('totalSubsCount').textContent = `${currentSubmissions.length} bài`;

        const pendingBody = document.getElementById('pendingSubmissionsBody');
        pendingBody.innerHTML = '';

        const pendingSubs = currentSubmissions.filter(s => s.TrangThai === 'Chờ duyệt Video');

        // Bảng 1: Pending (DF-01)
        if (pendingSubs.length === 0) {
          pendingBody.innerHTML = '<tr><td colspan="7" class="text-muted" style="text-align:center; padding: 20px;">Hiện không có bài nộp nào đang chờ duyệt video.</td></tr>';
        } else {
          pendingSubs.forEach(s => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><strong>#${s.MaBaiNop}</strong></td>
              <td><strong>${s.TenHocSinh}</strong><br><small class="text-muted">${s.Email}</small></td>
              <td><strong>${s.TenDuAn}</strong></td>
              <td><strong style="color:var(--c-primary);">${s.DiemCode}</strong> / 10</td>
              <td><a href="${s.VideoVanHanh}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Xem Video ↗</a></td>
              <td>${new Date(s.ThoiGianNop).toLocaleString('vi-VN')}</td>
              <td>
                <button class="btn btn-primary btn-sm" onclick="openGrading(${s.MaBaiNop})">
                  Duyệt Video &amp; Chốt điểm
                </button>
              </td>
            `;
            pendingBody.appendChild(tr);
          });
        }

        // Khởi tạo bộ lọc dự án
        populateProjectFilter();
        // Áp dụng bộ lọc cho bảng tất cả bài
        applyTeacherFilter();

      } catch (e) {
        console.error('Lỗi loadSubmissions:', e);
      }
    }

    // Điền danh sách dự án vào dropdown lọc
    function populateProjectFilter() {
      const select = document.getElementById('filterTeacherProject');
      const uniqueProjects = new Map();
      currentSubmissions.forEach(s => {
        if (s.MaDuAn && s.TenDuAn) {
          uniqueProjects.set(s.MaDuAn, s.TenDuAn);
        }
      });
      select.innerHTML = '<option value="all">Tất cả dự án thực hành</option>';
      uniqueProjects.forEach((ten, ma) => {
        const opt = document.createElement('option');
        opt.value = ma;
        opt.textContent = ten;
        select.appendChild(opt);
      });
    }

    // Áp dụng bộ lọc và render bảng bài nộp (XBC.02)
    function applyTeacherFilter() {
      const projVal = document.getElementById('filterTeacherProject').value;
      const statusVal = document.getElementById('filterTeacherStatus').value;

      let filtered = currentSubmissions.filter(s => {
        // Lọc theo dự án
        if (projVal !== 'all' && String(s.MaDuAn) !== String(projVal)) {
          return false;
        }
        // Lọc theo trạng thái điểm
        if (statusVal === 'excellent' && !(s.TongDiem >= 9)) return false;
        if (statusVal === 'pass' && !(s.TongDiem >= 5)) return false;
        if (statusVal === 'fail' && !(s.TongDiem !== null && s.TongDiem < 5)) return false;
        if (statusVal === 'pending' && s.TrangThai !== 'Chờ duyệt Video') return false;

        return true;
      });

      document.getElementById('filterMatchCount').textContent = filtered.length;

      // Cập nhật đường link xuất CSV & Print theo bộ lọc
      const csvLink = document.getElementById('linkDynamicCsv');
      const printLink = document.getElementById('linkDynamicPrint');
      const queryParams = `?maDuAn=${encodeURIComponent(projVal)}&trangThai=${encodeURIComponent(statusVal)}`;
      csvLink.href = `/api/reports/grades-csv${queryParams}`;
      printLink.href = `/print-report${queryParams}`;

      renderSubmissionsTable(filtered);
    }

    function renderSubmissionsTable(subs) {
      const allBody = document.getElementById('allSubmissionsBody');
      allBody.innerHTML = '';

      if (subs.length === 0) {
        allBody.innerHTML = '<tr><td colspan="9" class="text-muted" style="text-align:center; padding: 24px;">Không tìm thấy bài nộp nào phù hợp với bộ lọc hiện tại.</td></tr>';
        return;
      }

      subs.forEach(s => {
        const tr = document.createElement('tr');
        let badgeClass = 'badge-locked';
        if (s.TrangThai === 'Chờ duyệt Video') badgeClass = 'badge-warning';
        if (s.TrangThai === 'Đã chốt điểm') badgeClass = 'badge-success';

        tr.innerHTML = `
          <td><strong>#${s.MaBaiNop}</strong></td>
          <td><strong>${s.TenHocSinh}</strong></td>
          <td>${s.TenDuAn}</td>
          <td>${new Date(s.ThoiGianNop).toLocaleDateString('vi-VN')}</td>
          <td>${s.DiemCode !== null ? s.DiemCode : '--'}</td>
          <td>${s.KetQuaVideo || '<span class="text-muted">Chưa duyệt</span>'}</td>
          <td><strong style="font-size:1.05rem; color:${s.TongDiem >= 8 ? '#047857' : (s.TongDiem >= 5 ? '#B45309' : '#DC2626')};">${s.TongDiem !== null ? s.TongDiem : '--'}</strong></td>
          <td><span class="badge ${badgeClass}">${s.TrangThai}</span></td>
          <td style="max-width: 220px; font-size:0.85rem; color:var(--c-text-dim);">${s.NhanXet || '--'}</td>
        `;
        allBody.appendChild(tr);
      });
    }

    // 2. Khung duyệt & xem video nhúng (KQBN.01, KQBN.02)
    function openGrading(maBaiNop) {
      const sub = currentSubmissions.find(s => s.MaBaiNop === maBaiNop);
      if (!sub) return;

      document.getElementById('gradeMaBaiNop').value = sub.MaBaiNop;
      document.getElementById('gradingTitle').textContent = `Kiểm duyệt Video Vận hành & Chốt điểm: Bài nộp #${sub.MaBaiNop}`;
      document.getElementById('gradeStudentName').textContent = `${sub.TenHocSinh} (#${sub.MaNguoiDung})`;
      document.getElementById('gradeProjectName').textContent = sub.TenDuAn;
      document.getElementById('gradeCodeScore').textContent = `${sub.DiemCode || 10} / 10 (Đạt 100% TestCase)`;
      
      const vLink = document.getElementById('gradeVideoLink');
      vLink.href = sub.VideoVanHanh;
      vLink.textContent = sub.VideoVanHanh;

      document.getElementById('tongDiem').value = sub.DiemCode || 10;
      document.getElementById('nhanXet').value = 'Robot lắp ráp đúng sơ đồ linh kiện, phản hồi cảm biến nhạy và thuật toán vận hành mượt mà.';

      // Tự động nhúng video nếu là YouTube
      const vContainer = document.getElementById('videoContainer');
      const ytMatch = sub.VideoVanHanh ? sub.VideoVanHanh.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i) : null;
      
      if (ytMatch && ytMatch[1]) {
        const vidId = ytMatch[1];
        vContainer.innerHTML = `
          <div style="position: relative; aspect-ratio: 16/9; background: #000; border-radius: 12px; overflow: hidden; margin-bottom: 8px;">
            <iframe width="100%" height="100%" src="https://www.youtube.com/embed/${vidId}?rel=0" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border:none; position: absolute; top:0; left:0; width:100%; height:100%;"></iframe>
          </div>
          <div style="text-align: right;">
            <a href="https://www.youtube.com/watch?v=${vidId}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="font-size: 0.78rem; padding: 4px 10px; display: inline-flex; align-items: center; gap: 4px;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <span>Mở trực tiếp trên YouTube ↗</span>
            </a>
          </div>
        `;
      } else {
        vContainer.innerHTML = `
          <div style="text-align:center; padding: 24px;">
            <p style="font-size:0.9rem; margin-bottom:12px; color:#E2E8F0;">Liên kết video lưu trữ đám mây ngoài YouTube</p>
            <a href="${sub.VideoVanHanh}" target="_blank" rel="noopener" class="btn btn-primary btn-sm" style="padding: 10px 18px;">
              Mở Video trong Tab Mới ↗
            </a>
          </div>
        `;
      }

      const card = document.getElementById('gradingCard');
      card.style.display = 'block';
      card.scrollIntoView({ behavior: 'smooth' });
    }

    function closeGradingCard() {
      document.getElementById('gradingCard').style.display = 'none';
      document.getElementById('videoContainer').innerHTML = '<span id="videoPlaceholder">Đang tải video...</span>';
    }

    // 3. Submit Form Chốt điểm (KQBN.02)
    document.getElementById('gradingForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnGrade');
      btn.disabled = true;
      btn.textContent = 'Đang lưu minh chứng & cập nhật hệ thống...';

      const maBaiNop = parseInt(document.getElementById('gradeMaBaiNop').value);
      const ketQuaVideo = form.querySelector('input[name="ketQuaVideo"]:checked').value;
      const tongDiem = parseFloat(document.getElementById('tongDiem').value);
      const nhanXet = document.getElementById('nhanXet').value;

      try {
        const res = await fetch('/api/teacher/grade', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            maBaiNop,
            ketQuaVideo,
            tongDiem,
            nhanXet
          })
        });
        const result = await res.json();

        if (result.success) {
          closeGradingCard();
          loadSubmissions();

          const alertBox = document.getElementById('df02Alert');
          const alertText = document.getElementById('df02AlertText');
          alertBox.style.display = 'block';

          if (result.df02_unlocked && result.unlockedProjects.length > 0) {
            const pNames = result.unlockedProjects.map(p => `"${p.tenDuAn}"`).join(', ');
            alertText.textContent = `Học sinh đã đạt yêu cầu! Hệ thống tự động mở khóa dự án tiếp theo (${pNames}) cho học sinh theo quy tắc DF-02.`;
          } else {
            alertText.textContent = `Đã chốt điểm bài tập #${maBaiNop} với kết quả: ${ketQuaVideo}, Tổng điểm: ${tongDiem}.`;
          }
          alertBox.scrollIntoView({ behavior: 'smooth' });
        } else {
          alert('Lỗi: ' + result.message);
        }
      } catch (err) {
        alert('Lỗi kết nối server: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Chốt điểm & Lưu minh chứng (Kích hoạt DF-02)';
      }
    });

    // 4. Quản lý danh mục Lộ trình & Dự án tiên quyết cho Form Giao bài
    async function loadFormDropdowns() {
      try {
        const ltRes = await fetch('/api/lotrinh');
        const ltData = await ltRes.json();
        if (ltData.success) {
          const ltSelect = document.getElementById('maLoTrinh');
          const matLtSelect = document.getElementById('matMaLoTrinh');
          const editMatLtSelect = document.getElementById('editMatMaLoTrinh');

          ltSelect.innerHTML = '<option value="">-- Chọn lộ trình học --</option>';
          if (matLtSelect) matLtSelect.innerHTML = '<option value="">-- Dùng chung toàn hệ thống --</option>';
          if (editMatLtSelect) editMatLtSelect.innerHTML = '<option value="">-- Dùng chung toàn hệ thống --</option>';

          ltData.lotrinhList.forEach(lt => {
            const opt = document.createElement('option');
            opt.value = lt.MaLoTrinh;
            opt.textContent = `${lt.TenLoTrinh} (${lt.CapDo})`;
            ltSelect.appendChild(opt);

            if (matLtSelect) {
              const opt2 = document.createElement('option');
              opt2.value = lt.MaLoTrinh;
              opt2.textContent = `${lt.TenLoTrinh} (${lt.CapDo})`;
              matLtSelect.appendChild(opt2);
            }
            if (editMatLtSelect) {
              const opt3 = document.createElement('option');
              opt3.value = lt.MaLoTrinh;
              opt3.textContent = `${lt.TenLoTrinh} (${lt.CapDo})`;
              editMatLtSelect.appendChild(opt3);
            }
          });
        }

        const daRes = await fetch('/api/projects');
        const daData = await daRes.json();
        if (daData.success) {
          const tqSelect = document.getElementById('maDuAnTienQuyet');
          const editProjSelect = document.getElementById('selectEditProject');

          tqSelect.innerHTML = '<option value="">-- Không có (Mở khóa mặc định) --</option>';
          if (editProjSelect) {
            editProjSelect.innerHTML = '<option value="">-- Chọn dự án cần sửa TestCase --</option>';
          }

          daData.projects.forEach(da => {
            const opt = document.createElement('option');
            opt.value = da.MaDuAn;
            opt.textContent = `${da.TenDuAn} (${da.CapDo})`;
            tqSelect.appendChild(opt);

            if (editProjSelect) {
              const opt2 = document.createElement('option');
              opt2.value = da.MaDuAn;
              opt2.textContent = `${da.TenDuAn} (${da.CapDo})`;
              editProjSelect.appendChild(opt2);
            }
          });
        }
      } catch (e) {
        console.error('Lỗi loadFormDropdowns:', e);
      }
    }

    // 5. Thao tác Chế độ Giao mới / Chỉnh sửa dự án & TestCase (QLDA.01)
    function switchProjectMode(mode) {
      const btnNew = document.getElementById('btnModeNewProject');
      const btnEdit = document.getElementById('btnModeEditProject');
      const editWrap = document.getElementById('selectExistingProjectWrap');
      const form = document.getElementById('createProjectForm');
      const hiddenId = document.getElementById('editingProjectId');
      const submitBtn = document.getElementById('btnCreateProject');
      const alertBox = document.getElementById('projectCreateAlert');
      if (alertBox) alertBox.style.display = 'none';

      if (mode === 'edit') {
        btnEdit.className = 'btn btn-primary btn-sm';
        btnNew.className = 'btn btn-secondary btn-sm';
        editWrap.style.display = 'inline-flex';
        submitBtn.innerHTML = `Lưu Thay Đổi Dự Án &amp; Cập Nhật TestCase <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      } else {
        btnNew.className = 'btn btn-primary btn-sm';
        btnEdit.className = 'btn btn-secondary btn-sm';
        editWrap.style.display = 'none';
        hiddenId.value = '';
        form.reset();
        document.getElementById('selectEditProject').value = '';
        submitBtn.innerHTML = `Khởi tạo &amp; Giao Dự án Thực hành <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        
        // Reset 2 dòng TestCase mẫu
        const tbody = document.getElementById('testCaseBody');
        tbody.innerHTML = `
          <tr>
            <td><input type="text" class="form-control tc-input" placeholder="Ví dụ: 1"></td>
            <td><input type="text" class="form-control tc-output" placeholder="Ví dụ: LED_ON" required></td>
            <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
            <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý kiểm tra chân Digital"></td>
            <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
          </tr>
          <tr>
            <td><input type="text" class="form-control tc-input" placeholder="Ví dụ: 0"></td>
            <td><input type="text" class="form-control tc-output" placeholder="Ví dụ: LED_OFF" required></td>
            <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
            <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý kiểm tra lệnh LOW"></td>
            <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
          </tr>
        `;
      }
    }

    async function loadProjectForEdit(projectId) {
      if (!projectId) {
        switchProjectMode('new');
        return;
      }
      try {
        const res = await fetch(`/api/teacher/projects/${projectId}/testcases`);
        const data = await res.json();
        if (!data.success) {
          alert('Không thể tải thông tin dự án: ' + data.message);
          return;
        }

        document.getElementById('editingProjectId').value = projectId;
        document.getElementById('tenDuAn').value = data.project.TenDuAn || '';
        document.getElementById('maLoTrinh').value = data.project.MaLoTrinh || '';
        document.getElementById('maDuAnTienQuyet').value = data.project.MaDuAnTienQuyet || '';
        document.getElementById('capDo').value = data.project.CapDo || 'Cơ bản';
        if (data.project.HanNop) {
          const d = new Date(data.project.HanNop);
          document.getElementById('hanNop').value = d.toISOString().split('T')[0];
        } else {
          document.getElementById('hanNop').value = '';
        }
        document.getElementById('yeuCauDuAn').value = data.project.YeuCauDuAn || '';

        // Nạp danh sách TestCase vào bảng
        const tbody = document.getElementById('testCaseBody');
        tbody.innerHTML = '';
        if (Array.isArray(data.testCases) && data.testCases.length > 0) {
          data.testCases.forEach(tc => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><input type="text" class="form-control tc-input" value="${(tc.DuLieuDauVao || '').replace(/"/g, '&quot;')}" placeholder="Dữ liệu đầu vào"></td>
              <td><input type="text" class="form-control tc-output" value="${(tc.KetQuaDauRa || '').replace(/"/g, '&quot;')}" placeholder="Kết quả chuẩn" required></td>
              <td><input type="number" class="form-control tc-weight" value="${tc.TrongSoDiem || 3.0}" step="0.5" min="0.5"></td>
              <td><input type="text" class="form-control tc-hint" value="${(tc.GoiYSuaLoi || '').replace(/"/g, '&quot;')}" placeholder="Gợi ý sửa lỗi"></td>
              <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
            `;
            tbody.appendChild(tr);
          });
        } else {
          addTestCaseRow();
        }

        const alertBox = document.getElementById('projectCreateAlert');
        alertBox.style.display = 'block';
        alertBox.style.background = 'rgba(90, 82, 255, 0.08)';
        alertBox.style.color = 'var(--c-primary)';
        alertBox.style.border = '1px solid rgba(90, 82, 255, 0.25)';
        alertBox.innerHTML = `<strong>Chế độ chỉnh sửa:</strong> Đang chỉnh sửa <em>"${data.project.TenDuAn}"</em> với ${data.testCases.length} TestCase. Bạn có thể thêm/xóa/sửa từng dòng kiểm thử rồi nhấn Lưu.`;
      } catch (err) {
        console.error('Lỗi loadProjectForEdit:', err);
        alert('Lỗi tải dữ liệu dự án: ' + err.message);
      }
    }

    function addTestCaseRow() {
      const tbody = document.getElementById('testCaseBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><input type="text" class="form-control tc-input" placeholder="Dữ liệu đầu vào"></td>
        <td><input type="text" class="form-control tc-output" placeholder="Kết quả chuẩn" required></td>
        <td><input type="number" class="form-control tc-weight" value="3.0" step="0.5" min="0.5"></td>
        <td><input type="text" class="form-control tc-hint" placeholder="Gợi ý sửa lỗi"></td>
        <td><button type="button" class="btn btn-secondary btn-sm" onclick="removeTestCaseRow(this)" style="color:#DC2626; font-weight:700;">&times;</button></td>
      `;
      tbody.appendChild(tr);
    }

    function removeTestCaseRow(btn) {
      const tbody = document.getElementById('testCaseBody');
      if (tbody.children.length > 1) {
        btn.closest('tr').remove();
      } else {
        alert('Phải có ít nhất 1 TestCase kiểm thử!');
      }
    }

    // 6. Submit Form Giao Dự Án Mới hoặc Cập Nhật Dự Án Đã Có (QLDA.01)
    document.getElementById('createProjectForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnCreateProject');
      const alertBox = document.getElementById('projectCreateAlert');
      const editingId = document.getElementById('editingProjectId').value;
      const isEditing = Boolean(editingId);

      btn.disabled = true;
      btn.textContent = isEditing ? 'Đang cập nhật dự án và bộ TestCase...' : 'Đang khởi tạo dự án và bộ TestCase...';
      alertBox.style.display = 'none';

      // Thu thập TestCase
      const tcRows = document.querySelectorAll('#testCaseBody tr');
      const testCases = [];
      tcRows.forEach(row => {
        const inp = row.querySelector('.tc-input').value.trim();
        const out = row.querySelector('.tc-output').value.trim();
        const wt = parseFloat(row.querySelector('.tc-weight').value) || 1.0;
        const ht = row.querySelector('.tc-hint').value.trim();
        if (out) {
          testCases.push({ input: inp, expectedOutput: out, weight: wt, hint: ht });
        }
      });

      const payload = {
        tenDuAn: document.getElementById('tenDuAn').value.trim(),
        maLoTrinh: document.getElementById('maLoTrinh').value,
        maDuAnTienQuyet: document.getElementById('maDuAnTienQuyet').value || null,
        capDo: document.getElementById('capDo').value,
        hanNop: document.getElementById('hanNop').value || null,
        yeuCauDuAn: document.getElementById('yeuCauDuAn').value.trim(),
        testCases
      };

      try {
        const url = isEditing ? `/api/teacher/projects/${editingId}` : '/api/teacher/projects';
        const method = isEditing ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        alertBox.style.display = 'block';

        if (result.success) {
          alertBox.style.background = 'var(--c-success-bg)';
          alertBox.style.color = '#047857';
          alertBox.style.border = '1.5px solid rgba(16, 185, 129, 0.3)';
          alertBox.innerHTML = `<strong>Thành công:</strong> ${result.message} (Đã lưu ${result.testCasesCount} TestCase vào cơ sở dữ liệu)`;

          if (!isEditing) {
            form.reset();
          }
          loadFormDropdowns();
          alertBox.scrollIntoView({ behavior: 'smooth' });
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1.5px solid rgba(239, 68, 68, 0.3)';
          alertBox.innerHTML = `<strong>Lỗi:</strong> ${result.message}`;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = isEditing ? 'Lưu Thay Đổi Dự Án & Cập Nhật TestCase' : 'Khởi tạo & Giao Dự án Thực hành (QLDA.01)';
      }
    });

    // ==============================================================================
    // 7. QUẢN LÝ HỌC LIỆU & BÀI GIẢNG (QTHL.01 & QTHL.02 / PHÂN HỆ 2)
    // ==============================================================================
    let currentMaterialsList = [];
    let pendingHideMaterialId = null;

    function toggleMaterialForm() {
      const box = document.getElementById('addMaterialBox');
      const btn = document.getElementById('btnToggleMatForm');
      if (box.style.display === 'none' || !box.style.display) {
        box.style.display = 'block';
        btn.textContent = '✕ Đóng form';
        box.scrollIntoView({ behavior: 'smooth' });
      } else {
        box.style.display = 'none';
        btn.textContent = '+ Thêm học liệu mới';
      }
    }

    async function loadMaterials() {
      const tbody = document.getElementById('materialsTableBody');
      try {
        const res = await fetch('/api/materials');
        const data = await res.json();

        if (!data.success || !data.materials || data.materials.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-muted" style="text-align:center; padding: 24px;">Chưa có học liệu nào trong hệ thống.</td></tr>';
          return;
        }

        currentMaterialsList = data.materials;
        tbody.innerHTML = '';

        data.materials.forEach(m => {
          const tr = document.createElement('tr');

          // Loại học liệu badge
          let loaiBadge = 'badge-primary';
          if (m.LoaiHocLieu === 'Linh kiện') loaiBadge = 'badge-warning';
          if (m.LoaiHocLieu === 'Code mẫu') loaiBadge = 'badge-success';

          // Cờ DF-05 badge
          let df05Badge = '<span class="badge badge-success" style="font-size:0.75rem;">Chuẩn hoá</span>';
          if (m.CoCanCapNhat) {
            df05Badge = '<span class="badge badge-danger" style="animation: pulse-core 2s infinite; font-size:0.75rem;">Cần cập nhật</span>';
          }

          // Trạng thái badge
          const isHidden = (m.TrangThai === 'Đã ẩn');
          const statusBadge = isHidden 
            ? '<span class="badge badge-locked">Đã ẩn</span>' 
            : '<span class="badge badge-success">Xuất bản</span>';

          const noiDungRutGon = m.NoiDung ? (m.NoiDung.length > 90 ? m.NoiDung.substring(0, 90) + '...' : m.NoiDung) : 'Chưa có mô tả';

          tr.innerHTML = `
            <td><strong>#${m.MaHocLieu}</strong></td>
            <td>
              <div style="font-weight: 800; font-size: 0.95rem; color: var(--c-text-main); margin-bottom: 2px;">
                ${m.TenHocLieu}
              </div>
              <div style="font-size: 0.8rem; color: var(--c-text-dim); line-height: 1.4;">
                ${noiDungRutGon}
              </div>
              ${m.DuongDanTep ? `<div style="margin-top: 4px;"><a href="${m.DuongDanTep}" target="_blank" rel="noopener" style="font-size:0.75rem; color:var(--c-primary); font-weight:600;">Xem tệp đính kèm ↗</a></div>` : ''}
            </td>
            <td><span class="badge ${loaiBadge}">${m.LoaiHocLieu}</span></td>
            <td><span style="font-size: 0.85rem; font-weight: 600;">${m.TenLoTrinh || '<em class="text-muted">Chung hệ thống</em>'}</span></td>
            <td>${df05Badge}</td>
            <td>${statusBadge}</td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 6px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="openEditMaterialModal(${m.MaHocLieu})" title="Chỉnh sửa & Giải tỏa cờ DF-05">
                  Sửa
                </button>
                <button type="button" class="btn ${isHidden ? 'btn-primary' : 'btn-secondary'} btn-sm" onclick="toggleMaterialStatus(${m.MaHocLieu})" style="${isHidden ? '' : 'color: #DC2626;'}">
                  ${isHidden ? 'Hiện' : 'Ẩn'}
                </button>
              </div>
            </td>
          `;
          tbody.appendChild(tr);
        });

      } catch (err) {
        console.error('Lỗi tải danh sách học liệu:', err);
        tbody.innerHTML = '<tr><td colspan="7" class="text-muted" style="text-align:center; padding: 24px;">Lỗi tải học liệu: ' + err.message + '</td></tr>';
      }
    }

    // Submit form thêm mới học liệu (QTHL.01)
    document.getElementById('createMaterialForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnCreateMaterial');
      const alertBox = document.getElementById('materialCreateAlert');

      btn.disabled = true;
      btn.textContent = 'Đang lưu học liệu...';
      alertBox.style.display = 'none';

      const payload = {
        tenHocLieu: document.getElementById('matTenHocLieu').value.trim(),
        loaiHocLieu: document.getElementById('matLoaiHocLieu').value,
        maLoTrinh: document.getElementById('matMaLoTrinh').value || null,
        duongDanTep: document.getElementById('matDuongDanTep').value.trim() || null,
        trangThai: document.getElementById('matTrangThai').value,
        noiDung: document.getElementById('matNoiDung').value.trim()
      };

      try {
        const res = await fetch('/api/materials', {
