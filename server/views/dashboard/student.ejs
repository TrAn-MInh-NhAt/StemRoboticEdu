          consoleBadge.textContent = 'Lỗi nộp bài';
        }

      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Gửi Bài &amp; Kích Hoạt Máy Chấm (DF-01) <svg viewBox="0 0 24 24" width="18" height="18" style="vertical-align:middle; fill:currentColor;"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      }
    });

    // 3. Tải lịch sử bài nộp của học sinh (KQBN.02)
