              <td><code style="background: rgba(90, 82, 255, 0.08); padding: 4px 8px; border-radius: 6px; font-weight: 700; color: var(--c-primary); font-family: monospace;">${tc.DuLieuDauVao || '(Không có input)'}</code></td>
              <td><code style="background: rgba(4, 120, 87, 0.1); padding: 4px 8px; border-radius: 6px; font-weight: 700; color: #047857; font-family: monospace;">${tc.KetQuaDauRa}</code></td>
              <td style="text-align: center; font-weight: 800; color: var(--c-accent);">${tc.TrongSoDiem || 3}đ</td>
              <td style="font-size: 0.85rem; color: var(--c-text-dim);">${tc.GoiYSuaLoi || 'Tuân thủ đúng chuỗi đầu ra'}</td>
            `;
            tcTable.appendChild(tr);
