<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Không gian Học tập STEM — Học sinh</title>
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <!-- Nền Blobs lơ lửng -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <div class="app-shell">
    <!-- Sidebar Studio Kỹ Thuật (Neo-Brutalist & Deep Dark Console) -->
    <aside class="sidebar">
      <!-- Không gian học tập: Bấm để về Lộ trình & Dự án (Không gian chính của học sinh) -->
      <a href="javascript:void(0)" onclick="switchView('lotrinh')" class="sidebar-brand" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px;" title="Về Lộ trình &amp; Dự án (Không gian học tập)">
        <div class="brand-symbol">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="#FFF" fill="none" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <div class="brand-title">STEM Robotic</div>
          <div class="brand-tag">Học sinh · Không gian học tập</div>
        </div>
      </a>

      <!-- Thẻ người dùng: Bấm Avatar hoặc tên để vào Hồ sơ cá nhân -->
      <a href="/profile" class="sidebar-user-card" title="Xem & Cập nhật Hồ sơ cá nhân (QTHT.02)">
        <div class="user-avatar-circle">
          <%= user.HoTen.charAt(user.HoTen.lastIndexOf(' ') + 1) || 'H' %>
        </div>
        <div class="user-meta">
          <div class="user-name" style="display: flex; align-items: center; gap: 6px;">
            <span><%= user.HoTen %></span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
          <div class="user-role-label">Hồ sơ cá nhân · Mã #<%= user.MaNguoiDung %></div>
        </div>
      </a>

      <!-- Menu Điều Hướng Các Trang / Phân Hệ Chức Năng Riêng Biệt -->
      <ul class="sidebar-nav">
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('lotrinh')" data-view="lotrinh" class="sidebar-nav-link active">
            <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span>Lộ trình &amp; Dự án</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('library')" data-view="library" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
            <span>Thư viện bài giảng</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('submission')" data-view="submission" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>Nộp bài thực hành</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('judge')" data-view="judge" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            <span>Khoang máy chấm</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('lookup')" data-view="lookup" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            <span>Tra cứu linh kiện &amp; Lỗi</span>
          </a>
        </li>
        <li class="sidebar-nav-item">
          <a href="javascript:void(0)" onclick="switchView('history')" data-view="history" class="sidebar-nav-link">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Lịch sử &amp; Bảng điểm</span>
          </a>
        </li>
        <!-- Cộng đồng & Vinh danh: Menu thả xuống phân hệ con -->
        <li class="sidebar-nav-item sidebar-dropdown" id="studentCommunityDropdown">
          <button type="button" class="sidebar-dropdown-toggle" onclick="toggleSidebarDropdown(this)">
            <div style="display: flex; align-items: center; gap: 12px;">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              <span>Cộng đồng &amp; Vinh danh</span>
            </div>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="sidebar-submenu">
            <li>
              <a href="javascript:void(0)" onclick="switchView('community-fame')" data-view="community-fame" class="sidebar-sub-link">
                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Bảng Vinh Danh</span>
              </a>
            </li>
            <li>
              <a href="javascript:void(0)" onclick="switchView('community-forum')" data-view="community-forum" class="sidebar-sub-link">
                <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span>Diễn đàn Trao đổi</span>
              </a>
            </li>
            <li>
              <a href="javascript:void(0)" onclick="openNewCommunityPostModal()" class="sidebar-sub-link">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span>Đăng thảo luận mới</span>
              </a>
            </li>
          </ul>
        </li>
        <li class="sidebar-nav-item">
          <a href="/exam" class="sidebar-nav-link" style="color: var(--c-secondary);">
            <svg viewBox="0 0 24 24" style="stroke: var(--c-secondary);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Phòng thi trực tuyến</span>
          </a>
        </li>

        <li class="sidebar-nav-item" style="margin-top: 14px;">
          <a href="/" class="sidebar-nav-link" style="color: var(--c-accent);">
            <svg viewBox="0 0 24 24" style="stroke: var(--c-accent);"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
            <span>Về Trang Chủ (/)</span>
          </a>
        </li>
      </ul>

      <div class="sidebar-footer">
        <a href="/logout" class="btn-sidebar-logout">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Đăng xuất tài khoản</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Canvas -->
    <main class="main-content">
      <!-- Vùng hiển thị Thông báo Hệ thống tự động (HTTB.02) -->
      <div id="systemBroadcastContainer" style="margin-bottom: 24px;"></div>

      <!-- Top Breadcrumb -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 0.85rem; color: var(--c-text-dim); font-weight: 600;">
          <a href="javascript:void(0)" onclick="switchView('lotrinh')" style="color: inherit; text-decoration: none;" title="Về Lộ trình &amp; Dự án"><span>Không gian học tập</span></a>
          <span style="margin: 0 8px;">/</span>
          <span style="color: var(--c-primary);" id="pageBreadcrumb">Lộ trình Đào tạo Robotics &amp; Dự Án</span>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- PHÂN HỆ 1: LỘ TRÌNH ĐÀO TẠO & CÁC DỰ ÁN THỰC HÀNH (Trang Mặc Định)       -->
      <!-- ========================================================================= -->
      <div id="view-lotrinh" class="dashboard-view active">
        <!-- Hero Welcome Card Cá Nhân Hóa (Bento Card) -->
        <section class="bento-card" style="margin-bottom: 36px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary); position: relative; overflow: hidden;">
          <!-- Watermark mạch vi điều khiển chìm góc thẻ -->
          <svg style="position: absolute; right: -20px; top: -20px; width: 180px; height: 180px; opacity: 0.06; pointer-events: none;" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="40" stroke="var(--c-primary)" stroke-width="2" stroke-dasharray="6 4"/>
            <circle cx="50" cy="50" r="24" stroke="var(--c-secondary)" stroke-width="3"/>
            <rect x="42" y="42" width="16" height="16" fill="var(--c-accent)" transform="rotate(45 50 50)"/>
          </svg>

          <div style="position: relative; z-index: 2;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;">
              <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: #3730A3; font-weight: 700; margin-bottom: 0;">Học Viện Sáng Tạo STEM Robotic</span>
              <div class="hero-hud-badge" style="font-size: 0.72rem; padding: 4px 10px;">
                <span class="telemetry-pulse"></span>
                <span>TRẠM THỰC HÀNH #<%= user.MaNguoiDung %> // KẾT NỐI MÁY CHẤM 0.05S</span>
              </div>
            </div>
            <h1 style="font-size: clamp(2rem, 3.5vw, 2.8rem); font-weight: 800; margin-bottom: 10px;">
              Xin chào, <span class="title-highlight"><%= user.HoTen %></span>
            </h1>
            <p style="font-size: 1.05rem; color: var(--c-text-dim); max-width: 580px; text-wrap: pretty;">
              Chào mừng bạn quay trở lại phòng thí nghiệm. Hoàn thành các dự án thực hành để tự động mở khóa các thử thách tiếp theo (Luồng tự động DF-02).
            </p>
          </div>
          <div style="min-width: 260px; padding: 12px 0; position: relative; z-index: 2;">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--c-text-main); margin-bottom: 8px;" id="studentProgressText">
              Tiến độ hoàn thành: Đang cập nhật...
            </div>
            <div class="progress-track" style="width: 100%; height: 10px;">
              <div class="progress-bar-fill" id="studentProgressBar" style="width: 30%;"></div>
            </div>
          </div>
        </section>

        <!-- 1. LỘ TRÌNH ĐÀO TẠO & CÁC DỰ ÁN THỰC HÀNH -->
        <section id="lotrinhSection" style="margin-bottom: 40px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
            <div>
              <h2 style="font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em;">
                Lộ Trình Đào Tạo &amp; Dự Án Thực Hành
              </h2>
              <p style="font-size: 0.95rem; color: var(--c-text-dim); margin-top: 4px;">
                Khám phá các trạm vi mạch, lập trình nhúng C++ và robot tự hành đa cảm biến.
              </p>
            </div>
            <button class="btn btn-secondary btn-sm" onclick="loadLoTrinhAndProjects()">
              Làm mới danh sách
            </button>
          </div>

          <div id="lotrinhContainer">
            <p class="text-muted" style="font-size: 0.95rem; padding: 24px 0;">Đang kết nối hệ thống và nạp dữ liệu lộ trình...</p>
          </div>
        </section>
      </div>

      <!-- ========================================================================= -->
      <!-- KHÔNG GIAN BÀI TẬP & NỘP BÀI CHI TIẾT (PROJECT WORKSPACE)                 -->
      <!-- ========================================================================= -->
      <div id="view-project-workspace" class="dashboard-view" style="display: none;">
        <!-- Top Navigation: Breadcrumb & Nút Quay Lại -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
          <div style="font-size: 0.9rem; color: var(--c-text-dim); font-weight: 600; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <a href="javascript:void(0)" onclick="switchView('lotrinh')" style="color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
              <span>Lộ Trình Đào Tạo</span>
            </a>
            <span>/</span>
            <span id="wsLoTrinhBreadcrumb" style="color: var(--c-text-dim);">Lộ trình #01</span>
            <span>/</span>
            <span id="wsProjectBreadcrumb" style="color: var(--c-primary); font-weight: 700;">Dự án 1</span>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" onclick="switchView('lotrinh')" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            <span>← Quay Lại Danh Sách Lộ Trình</span>
          </button>
        </div>

        <!-- Thẻ Hero Bento Card: Thông Tin Dự Án -->
        <section class="bento-card" style="margin-bottom: 28px; border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary); position: relative; overflow: hidden;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px;">
            <div style="flex: 1; min-width: 280px;">
              <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px; flex-wrap: wrap;">
                <span id="wsStageBadge" class="tech-chip" style="background: rgba(90,82,255,0.15); color: #3730A3; font-weight: 800;">LỘ TRÌNH 1</span>
                <span id="wsLevelBadge" class="tech-chip">Cơ bản</span>
                <span id="wsStatusBadge" class="badge badge-primary">Sẵn sàng nộp bài</span>
              </div>
              <h1 id="wsProjectTitle" style="font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 800; line-height: 1.25; margin-bottom: 8px;">
                Đang nạp tên dự án...
              </h1>
              <div style="font-size: 0.92rem; color: var(--c-text-dim);">
                Thời hạn hoàn thành: <strong id="wsDeadline" style="color: var(--c-text-main);">Chưa thiết lập</strong> · Thang điểm tối đa: <strong>10.0 / 10.0đ</strong>
              </div>
            </div>
            <div id="wsScoreBox" style="background: rgba(90,82,255,0.06); padding: 16px 24px; border-radius: 20px; border: 2px solid rgba(90,82,255,0.25); text-align: right; min-width: 200px;">
              <div style="font-size: 0.78rem; font-weight: 800; color: var(--c-text-dim); text-transform: uppercase;">Điểm hiện tại của bạn</div>
              <div id="wsCurrentScore" style="font-size: 2.2rem; font-weight: 800; color: var(--c-primary); line-height: 1.1; margin: 4px 0;">-- / 10đ</div>
              <div id="wsCurrentStatus" style="font-size: 0.85rem; font-weight: 700; color: var(--c-text-dim);">Chưa nộp bài</div>
            </div>
          </div>
        </section>

        <!-- Khung 1: Câu Hỏi & Yêu Cầu Dự Án Thực Hành -->
        <section class="card" style="margin-bottom: 28px; border: 1.5px solid rgba(11,15,25,0.12);">
          <div class="card-header" style="background: #FAFAFB; border-bottom: 1.5px solid rgba(11,15,25,0.08); padding: 18px 24px;">
            <h3 style="font-size: 1.2rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary)" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span>1. Câu Hỏi &amp; Yêu Cầu Dự Án Thực Hành</span>
            </h3>
          </div>
          <div style="padding: 24px;">
            <div id="wsProjectRequirement" style="font-size: 1rem; line-height: 1.7; color: var(--c-text-main); white-space: pre-line; margin-bottom: 20px;"></div>
            
            <!-- Linh kiện phần cứng & Học liệu tham khảo -->
            <div id="wsMaterialsBox" style="background: rgba(90,82,255,0.04); border-radius: 16px; padding: 18px 20px; border: 1.5px dashed rgba(90,82,255,0.25);">
              <div style="font-size: 0.82rem; font-weight: 800; color: var(--c-primary); margin-bottom: 12px; display: flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                <span>Học liệu, Code mẫu &amp; Sơ đồ chân linh kiện (Bấm để tra cứu lý thuyết):</span>
              </div>
              <div id="wsMaterialsList" style="display: flex; gap: 10px; flex-wrap: wrap;"></div>
            </div>
          </div>
        </section>

        <!-- Khung 2: Bộ Tiêu Chí Dữ Liệu Kiểm Thử Tự Động (TestCases) -->
        <section class="card" style="margin-bottom: 28px; border: 1.5px solid rgba(11,15,25,0.12);">
          <div class="card-header" style="background: #FAFAFB; border-bottom: 1.5px solid rgba(11,15,25,0.08); padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
              <h3 style="font-size: 1.2rem; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent)" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                <span>2. Bảng Dữ Liệu Đầu Vào &amp; Kết Quả Đầu Ra Chuẩn (Bộ TestCases)</span>
              </h3>
              <p style="font-size: 0.85rem; color: var(--c-text-dim); margin-top: 4px;">
                Chương trình máy chấm sẽ nạp từng giá trị Input và so sánh kết quả in ra của em với Output mong đợi.
              </p>
            </div>
            <span class="hero-hud-badge" style="font-size: 0.78rem;">
              <span class="telemetry-pulse"></span>
              <span id="wsTestCaseBadge">3 TESTCASES</span>
            </span>
          </div>
          <div style="padding: 20px 24px; overflow-x: auto;">
            <table class="table-custom" style="width: 100%;">
              <thead>
                <tr>
                  <th style="width: 60px; text-align: center;">STT</th>
                  <th>Dữ Liệu Đầu Vào (Input qua Stdin)</th>
                  <th>Kết Quả Mong Đợi (Output Chuẩn)</th>
                  <th style="width: 130px; text-align: center;">Trọng Số Điểm</th>
                  <th>Gợi Ý Khắc Phục Lỗi</th>
                </tr>
              </thead>
              <tbody id="wsTestCasesTable"></tbody>
            </table>
          </div>
        </section>

        <!-- Khung 3: Không Gian Nộp Bài Thực Hành (Mã Nguồn & Video) -->
        <section class="card" style="border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-text-main); margin-bottom: 40px;">
          <div class="card-header" style="background: rgba(90,82,255,0.04); border-bottom: 2px solid var(--c-text-main); padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
              <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: var(--c-primary); font-weight: 700; margin-bottom: 6px; display: inline-block;">
                Thực Nghiệm Phần Cứng &amp; Mã Nguồn
              </span>
              <h3 style="font-size: 1.25rem; font-weight: 800;">3. Nộp Mã Nguồn &amp; Video Nghiệm Thu Thực Tế</h3>
            </div>
            <span class="badge badge-primary">FastAPI &lt; 0.05s</span>
          </div>

          <!-- Thanh Công Cụ Nhanh Nạp Code Mẫu -->
          <div style="background: #FAFAFB; border-bottom: 1.5px dashed rgba(11, 15, 25, 0.12); padding: 14px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="font-size: 0.82rem; font-weight: 800; text-transform: uppercase; color: var(--c-primary); display: flex; align-items: center; gap: 6px;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
