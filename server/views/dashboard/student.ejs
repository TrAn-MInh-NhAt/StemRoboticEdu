    function openLearningHubModalById(id) {
      const m = allLoadedMaterials[id];
      if (!m) return;
      activeHubMaterial = m;

      const modal = document.getElementById('learningHubModal');
      const badge = document.getElementById('hubBadge');
      const title = document.getElementById('hubTitle');
      const content = document.getElementById('hubContentText');
      const pinoutBox = document.getElementById('hubPinoutBox');
      const codeBox = document.getElementById('hubCodeBox');
      const codeFilename = document.getElementById('hubCodeFilename');

      badge.textContent = `[${m.LoaiHocLieu}]`;
      if (m.LoaiHocLieu === 'Linh kiện') {
        badge.style.background = 'rgba(245, 158, 11, 0.15)';
        badge.style.color = '#B45309';
