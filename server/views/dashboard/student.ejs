        // Cập nhật thanh tiến độ học tập
        if (totalProjects > 0) {
          const pct = Math.round((completedProjects / totalProjects) * 100);
          document.getElementById('studentProgressText').textContent = `Tiến độ hoàn thành: ${completedProjects}/${totalProjects} dự án (${pct}%)`;
          document.getElementById('studentProgressBar').style.width = pct + '%';
        }

        // Tự động mở dự án nếu có tham số serverActiveProjectId hoặc ?project=ID
        if (serverActiveProjectId) {
          openProjectWorkspace(serverActiveProjectId);
        } else {
          const urlParams = new URLSearchParams(window.location.search);
          const pParam = urlParams.get('project');
          if (pParam) {
            openProjectWorkspace(pParam);
          }
        }

      } catch (err) {
        console.error('Lỗi tải lộ trình:', err);
