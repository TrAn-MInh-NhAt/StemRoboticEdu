          <div style="font-size: 0.82rem; font-weight: 800; color: var(--c-primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            1. Nội Dung Lý Thuyết &amp; Kiến Thức Cơ Bản (FR-03):
          </div>
          <div id="hubContentText" style="font-size: 0.95rem; line-height: 1.7; color: var(--c-text-main); background: #F8FAFC; border: 1.5px solid rgba(11, 15, 25, 0.08); border-radius: 16px; padding: 18px 20px; white-space: pre-line;">
            Đang tải nội dung...
          </div>
        </div>

        <!-- Khung 2: Sơ đồ chân linh kiện (Pinout & Wiring) -->
        <div id="hubPinoutSection" style="margin-bottom: 24px;">
          <div style="font-size: 0.82rem; font-weight: 800; color: #B45309; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            2. Sơ Đồ Chân &amp; Thông Số Kỹ Thuật Phần Cứng (TCPP.02):
          </div>
          <div id="hubPinoutBox" style="background: #FFFBEB; border: 1.5px solid rgba(245, 158, 11, 0.3); border-radius: 16px; padding: 18px 20px;">
            <!-- Render động bằng JS -->
          </div>
        </div>

        <!-- Khung 3: Mã nguồn mẫu & Code Mẫu (FR-04) -->
        <div id="hubCodeSection" style="margin-bottom: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <div style="font-size: 0.82rem; font-weight: 800; color: #047857; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              3. Mã Nguồn Mẫu Chuẩn Cho Thực Hành (FR-04):
            </div>
            <div style="display: flex; gap: 8px;">
              <button type="button" class="btn btn-secondary btn-sm" onclick="copyHubCode()" style="font-size: 0.78rem; padding: 4px 10px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span>Sao chép Code</span>
              </button>
              <button type="button" class="btn btn-playful btn-playful-primary btn-sm" onclick="injectHubCodeToSubmission()" style="font-size: 0.78rem; padding: 4px 12px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                <span>Nạp Vào Khung Nộp Bài</span>
              </button>
            </div>
          </div>
          <div style="border-radius: 16px; overflow: hidden; border: 2px solid var(--c-text-main);">
            <div style="background: #151B28; padding: 8px 16px; display: flex; justify-content: space-between; align-items: center;">
              <span id="hubCodeFilename" style="font-family: monospace; font-size: 0.78rem; color: #94A3B8;">sample.ino</span>
              <span class="tech-chip" style="margin-bottom: 0; background: rgba(56, 189, 248, 0.15); color: #38BDF8; font-size: 0.7rem; padding: 2px 8px;">Code Mẫu Chuẩn</span>
            </div>
            <pre id="hubCodeBox" style="margin: 0; padding: 18px 20px; background: #0B0F19; color: #38BDF8; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.88rem; line-height: 1.6; max-height: 280px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;"></pre>
          </div>
        </div>

        <!-- Khung 4: Tài liệu đính kèm & Tải về (TCPP.01) -->
        <div id="hubFileSection" style="padding-top: 16px; border-top: 1.5px dashed rgba(11, 15, 25, 0.12); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div>
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--c-text-main);">Tài liệu đính kèm phục vụ nghiên cứu:</div>
            <div id="hubFileNotice" style="font-size: 0.8rem; color: var(--c-text-dim);">Được biên soạn bởi TS. Đặng Hùng Vĩ &amp; Bộ môn Sư phạm Tin.</div>
          </div>
          <button type="button" id="btnDownloadHubFile" class="btn btn-outline btn-sm" onclick="downloadHubFile()" style="border-radius: 50px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Tải Tệp Mã Nguồn Mẫu</span>
          </button>
        </div>
      </div>

      <div style="padding: 16px 24px; background: #F8FAFC; border-top: 1px solid rgba(11, 15, 25, 0.08); display: flex; justify-content: flex-end; gap: 10px; border-radius: 0 0 24px 24px; flex-shrink: 0;">
        <button type="button" class="btn btn-secondary" onclick="closeLearningHubModal()">Đóng cửa sổ</button>
        <button type="button" class="btn-playful btn-playful-primary magnet-btn" onclick="injectHubCodeToSubmission()" style="padding: 10px 20px;">
          <span>Luyện Tập Ngay Với Bài Này →</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    const currentStudentId = <%= user.MaNguoiDung %>;
    const serverActiveProjectId = <%= typeof activeProjectId !== 'undefined' && activeProjectId ? JSON.stringify(activeProjectId) : 'null' %>;

    // =========================================================================
    // HỆ THỐNG ĐIỀU HƯỚNG TÁCH TRANG ĐỘC LẬP (Mỗi view là một chức năng riêng biệt)
    // =========================================================================
    const studentViews = {
      'lotrinh': { elId: 'view-lotrinh', title: 'Lộ trình Đào tạo Robotics & Dự Án Thực Hành' },
      'project-workspace': { elId: 'view-project-workspace', title: 'Không Gian Bài Tập & Nộp Bài Chi Tiết' },
      'library': { elId: 'view-library', title: 'Thư Viện Bài Giảng Video & Code Mẫu' },
      'submission': { elId: 'view-submission', title: 'Nộp Bài Thực Hành Đa Phương Tiện' },
      'judge': { elId: 'view-judge', title: 'Khoang Máy Chấm Tự Động & Log Lỗi' },
      'lookup': { elId: 'view-lookup', title: 'Trạm Tra Cứu Linh Kiện & Gỡ Lỗi Nhanh' },
      'history': { elId: 'view-history', title: 'Lịch Sử Nộp Bài & Bảng Điểm' },
      'community-fame': { elId: 'view-community-fame', title: 'Bảng Vinh Danh Dự Án Robotics' },
      'community-forum': { elId: 'view-community-forum', title: 'Diễn Đàn Thảo Luận Kỹ Thuật' }
    };

    function switchView(viewName) {
      if (!studentViews[viewName]) viewName = 'lotrinh';
      const target = studentViews[viewName];

      // 1. Ẩn tất cả các view
      document.querySelectorAll('.dashboard-view').forEach(v => {
        v.classList.remove('active');
        v.style.display = 'none';
      });

      // 2. Hiện view được chọn
      const activeEl = document.getElementById(target.elId);
      if (activeEl) {
        activeEl.style.display = 'block';
        activeEl.classList.add('active');
      }

      // 3. Cập nhật breadcrumb
      const breadcrumb = document.getElementById('pageBreadcrumb');
      if (breadcrumb) {
        breadcrumb.textContent = target.title;
      }

      // 4. Tô sáng (highlight) menu bên trái
      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('data-view') === viewName) {
          link.classList.add('active');
        }
      });
      document.querySelectorAll('.sidebar-sub-link').forEach(subLink => {
        subLink.classList.remove('active');
        if (subLink.getAttribute('data-view') === viewName) {
          subLink.classList.add('active');
        }
      });
      const commDropdown = document.getElementById('studentCommunityDropdown');
      if (commDropdown) {
        const toggleBtn = commDropdown.querySelector('.sidebar-dropdown-toggle');
        if (viewName.startsWith('community-')) {
          commDropdown.classList.add('open');
          if (toggleBtn) toggleBtn.classList.add('active');
        } else {
          if (toggleBtn) toggleBtn.classList.remove('active');
        }
      }

      // 5. Cập nhật hash URL
      if (history.replaceState) {
        history.replaceState(null, null, '#' + viewName);
      }

      // 6. Tải dữ liệu tương ứng nếu cần
      if (viewName === 'library' && typeof loadLibraryLectures === 'function') {
        loadLibraryLectures();
      }
      if (viewName === 'history' && typeof loadMySubmissions === 'function') {
        loadMySubmissions();
      }
      if (viewName === 'lookup' && typeof performLookup === 'function') {
        performLookup();
      }
      if (viewName === 'community-fame' && typeof loadWallOfFame === 'function') {
        loadWallOfFame();
      }
      if (viewName === 'community-forum' && typeof loadCommunityPosts === 'function') {
        loadCommunityPosts();
      }
      if (viewName === 'judge') {
        checkJudgeEngineHealth();
      }

      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    async function checkJudgeEngineHealth() {
      const badge = document.getElementById('judgeLiveBadge');
      const lat = document.getElementById('judgeLatencyText');
      try {
        const res = await fetch('/api/judge/status');
        const data = await res.json();
        if (data.online) {
          if (badge) {
            badge.innerHTML = '<span class="telemetry-pulse"></span> Sẵn sàng (Online)';
            badge.style.background = 'rgba(4, 120, 87, 0.12)';
            badge.style.color = '#047857';
          }
          if (lat) lat.textContent = `${data.latency_ms || 2} ms`;
        } else {
          if (badge) {
            badge.innerHTML = '● Ngoại tuyến (Offline)';
            badge.style.background = 'rgba(220, 38, 38, 0.12)';
            badge.style.color = '#DC2626';
          }
          if (lat) lat.textContent = 'Mất kết nối';
        }
      } catch (e) {
        if (badge) {
          badge.innerHTML = '● Ngoại tuyến';
          badge.style.background = 'rgba(220, 38, 38, 0.12)';
          badge.style.color = '#DC2626';
        }
        if (lat) lat.textContent = 'N/A';
      }
    }

    // =========================================================================
    // THƯ VIỆN BÀI GIẢNG VIDEO & CODE MẪU THỰC HÀNH (LIBRARY)
    // =========================================================================
    const libraryLecturesData = [
      {
        id: 1,
        title: "Giới thiệu Arduino Uno R3 & Pinout 14 Chân I/O",
        topic: "arduino",
        topicLabel: "Arduino & I/O",
        level: "Cơ bản",
        embedUrl: "https://www.youtube-nocookie.com/embed/fJWR73zp1Pc",
        projectId: 1,
        summary: "Kiến trúc vi điều khiển ATmega328P, quản lý 14 chân Digital I/O (D0–D13) và 6 chân Analog (A0–A5). Nguồn cấp 5V DC và giao thức UART nạp code qua cổng USB.",
        hardwareNote: "Arduino Uno R3, Breadboard, LED 5mm, Điện trở 220Ω, Dây cắm đực-đực.",
        hasCode: true,
        codeFilename: "blink_sos.py",
        codeSnippet: `# Code mẫu: Nhấp nháy LED tín hiệu Morse SOS qua vi điều khiển
import sys

# Đọc tín hiệu điều khiển từ cổng kết nối Serial
signal = sys.stdin.read().strip()
if signal == '1' or signal == 'SOS':
    print('LED_ON')
elif signal == '0':
    print('LED_OFF')
else:
    print('LED_ON')`
      },
      {
        id: 2,
        title: "Cảm Biến Siêu Âm HC-SR04 & Thuật Toán Đo Khoảng Cách",
        topic: "sensor",
        topicLabel: "Cảm biến HC-SR04",
        level: "Cơ bản",
        embedUrl: "https://www.youtube-nocookie.com/embed/ZejQOX69K5M",
        projectId: 11,
        summary: "Nguyên lý phát xung Trig 10µs ở tần số 40kHz và nhận xung phản xạ Echo. Công thức quy đổi: Khoảng cách d = (thời gian * 0.034) / 2 = t / 58.0 (cm). Áp dụng bộ lọc trung vị để triệt tiêu sóng dội tạp âm.",
        hardwareNote: "HC-SR04 (VCC: 5V, Trig: D9, Echo: D10, GND), Khoảng cách đo: 2–400cm.",
        hasCode: true,
        codeFilename: "ultrasonic_distance.py",
        codeSnippet: `# Code mẫu: Tính toán khoảng cách từ xung Echo cảm biến HC-SR04
import sys

try:
    microsec = float(sys.stdin.read().strip())
    # Công thức chuẩn: d = t / 58.0 (cm)
    dist_cm = round(microsec / 58.0, 2)
    print(f'{dist_cm:.2f}')
except Exception:
    print('0.00')`
      },
      {
        id: 3,
        title: "Mạch Cầu H L298N & Điều Khiển Xe Tự Hành Né Vật Cản",
        topic: "motor",
        topicLabel: "Cầu H L298N",
        level: "Nâng cao",
        embedUrl: "https://www.youtube-nocookie.com/embed/dyjo_ggnkVU",
        projectId: 13,
        summary: "Điều khiển đảo chiều 2 động cơ DC qua 4 transistor công suất cầu H. Điều chế độ rộng xung PWM (0–255) qua chân ENA/ENB để kiểm soát tốc độ mượt mà khi rẽ góc cua hẹp.",
        hardwareNote: "Cầu H L298N, 2 Động cơ DC giảm tốc TT 1:48, Pin Li-ion 7.4V, Khung gầm 2 bánh.",
        hasCode: true,
        codeFilename: "robot_avoidance.py",
        codeSnippet: `# Code mẫu: Giải thuật né chướng ngại vật theo ngưỡng khoảng cách
import sys

dist = int(sys.stdin.read().strip() or '30')
if dist > 20:
    print('FORWARD')       # Đường thoáng: tiến thẳng
elif dist > 8:
    print('TURN_LEFT')     # Vật cản gần: bẻ cua trái né tránh
else:
    print('BACK_AND_TURN') # Vật cản sát mép: lùi và đổi hướng`
      },
      {
        id: 4,
        title: "Giải Thuật Cân Bằng PID & Cảm Biến Góc Nghiêng MPU6050",
        topic: "pid",
        topicLabel: "PID & MPU6050",
        level: "Nâng cao",
        embedUrl: "https://www.youtube-nocookie.com/embed/4BoIE8YLSQE",
        projectId: 12,
        summary: "Bộ lọc bù Complementary Filter kết hợp Gyroscope (con quay) và Accelerometer (gia tốc kế) MPU6050 qua bus I2C. Thuật toán PID bù mô-men xoắn tức thời để giữ xe 2 bánh thăng bằng trọng tâm.",
        hardwareNote: "Cảm biến MPU-6050 (SDA: A4, SCL: A5), Động cơ bước / DC encoder độ trễ < 5ms.",
        hasCode: true,
        codeFilename: "pid_balance.py",
        codeSnippet: `# Code mẫu: Thuật toán PID tính tốc độ bù góc nghiêng
import sys

parts = sys.stdin.read().strip().split()
if len(parts) >= 2:
    setpoint = float(parts[0])
    current_angle = float(parts[1])
    error = current_angle - setpoint
    if abs(error) < 0.1:
        print('Motor: STOP')
    else:
        pwm = min(255, int(abs(error) * 2.5 + 40))
        direction = 'FORWARD' if error > 0 else 'BACKWARD'
        print(f'Motor: {direction} {pwm}')
else:
    print('Motor: STOP')`
      },
      {
        id: 5,
        title: "Thị Giác Máy Tính AI OpenCV & Kết Nối IoT ESP32",
        topic: "ai",
        topicLabel: "AI & IoT ESP32",
        level: "Chuyên sâu",
        embedUrl: "https://www.youtube-nocookie.com/embed/wqn3IT0T65g",
        projectId: 3,
        summary: "Xử lý ảnh camera trong không gian màu HSV để phân đoạn vật thể theo dải màu sắc (Red, Blue, Green). Gửi tọa độ bounding box qua giao thức MQTT IoT tới vi điều khiển để điều khiển cánh tay gắp thả.",
        hardwareNote: "ESP32-CAM / USB Web Camera, Máy tính mini nhúng hoặc Raspberry Pi, Servo MG996R.",
        hasCode: true,
        codeFilename: "ai_vision_color.py",
        codeSnippet: `# Code mẫu: Phân loại vật thể sa bàn theo mã màu nhận diện
import sys

color = sys.stdin.read().strip().upper()
if color == 'RED':
    print('GRAB_AND_DROP_BIN_A')
elif color == 'BLUE':
    print('GRAB_AND_DROP_BIN_B')
elif color == 'GREEN':
    print('GRAB_AND_DROP_BIN_C')
else:
    print('UNKNOWN_OBJECT')`
      }
    ];

    let currentLibFilter = 'all';

    function loadLibraryLectures() {
      const grid = document.getElementById('libraryLecturesGrid');
      if (!grid) return;
      grid.innerHTML = '';

      const filtered = (currentLibFilter === 'all')
        ? libraryLecturesData
        : libraryLecturesData.filter(l => l.topic === currentLibFilter);

      if (filtered.length === 0) {
        grid.innerHTML = '<p class="text-muted" style="grid-column: 1/-1; padding: 24px 0;">Không tìm thấy bài giảng trong chuyên đề này.</p>';
        return;
      }

      filtered.forEach((lec, idx) => {
        const card = document.createElement('div');
        card.className = 'bento-card bouncy-up visible';
        card.style.cssText = 'display: flex; flex-direction: column; justify-content: space-between; border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary);';

        card.innerHTML = `
          <div>
            <!-- Video YouTube Nhúng Chuẩn Nocookie Xem Trực Tiếp -->
            <div style="background: #000; border-radius: 16px; overflow: hidden; margin-bottom: 16px; position: relative; aspect-ratio: 16/9; border: 1.5px solid rgba(11,15,25,0.15);">
              <iframe width="100%" height="100%" src="${lec.embedUrl}" title="${lec.title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
            </div>

            <!-- Header Thẻ Bài Giảng -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 8px;">
              <span class="tech-chip" style="margin: 0; font-size: 0.75rem; background: rgba(90, 82, 255, 0.12); color: var(--c-primary); font-weight: 800;">
                BÀI #${lec.id} · ${lec.topicLabel}
              </span>
              <span class="badge ${lec.level === 'Cơ bản' ? 'badge-primary' : (lec.level === 'Nâng cao' ? 'badge-warning' : 'badge-danger')}">
                ${lec.level}
              </span>
            </div>

            <h3 style="font-size: 1.25rem; font-weight: 800; line-height: 1.35; margin-bottom: 8px; color: var(--c-text-main);">
              ${lec.title}
            </h3>

            <!-- Tóm Tắt Lý Thuyết & Sơ Đồ -->
            <p style="font-size: 0.88rem; color: var(--c-text-dim); line-height: 1.55; margin-bottom: 14px;">
              ${lec.summary}
            </p>

            <div style="background: #F8FAFC; border: 1px solid rgba(11,15,25,0.08); border-radius: 10px; padding: 10px 12px; margin-bottom: 14px; font-size: 0.8rem;">
              <strong style="color: var(--c-primary);">Sơ đồ phần cứng:</strong> ${lec.hardwareNote}
            </div>

            <!-- Khung Code Mẫu Có Thể Xem Hoặc Thu Gọn -->
            ${lec.hasCode ? `
              <div style="margin-bottom: 14px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleLibCodeBox(${lec.id})" style="font-size: 0.75rem; padding: 4px 10px; font-weight: 700;">
                    <span id="libCodeToggleText-${lec.id}">Hiện Code Mẫu</span>
                  </button>
                  <button type="button" class="btn btn-outline btn-sm" onclick="copySnippetText(${lec.id})" style="font-size: 0.72rem; padding: 2px 8px;">
                    Sao chép Code
                  </button>
                </div>
                <div id="libCodeBox-${lec.id}" style="display: none; background: #0B0F19; border-radius: 10px; padding: 12px; overflow-x: auto;">
                  <div style="font-family: monospace; font-size: 0.72rem; color: #94A3B8; margin-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 4px;">
                    📄 ${lec.codeFilename}
                  </div>
                  <pre id="snippetCode-${lec.id}" style="margin: 0; font-family: 'Consolas', monospace; font-size: 0.82rem; color: #38BDF8; line-height: 1.5; white-space: pre-wrap;">${lec.codeSnippet}</pre>
                </div>
              </div>
            ` : ''}
          </div>

          <!-- Nút Dẫn Sang Bài Tập Thực Hành Tương Ứng -->
          <div style="border-top: 1.5px dashed rgba(11,15,25,0.12); padding-top: 14px; margin-top: 14px;">
            <button type="button" class="btn btn-primary" onclick="openProjectWorkspace(${lec.projectId})" style="width: 100%; justify-content: center; font-weight: 800; font-size: 0.88rem; padding: 10px 14px;">
              Vào Không Gian Bài Tập Thực Hành →
            </button>
          </div>
        `;

        grid.appendChild(card);
      });
    }

    function filterLibraryTopic(cat, btn) {
      currentLibFilter = cat;
      document.querySelectorAll('.lib-filter-btn').forEach(b => {
        b.classList.remove('active');
        b.style.fontWeight = '700';
      });
      if (btn) {
        btn.classList.add('active');
        btn.style.fontWeight = '800';
      }
      loadLibraryLectures();
