    // 2. Xử lý form nộp bài (XLBN.01 & DF-01)
    document.getElementById('submissionForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const btn = document.getElementById('btnSubmit');
      const alertBox = document.getElementById('submitAlert');

      const formData = new FormData(form);

      btn.disabled = true;
      btn.innerHTML = 'Đang biên dịch &amp; chấm TestCase...';
      alertBox.style.display = 'none';

      const consoleBadge = document.getElementById('consoleStatusBadge');
      consoleBadge.className = 'badge badge-warning';
      consoleBadge.textContent = 'Máy chấm đang chạy...';

      document.getElementById('metricScore').textContent = 'Chấm...';
      document.getElementById('metricResult').textContent = 'Đang xử lý';
      document.getElementById('metricStatus').textContent = 'Đang chấm';
      document.getElementById('consoleLog').textContent = 'Đang chuyển mã nguồn tới Judge Engine (cổng 5000) và đối chiếu bộ TestCase...';

      try {
        const res = await fetch('/api/submissions', {
          method: 'POST',
          headers: { 'x-user-id': currentStudentId },
          body: formData
        });
        const result = await res.json();

        alertBox.style.display = 'block';

        if (result.success) {
          alertBox.style.background = result.passedAll ? 'var(--c-success-bg)' : 'var(--c-warning-bg)';
          alertBox.style.color = result.passedAll ? '#047857' : '#B45309';
          alertBox.style.border = '1px solid ' + (result.passedAll ? 'rgba(16, 185, 129, 0.3)' : 'rgba(255, 184, 0, 0.3)');
          alertBox.innerHTML = `<strong>${result.message}</strong>`;

          document.getElementById('metricScore').textContent = (result.diemCode !== undefined ? result.diemCode : '--') + ' / 10';
          document.getElementById('metricResult').textContent = result.ketQuaCode || (result.passedAll ? 'Đạt' : 'Không đạt');
          document.getElementById('metricStatus').textContent = result.trangThai || 'Đã chấm';

          if (result.passedAll) {
            consoleBadge.className = 'badge badge-success';
            consoleBadge.textContent = 'Đạt 100% TestCase (DF-01)';
          } else {
            consoleBadge.className = 'badge badge-danger';
            consoleBadge.textContent = 'Chưa đạt TestCase';
          }

          document.getElementById('consoleLog').textContent = result.logLoi || 'Biên dịch hoàn tất. Không có log lỗi cú pháp.';

          loadLoTrinhAndProjects();
          loadMySubmissions();

          // Chuyển sang Khoang máy chấm hiển thị kết quả & Telemetry log
          setTimeout(() => {
            switchView('judge');
            if (window.showToast) {
              window.showToast(result.passedAll ? 'Mã nguồn đạt 100% TestCase!' : 'Chưa đạt TestCase, hãy xem chi tiết Log lỗi.', result.passedAll ? 'success' : 'warning');
            }
          }, 500);
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
