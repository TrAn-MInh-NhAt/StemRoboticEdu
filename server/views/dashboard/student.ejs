    async function loadCommunityPosts() {
      try {
        const res = await fetch('/api/community/posts');
        const data = await res.json();
        if (!data.success) return;

        allCommunityPosts = data.posts;
        renderCommunityPosts();
      } catch (err) {
        console.error('Lỗi loadCommunityPosts:', err);
      }
    }

    function renderCommunityPosts() {
      const container = document.getElementById('postsContainer');
      if (!container) return;
      container.innerHTML = '';

      let filtered = allCommunityPosts;
      if (currentCommunityFilter === 'trending') {
        filtered = allCommunityPosts.filter(p => p.isTopTrending);
      } else if (currentCommunityFilter !== 'all') {
        filtered = allCommunityPosts.filter(p => p.LoaiNoiDung === currentCommunityFilter);
      }

      if (filtered.length === 0) {
        container.innerHTML = '<p class="text-muted" style="padding: 24px 0;">Không có bài thảo luận nào trong mục này.</p>';
        return;
      }

      filtered.forEach(p => {
        const postCard = document.createElement('div');
        postCard.className = 'card' + (p.isTopTrending ? ' b-card-highlight' : '');
        postCard.style.cssText = 'padding: 20px 24px; margin-bottom: 16px; border: 1px solid rgba(11,15,25,0.06);';

        postCard.innerHTML = `
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 8px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                <span class="tech-chip" style="font-size: 0.72rem; padding: 2px 10px;">${p.LoaiNoiDung}</span>
                ${p.isTopTrending ? '<span class="badge badge-warning" style="font-weight: 800;">TOP TRENDING (DF-03)</span>' : ''}
                ${p.TenDuAn ? `<span class="text-muted" style="font-size: 0.78rem;">Dự án: ${p.TenDuAn}</span>` : ''}
              </div>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--c-text-main); margin-bottom: 6px;">${p.TieuDe}</h3>
              <p style="font-size: 0.92rem; color: var(--c-text-dim); line-height: 1.5; white-space: pre-line;">${p.NoiDung}</p>
            </div>
            <button class="btn btn-secondary btn-sm" onclick="voteCommunityPost(${p.MaThaoLuan}, this)" style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
              <span>${p.LuotThich || 0}</span>
            </button>
          </div>
          <div style="font-size: 0.78rem; color: var(--c-text-dim); border-top: 1px dashed rgba(11,15,25,0.08); padding-top: 10px; margin-top: 12px; display: flex; justify-content: space-between;">
            <span>Đăng bởi: <strong>${p.TenTacGia}</strong> (${p.VaiTro})</span>
            <span>${new Date(p.NgayTao).toLocaleDateString('vi-VN')}</span>
          </div>
        `;
        container.appendChild(postCard);
      });
    }

    function filterCommunityPosts(filter, btn) {
      currentCommunityFilter = filter;
      document.querySelectorAll('#view-community-forum [data-filter]').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      renderCommunityPosts();
    }

    async function voteCommunityPost(postId, btn) {
      try {
        btn.disabled = true;
        const res = await fetch(`/api/community/posts/${postId}/vote`, { method: 'POST' });
        const result = await res.json();
        if (result.success) {
          const span = btn.querySelector('span');
          if (span) span.textContent = result.votes;
          if (typeof showToast === 'function') showToast('Cảm ơn bạn đã bình chọn hữu ích!');
        }
      } catch (err) {
        console.error('Lỗi vote:', err);
      } finally {
        btn.disabled = false;
      }
    }

    function openNewCommunityPostModal() {
      const modal = document.getElementById('communityPostModal');
      if (modal) {
        modal.classList.add('active');
        loadCommunityProjectsSelect();
      }
    }

    function closeNewCommunityPostModal() {
      const modal = document.getElementById('communityPostModal');
      if (modal) modal.classList.remove('active');
    }

    async function loadCommunityProjectsSelect() {
      const sel = document.getElementById('communityPostProject');
      if (!sel || sel.options.length > 1) return;
      try {
        const res = await fetch('/api/projects');
        const data = await res.json();
        if (data.success && data.projects) {
          data.projects.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.MaDuAn;
            opt.textContent = `${p.TenDuAn} (${p.CapDo || 'Cơ bản'})`;
            sel.appendChild(opt);
          });
        }
      } catch (e) {
        console.error(e);
      }
    }

    // Xử lý gửi bài viết thảo luận mới
    const commPostForm = document.getElementById('newCommunityPostForm');
    if (commPostForm) {
      commPostForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const alertBox = document.getElementById('communityPostAlert');
        const submitBtn = document.getElementById('btnSubmitCommunityPost');
        alertBox.style.display = 'none';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Đang đăng...';

        const body = {
          tieuDe: document.getElementById('communityPostTitle').value.trim(),
          loaiNoiDung: document.getElementById('communityPostCategory').value,
          maDuAn: document.getElementById('communityPostProject').value || null,
          noiDung: document.getElementById('communityPostContent').value.trim()
        };

        try {
          const res = await fetch('/api/community/posts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
          const result = await res.json();
          if (result.success) {
            closeNewCommunityPostModal();
            commPostForm.reset();
            if (typeof showToast === 'function') showToast('Đăng bài thảo luận thành công!');
            switchView('community-forum');
            loadCommunityPosts();
          } else {
            alertBox.style.display = 'block';
            alertBox.style.background = '#FFF5F5';
            alertBox.style.color = '#991B1B';
            alertBox.textContent = result.message || 'Lỗi khi đăng bài.';
          }
        } catch (err) {
          alertBox.style.display = 'block';
          alertBox.style.background = '#FFF5F5';
          alertBox.style.color = '#991B1B';
          alertBox.textContent = 'Lỗi kết nối máy chủ.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Đăng bài viết';
        }
      });
    }

