    function loadWsSampleCode(isPass) {
      if (!currentWsProjectData) return;
      const pid = currentWsProjectData.MaDuAn;
      const editor = document.getElementById('wsCodeEditor');
      const filenameLabel = document.getElementById('wsEditorFilename');
      const sample = wsProjectSampleCodes[pid] || wsProjectSampleCodes[1];

      if (isPass) {
        editor.value = sample.pass;
        filenameLabel.textContent = `solution_project_${pid}.py`;
        if (typeof showToast === 'function') showToast('Đã nạp mã nguồn mẫu chuẩn đạt 100% TestCase!');
      } else {
        editor.value = sample.fail;
        filenameLabel.textContent = `solution_error_test_${pid}.py`;
        if (typeof showToast === 'function') showToast('Đã nạp mã nguồn lỗi để thử nghiệm máy chấm bắt lỗi (DF-04)!', 'warning');
      }
      updateWsEditorStats();
    }

    function clearWsCode() {
      const editor = document.getElementById('wsCodeEditor');
      if (editor) {
        editor.value = '';
        updateWsEditorStats();
      }
    }

    function updateWsEditorStats() {
      const editor = document.getElementById('wsCodeEditor');
      const stats = document.getElementById('wsEditorStats');
      if (!editor || !stats) return;
      const text = editor.value || '';
      const lines = text ? text.split('\n').length : 0;
      stats.textContent = `${lines} dòng · ${text.length} ký tự`;
    }

    function onWsFileSelected(input) {
      if (!input.files || input.files.length === 0) return;
      const file = input.files[0];
      const filenameLabel = document.getElementById('wsEditorFilename');
      if (filenameLabel) filenameLabel.textContent = file.name;

      const reader = new FileReader();
      reader.onload = function(e) {
        const editor = document.getElementById('wsCodeEditor');
        if (editor) {
          editor.value = e.target.result;
          updateWsEditorStats();
        }
        if (typeof showToast === 'function') showToast(`Đã tải tệp ${file.name} từ máy tính vào trình soạn thảo!`);
      };
      reader.readAsText(file);
    }

