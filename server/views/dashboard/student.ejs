    function closeLogModal() {
      document.getElementById('logModal').classList.remove('active');
      setTimeout(() => { document.getElementById('logModal').style.display = 'none'; }, 200);
    }

    // ==============================================================================
    // 4. TRẠM TRA CỨU LINH KIỆN & BẮT LỖI CODE (TCPP.02 / PHÂN HỆ 2)
    // ==============================================================================
    let currentLookupCategory = 'all';
    let lookupDebounceTimer = null;
    let cachedLookupData = { materials: [], errorGuides: [] };

    function debounce(func, wait) {
      let timeout;
      return function(...args) {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, args), wait);
      };
    }

    async function performLookup(forceReset = false) {
      const kwInput = document.getElementById('lookupKeyword');
      if (forceReset && kwInput) kwInput.value = '';
      const kw = kwInput ? kwInput.value.trim() : '';
      const container = document.getElementById('lookupResultsContainer');

      try {
        const res = await fetch(`/api/materials/lookup?q=${encodeURIComponent(kw)}`);
        const data = await res.json();

        if (!data.success) {
          container.innerHTML = `<div class="alert alert-danger" style="margin:20px;">Lỗi tra cứu: ${data.message}</div>`;
          return;
        }

        cachedLookupData = {
          materials: data.materials || [],
          errorGuides: data.errorGuides || []
        };

        renderLookupResults();
      } catch (err) {
        container.innerHTML = `<div class="alert alert-danger" style="margin:20px;">Lỗi kết nối máy chủ: ${err.message}</div>`;
      }
    }

    function renderLookupResults() {
      const container = document.getElementById('lookupResultsContainer');
      const { materials, errorGuides } = cachedLookupData;

      // Lọc theo Category
      let showMaterials = (currentLookupCategory === 'all' || currentLookupCategory === 'hardware' || currentLookupCategory === 'code');
      let showErrors = (currentLookupCategory === 'all' || currentLookupCategory === 'error');

      let filteredMaterials = materials;
      if (currentLookupCategory === 'hardware') {
        filteredMaterials = materials.filter(m => m.LoaiHocLieu === 'Linh kiện');
      } else if (currentLookupCategory === 'code') {
        filteredMaterials = materials.filter(m => m.LoaiHocLieu === 'Code mẫu' || m.LoaiHocLieu === 'Bài giảng');
      }

      let filteredErrors = showErrors ? errorGuides : [];

      if ((!showMaterials || filteredMaterials.length === 0) && (!showErrors || filteredErrors.length === 0)) {
        container.innerHTML = `
          <div style="text-align: center; padding: 48px 20px; color: var(--c-text-dim);">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 12px; opacity: 0.6;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <h4 style="font-weight: 800; font-size: 1.15rem; color: var(--c-text-main);">Không tìm thấy kết quả phù hợp</h4>
            <p style="font-size: 0.9rem; margin-top: 6px;">Hãy thử tìm từ khóa khác như "Arduino", "HC-SR04", "L298N", "PID", hoặc "LED".</p>
          </div>
        `;
        return;
      }

      let html = '';

      // 1. Phân vùng Linh Kiện & Học Liệu
      if (showMaterials && filteredMaterials.length > 0) {
        html += `
          <div style="margin-bottom: 32px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
              <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--c-primary); display: flex; align-items: center; gap: 8px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>
                Linh Kiện Phần Cứng &amp; Học Liệu Kỹ Thuật (${filteredMaterials.length})
              </h3>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
        `;

        filteredMaterials.forEach(m => {
          let badgeColor = 'badge-primary';
          if (m.LoaiHocLieu === 'Linh kiện') badgeColor = 'badge-warning';
          if (m.LoaiHocLieu === 'Code mẫu') badgeColor = 'badge-success';

          html += `
            <div class="bento-card" style="border: 1.5px solid rgba(11, 15, 25, 0.08); display: flex; flex-direction: column; justify-content: space-between; padding: 22px; transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                  <span class="badge ${badgeColor}">${m.LoaiHocLieu}</span>
                  <span style="font-size: 0.78rem; font-weight: 700; color: var(--c-text-dim);">${m.TenLoTrinh || 'Hệ thống'}</span>
                </div>
                <h4 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 10px; color: var(--c-text-main);">${m.TenHocLieu}</h4>
                <div style="font-size: 0.88rem; color: var(--c-text-dim); line-height: 1.6; white-space: pre-line; margin-bottom: 16px;">
                  ${m.NoiDung}
                </div>
              </div>
              <div style="border-top: 1px dashed rgba(11, 15, 25, 0.1); padding-top: 12px; margin-top: auto; display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 0.78rem; color: var(--c-text-dim);">Tác giả: <strong>${m.TenTacGia || 'Giảng viên STEM'}</strong></span>
                ${m.DuongDanTep ? `
                  <a href="${m.DuongDanTep}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm" style="font-size: 0.78rem; padding: 6px 12px;">
                    Xem Datasheet ↗
                  </a>
                ` : ''}
              </div>
            </div>
          `;
        });

        html += `</div></div>`;
      }

      // 2. Phân vùng Gợi Ý Sửa Lỗi TestCase
      if (showErrors && filteredErrors.length > 0) {
        html += `
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
              <h3 style="font-size: 1.15rem; font-weight: 800; color: #DC2626; display: flex; align-items: center; gap: 8px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Cẩm Nang Bắt Lỗi &amp; Gợi Ý Sửa Code TestCase (${filteredErrors.length})
              </h3>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px;">
        `;

        filteredErrors.forEach(tc => {
          html += `
            <div class="bento-card" style="border: 2px solid rgba(220, 38, 38, 0.2); background: #FFFBFB; padding: 22px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span class="tech-chip" style="background: rgba(220, 38, 38, 0.1); color: #DC2626; font-weight: 700; margin-bottom:0;">
                  Dự án: ${tc.TenDuAn}
                </span>
                <span class="badge badge-locked">${tc.CapDo || 'Cơ bản'}</span>
              </div>

              <!-- Hộp so sánh Input -> Expected Output -->
              <div style="background: #0B0F19; border-radius: 12px; padding: 12px 14px; font-family: monospace; font-size: 0.82rem; margin-bottom: 14px; color: #F4F6F8;">
                <div style="color: #94A3B8; margin-bottom: 4px;">Dữ liệu đầu vào: <span style="color: #FFB800;">${tc.DuLieuDauVao || '(Không)'}</span></div>
                <div style="color: #94A3B8;">Kết quả chuẩn (Expected): <span style="color: #38BDF8;">${tc.KetQuaDauRa}</span></div>
              </div>

              <!-- Hướng dẫn & Giải pháp -->
              <div>
                <div style="font-weight: 800; font-size: 0.85rem; color: #991B1B; text-transform: uppercase; margin-bottom: 6px;">
                  Giải pháp khắc phục lỗi code:
                </div>
                <div style="font-size: 0.88rem; color: var(--c-text-main); line-height: 1.55; background: #FFFFFF; border: 1px solid rgba(220, 38, 38, 0.2); padding: 12px; border-radius: 10px;">
                  ${tc.GoiYSuaLoi}
                </div>
              </div>
            </div>
          `;
        });

        html += `</div></div>`;
      }

      container.innerHTML = html;
    }

    function filterLookupCategory(cat, btn) {
      currentLookupCategory = cat;
      document.querySelectorAll('.lookup-filter-btn').forEach(b => {
        b.className = 'btn btn-secondary btn-sm lookup-filter-btn';
      });
      btn.className = 'btn btn-primary btn-sm lookup-filter-btn';
      renderLookupResults();
    }

    // Gắn debounce tìm kiếm khi gõ
    const lookupInputEl = document.getElementById('lookupKeyword');
    if (lookupInputEl) {
      lookupInputEl.addEventListener('input', debounce(() => {
        performLookup();
      }, 350));
    }

    // ==============================================================================
    // 5. BÁO CÁO SỰ CỐ (HTTB.01) & THÔNG BÁO HỆ THỐNG (HTTB.02)
    // ==============================================================================
    function openReportIssueModal() {
      const modal = document.getElementById('reportIssueModal');
      modal.style.display = 'flex';
      setTimeout(() => { modal.classList.add('active'); }, 10);
    }

    function closeReportIssueModal() {
      const modal = document.getElementById('reportIssueModal');
      modal.classList.remove('active');
      setTimeout(() => { modal.style.display = 'none'; }, 200);
    }

    document.getElementById('reportIssueForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnSubmitIssue');
      const alertBox = document.getElementById('reportIssueAlert');

      btn.disabled = true;
      btn.textContent = 'Đang gửi phiếu sự cố...';
      alertBox.style.display = 'none';

      const payload = {
        tieuDe: document.getElementById('issueTitle').value.trim(),
        mucDoUuTien: document.getElementById('issuePriority').value,
        noiDung: document.getElementById('issueContent').value.trim()
      };

      try {
        const res = await fetch('/api/support/report-issue', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        alertBox.style.display = 'block';
        if (result.success) {
          alertBox.style.background = 'var(--c-success-bg)';
          alertBox.style.color = '#047857';
          alertBox.style.border = '1.5px solid rgba(16, 185, 129, 0.3)';
          alertBox.innerHTML = `<strong>Thành công:</strong> ${result.message}`;
          document.getElementById('reportIssueForm').reset();
          setTimeout(() => {
            closeReportIssueModal();
          }, 2000);
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1.5px solid rgba(239, 68, 68, 0.3)';
          alertBox.innerHTML = `<strong>Lỗi:</strong> ${result.message}`;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Gửi Báo Cáo Sự Cố (HTTB.01)';
      }
    });

    // Tự động tải thông báo hệ thống đang hoạt động (HTTB.02)
    async function loadSystemBroadcasts() {
      const container = document.getElementById('systemBroadcastContainer');
      if (!container) return;

      try {
        const res = await fetch('/api/support/active-notifications');
        const data = await res.json();

        if (!data.success || !data.notifications || data.notifications.length === 0) {
          container.innerHTML = '';
          return;
        }

        let html = '';
        data.notifications.forEach(n => {
          const isUrgent = (n.MucDoUuTien === 'Khẩn cấp');

          if (isUrgent) {
            html += `
              <div class="bento-card" style="background: #FFF5F5; border: 2px solid var(--c-secondary); box-shadow: 4px 4px 0 var(--c-secondary); padding: 18px 24px; position: relative; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                  <div style="display: flex; gap: 14px; align-items: flex-start;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #FEE2E2; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #DC2626;">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                    <div>
                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                        <span class="badge badge-danger" style="animation: pulse-core 2s infinite;">THÔNG BÁO KHẨN CẤP (HTTB.02)</span>
                        <span style="font-size: 0.78rem; color: #991B1B; font-weight: 600;">Phát lúc: ${n.NgayTaoFmt || n.NgayTao} · Bởi: ${n.NguoiGui || 'Ban Quản Trị'}</span>
                      </div>
                      <h3 style="font-size: 1.15rem; font-weight: 800; color: #991B1B; margin-bottom: 6px;">${n.TieuDe}</h3>
                      <p style="font-size: 0.92rem; color: #7F1D1D; line-height: 1.55; margin-bottom: 0;">${n.NoiDung}</p>
                    </div>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="this.closest('.bento-card').remove()" style="color: #991B1B; border-color: rgba(220, 38, 38, 0.3);">Đã hiểu &times;</button>
                </div>
              </div>
            `;
          } else {
            html += `
              <div class="bento-card" style="background: #F0FDF4; border: 1.5px solid rgba(16, 185, 129, 0.4); box-shadow: 3px 3px 0 rgba(16, 185, 129, 0.3); padding: 16px 20px; position: relative; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                  <div style="display: flex; gap: 12px; align-items: flex-start;">
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #DCFCE7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #047857;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </div>
                    <div>
                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px;">
                        <span class="badge badge-success">THÔNG BÁO HỆ THỐNG</span>
                        <span style="font-size: 0.78rem; color: #065F46;">${n.NgayTaoFmt || n.NgayTao}</span>
                      </div>
                      <h4 style="font-size: 1.05rem; font-weight: 800; color: #065F46; margin-bottom: 4px;">${n.TieuDe}</h4>
                      <p style="font-size: 0.88rem; color: #064E3B; line-height: 1.5; margin-bottom: 0;">${n.NoiDung}</p>
                    </div>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="this.closest('.bento-card').remove()" style="color: #065F46; border-color: rgba(16, 185, 129, 0.3);">Đóng</button>
                </div>
              </div>
            `;
          }
        });

        container.innerHTML = html;
      } catch (e) {
        console.error('Lỗi loadSystemBroadcasts:', e);
      }
    }

    // Đồng bộ view theo hash URL hoặc tham số ?view= (hỗ trợ back/forward trình duyệt và link trực tiếp)
    function syncViewFromHash() {
      const urlParams = new URLSearchParams(window.location.search);
      const queryView = urlParams.get('view') || urlParams.get('tab');
      const hash = (window.location.hash || '').replace('#', '');
      const targetView = queryView || hash;
      if (targetView && studentViews[targetView]) {
        switchView(targetView);
      } else {
        switchView('lotrinh');
      }
    }

    window.addEventListener('hashchange', syncViewFromHash);

    // Khởi chạy khi vào trang
    syncViewFromHash();
    loadLoTrinhAndProjects();
    loadMySubmissions();
    performLookup();
    loadSystemBroadcasts();
  </script>
  <script src="/js/theme-engine.js"></script>
</body>
</html>
