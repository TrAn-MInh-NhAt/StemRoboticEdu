      document.getElementById('modalStatus').textContent = sub.TrangThai;
      document.getElementById('modalLogContent').textContent = sub.LogLoi || 'Không ghi nhận lỗi. Code biên dịch sạch 100%.';
      document.getElementById('modalTeacherFeedback').textContent = sub.NhanXet || 'Chưa có nhận xét từ Giáo viên.';
      document.getElementById('logModal').style.display = 'flex';
      setTimeout(() => { document.getElementById('logModal').classList.add('active'); }, 10);
