            </td>
            <td>${sub.KetQuaVideo || '<span class="text-muted">Chờ duyệt</span>'}</td>
            <td><strong style="font-size:1.1rem; color:${sub.TongDiem >= 8 ? '#047857' : (sub.TongDiem >= 5 ? '#B45309' : '#DC2626')};">${sub.TongDiem !== null ? sub.TongDiem + ' / 10' : '--'}</strong></td>
            <td><span class="badge ${statusBadgeClass}">${sub.TrangThai}</span></td>
