            chip.innerHTML = `<span style="color: ${tagColor}; font-weight: 800;">[${m.LoaiHocLieu}]</span> <span>${m.TenHocLieu}</span> <span style="color: var(--c-primary); font-size: 0.75rem;">↗</span>`;
