    function toggleLibCodeBox(id) {
      const box = document.getElementById(`libCodeBox-${id}`);
      const txt = document.getElementById(`libCodeToggleText-${id}`);
      if (!box || !txt) return;
      if (box.style.display === 'none') {
        box.style.display = 'block';
        txt.textContent = 'Thu Gọn Code';
      } else {
        box.style.display = 'none';
        txt.textContent = 'Hiện Code Mẫu';
      }
    }

    function copySnippetText(id) {
      const pre = document.getElementById(`snippetCode-${id}`);
      if (!pre) return;
      navigator.clipboard.writeText(pre.textContent).then(() => {
        if (typeof showToast === 'function') {
          showToast('Đã sao chép mã nguồn mẫu vào bộ nhớ tạm!', 'success');
        }
      });
    }

