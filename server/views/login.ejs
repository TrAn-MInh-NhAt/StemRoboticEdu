<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cổng Đăng Nhập &amp; Đăng Ký — STEM Robotic Edu</title>
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body style="display: flex; flex-direction: column; min-height: 100vh;">
  <!-- Nền Blobs lơ lửng -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>

  <!-- Thanh Topbar điều hướng về Trang chủ -->
  <header style="padding: 20px 24px;">
    <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--c-text-main);">
        <div style="width: 36px; height: 36px; background: var(--c-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #FFF; box-shadow: 2px 2px 0 var(--c-text-main);">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="#FFF" fill="none" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <span style="font-family: var(--f-heading); font-weight: 800; font-size: 1.15rem;">STEM Robotic</span>
      </a>
      <a href="/" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Về Trang Chủ</span>
      </a>
    </div>
  </header>

  <main style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <div class="bento-card bouncy-up visible" style="width: 100%; max-width: 520px; padding: 36px 32px; border: 2px solid var(--c-text-main); box-shadow: 6px 6px 0 var(--c-primary);">
      
      <!-- Bộ Chuyển Tab Đăng Nhập / Đăng Ký Thẻ Học Sinh -->
      <div style="display: flex; background: #EEF2F6; padding: 4px; border-radius: 50px; margin-bottom: 28px; border: 1.5px solid rgba(11,15,25,0.08);">
        <button type="button" id="tabBtnLogin" onclick="switchAuthTab('login')" style="flex: 1; padding: 10px 16px; border-radius: 50px; border: none; font-weight: 800; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; background: var(--c-text-main); color: #FFF; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
          Đăng Nhập
        </button>
        <button type="button" id="tabBtnRegister" onclick="switchAuthTab('register')" style="flex: 1; padding: 10px 16px; border-radius: 50px; border: none; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; background: transparent; color: var(--c-text-dim);">
          Đăng Ký &amp; Quét Thẻ
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: FORM ĐĂNG NHẬP                       -->
      <!-- ========================================== -->
      <div id="authLoginPanel">
        <div style="text-align: center; margin-bottom: 24px;">
          <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: #3730A3; font-weight: 700; margin-bottom: 8px; display: inline-block;">Cổng Đăng Nhập Học Viện</span>
          <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 6px;">
            Đăng <span class="title-highlight">Nhập</span>
          </h1>
          <p style="font-size: 0.9rem; color: var(--c-text-dim); text-wrap: pretty;">
            Học tập, nộp bài thực hành và quản trị đào tạo STEM Robotic.
          </p>
        </div>

        <form id="loginForm">
          <div class="form-group">
            <label class="form-label" for="email">Địa chỉ Email</label>
            <input type="email" id="email" name="email" class="form-control"
                   placeholder="hs.minhnhat@stemrobotic.edu.vn"
                   required autocomplete="email">
          </div>

          <div class="form-group" style="margin-bottom: 8px;">
            <label class="form-label" for="password">Mật khẩu</label>
            <input type="password" id="password" name="password" class="form-control"
                   placeholder="••••••"
                   required autocomplete="current-password">
          </div>

          <div style="display: flex; justify-content: flex-end; margin-bottom: 16px;">
            <button type="button" id="btnOpenForgotModal" style="background: none; border: none; color: var(--c-primary); font-size: 0.85rem; font-weight: 700; cursor: pointer; text-decoration: underline; font-family: var(--f-body); padding: 0;">
              Quên mật khẩu?
            </button>
          </div>

          <div id="errorMsg" class="alert alert-danger" style="display:none; margin-bottom: 16px; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 0.88rem; background: var(--c-error-bg); color: var(--c-error); border: 1px solid rgba(239, 68, 68, 0.3);"></div>

          <button type="submit" class="btn-playful btn-playful-primary magnet-btn" id="btnLogin" style="width: 100%; padding: 14px; font-size: 1.05rem;">
            <span>Đăng Nhập Hệ Thống</span>
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>

        <!-- Danh sách tài khoản demo bấm 1 chạm tiện lợi (Đã cập nhật theo yêu cầu người dùng) -->
        <div style="margin-top: 28px; padding-top: 18px; border-top: 1.5px dashed rgba(11, 15, 25, 0.12);">
          <div style="font-size: 0.78rem; font-weight: 700; color: var(--c-text-dim); text-transform: uppercase; margin-bottom: 10px; letter-spacing: 0.05em; text-align: center;">
            Tài khoản mẫu thử nghiệm (Bấm để điền):
          </div>
          <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center;">
            <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('admin@stemrobotic.edu.vn', '123456')">
              Admin
            </button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('gv.hungvi@stemrobotic.edu.vn', '123456')">
              Thầy Hùng Vĩ (GVCN)
            </button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('hs.minhnhat@stemrobotic.edu.vn', '123456')">
              Minh Nhật (10/1)
            </button>
            <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('hs.kyhai@stemrobotic.edu.vn', '123456')">
              Kỳ Hải (10/1)
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: FORM ĐĂNG KÝ & XÁC THỰC THẺ HỌC SINH -->
      <!-- ========================================== -->
      <div id="authRegisterPanel" style="display: none;">
        <div style="text-align: center; margin-bottom: 20px;">
          <span class="tech-chip" style="background: rgba(4, 120, 87, 0.12); color: #047857; font-weight: 700; margin-bottom: 8px; display: inline-block;">Đăng Ký &amp; Quét Thẻ Thông Minh</span>
          <h2 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 4px;">
            Gia Nhập <span class="title-highlight">Lớp 10/1</span>
          </h2>
          <p style="font-size: 0.88rem; color: var(--c-text-dim); text-wrap: pretty;">
            Hệ thống hỗ trợ quét nhận diện thẻ học sinh tự động bằng AI OCR để vào lớp học ngay.
          </p>
        </div>

        <form id="registerForm" onsubmit="handleRegisterSubmit(event)">
          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label" for="regHoTen">Họ và tên học sinh *</label>
            <input type="text" id="regHoTen" name="hoTen" class="form-control" placeholder="Ví dụ: Lê Quốc Bảo" required>
          </div>

          <div class="form-group" style="margin-bottom: 12px;">
            <label class="form-label" for="regEmail">Địa chỉ Email *</label>
            <input type="email" id="regEmail" name="email" class="form-control" placeholder="hs.quocbao@stemrobotic.edu.vn" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="regPass">Mật khẩu *</label>
              <input type="password" id="regPass" name="matKhau" class="form-control" placeholder="Tối thiểu 6 ký tự" required minlength="6">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="regClass">Lớp học</label>
              <select id="regClass" name="lop" class="form-control" style="font-weight: 700;">
                <option value="10/1" selected>Lớp 10/1 (Thầy Hùng Vĩ CN)</option>
                <option value="10/2">Lớp 10/2</option>
                <option value="11/1">Lớp 11/1</option>
              </select>
            </div>
          </div>

          <!-- Khung Tải & Xác Thực Thẻ Học Sinh -->
          <div style="background: rgba(90, 82, 255, 0.04); border: 1.5px dashed rgba(90, 82, 255, 0.3); border-radius: 16px; padding: 14px; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <label class="form-label" style="margin-bottom: 0; font-size: 0.86rem; font-weight: 800; color: var(--c-primary); display: flex; align-items: center; gap: 6px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><line x1="15" y1="8" x2="17" y2="8"/><line x1="15" y1="12" x2="17" y2="12"/></svg>
                Ảnh Thẻ Học Sinh Cấp Trung Học *
              </label>
              <button type="button" class="btn btn-outline btn-sm" onclick="fillSampleCard()" style="font-size: 0.72rem; padding: 2px 8px;">
                Dùng ảnh thẻ mẫu
              </button>
            </div>

            <div style="display: flex; gap: 12px; align-items: center;">
              <div id="cardPreviewBox" style="width: 80px; height: 55px; border-radius: 8px; background: #E2E8F0; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid rgba(11,15,25,0.1);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/></svg>
              </div>
              <div style="flex: 1;">
                <input type="text" id="regCardUrl" name="anhTheHocSinh" class="form-control" placeholder="https://... hoặc chọn ảnh mẫu" value="/images/cards/the_hoc_sinh_chuyen_stem.jpg" style="font-size: 0.8rem; padding: 6px 10px;">
                <div style="font-size: 0.75rem; color: var(--c-text-dim); margin-top: 3px;">
                  Ảnh thẻ chụp rõ mặt, Họ tên và Niên khóa THPT Chuyên STEM.
                </div>
              </div>
            </div>

            <!-- Mô phỏng Chế độ Quét Thẻ AI OCR -->
            <div style="margin-top: 10px; border-top: 1px dashed rgba(90,82,255,0.2); padding-top: 8px;">
              <div style="font-size: 0.78rem; font-weight: 700; color: var(--c-text-main); margin-bottom: 4px;">
                Chế độ mô phỏng quét thẻ AI OCR:
              </div>
              <div style="display: flex; gap: 8px;">
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.78rem; cursor: pointer;">
                  <input type="radio" name="autoVerifyCard" value="true" checked>
                  <span>Thẻ rõ nét (Tự động duyệt ngay)</span>
                </label>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.78rem; cursor: pointer;">
                  <input type="radio" name="autoVerifyCard" value="false">
                  <span>Thẻ mờ (Gửi GVCN duyệt)</span>
                </label>
              </div>
            </div>
          </div>

          <div id="regAlertBox" style="display: none; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 14px;"></div>

          <button type="submit" id="btnRegisterSubmit" class="btn-playful btn-playful-primary magnet-btn" style="width: 100%; padding: 12px; font-size: 1rem;">
            <span>Đăng Ký &amp; Xác Thực Thẻ Học Sinh</span>
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
      </div>

    </div>
  </main>

  <!-- MODAL KHÔI PHỤC MẬT KHẨU -->
  <div id="forgotModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(11, 15, 25, 0.6); backdrop-filter: blur(8px); z-index: 999; align-items: center; justify-content: center; padding: 20px;">
    <div class="bento-card" style="max-width: 480px; width: 100%; border: 2px solid var(--c-text-main); box-shadow: 6px 6px 0 var(--c-primary); background: #FFFFFF; padding: 32px; border-radius: 24px; position: relative;">
      
      <button type="button" id="btnCloseForgotModal" style="position: absolute; top: 20px; right: 20px; background: none; border: none; font-size: 1.4rem; cursor: pointer; color: var(--c-text-dim); line-height: 1;">✕</button>

      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
        <div class="b-icon-box" style="width: 44px; height: 44px; margin-bottom: 0; background: rgba(90, 82, 255, 0.1); color: var(--c-primary);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">Khôi Phục Mật Khẩu</h3>
          <p style="font-size: 0.8rem; color: var(--c-text-dim); margin: 0;">Xác thực mã OTP 6 số để đặt lại mật khẩu</p>
        </div>
      </div>

      <!-- BƯỚC 1: NHẬP EMAIL ĐỂ NHẬN MÃ OTP -->
      <div id="stepForgotEmail">
        <div id="forgotAlert" style="display: none; margin-bottom: 14px; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600;"></div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label class="form-label" for="forgotEmail">Nhập địa chỉ Email đăng ký của bạn</label>
          <input type="email" id="forgotEmail" class="form-control" placeholder="hs.minhnhat@stemrobotic.edu.vn" required>
          <small style="color: var(--c-text-dim); font-size: 0.78rem; display: block; margin-top: 4px;">Hệ thống sẽ kiểm tra tài khoản và khởi tạo mã xác thực OTP 6 số</small>
        </div>

        <button type="button" id="btnSendOtp" class="btn-playful btn-playful-primary magnet-btn" style="width: 100%; padding: 12px; font-size: 0.95rem;">
          <span>Gửi Mã Xác Thực OTP</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>

      <!-- BƯỚC 2: NHẬP OTP & MẬT KHẨU MỚI -->
      <div id="stepResetPass" style="display: none;">
        <div id="demoOtpBox" style="background: rgba(255, 184, 0, 0.15); border: 1.5px dashed #B45309; color: #92400E; padding: 12px 14px; border-radius: var(--radius-sm); margin-bottom: 16px; font-size: 0.85rem;">
          <div style="font-weight: 800; display: flex; align-items: center; gap: 6px;">
            <span class="telemetry-pulse yellow"></span>
            <span>Mã OTP Demo Kiểm Thử:</span>
          </div>
          <div style="font-size: 1.35rem; font-weight: 800; font-family: var(--f-heading); letter-spacing: 4px; margin-top: 4px; color: #B45309;" id="dispDemoOtp">
            ------
          </div>
          <div style="font-size: 0.75rem; margin-top: 2px;">(Mã có hiệu lực trong vòng 10 phút)</div>
        </div>

        <div id="resetAlert" style="display: none; margin-bottom: 14px; padding: 10px 14px; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 600;"></div>

        <div class="form-group" style="margin-bottom: 14px;">
          <label class="form-label" for="inputOtpCode">Mã OTP (6 chữ số) <span style="color: var(--c-secondary);">*</span></label>
          <input type="text" id="inputOtpCode" maxlength="6" class="form-control" placeholder="123456" style="letter-spacing: 3px; font-weight: 700; font-size: 1.1rem; text-align: center;">
        </div>

        <div class="form-group" style="margin-bottom: 14px;">
          <label class="form-label" for="inputNewPassword">Mật khẩu mới <span style="color: var(--c-secondary);">*</span></label>
          <input type="password" id="inputNewPassword" class="form-control" placeholder="Tối thiểu 6 ký tự">
        </div>

        <div class="form-group" style="margin-bottom: 20px;">
          <label class="form-label" for="inputConfirmPassword">Xác nhận mật khẩu mới <span style="color: var(--c-secondary);">*</span></label>
          <input type="password" id="inputConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới">
        </div>

        <div style="display: flex; gap: 10px;">
          <button type="button" id="btnBackToEmail" class="btn btn-secondary" style="flex: 1;">
            ← Quay Lại
          </button>
          <button type="button" id="btnSubmitReset" class="btn-playful btn-playful-primary magnet-btn" style="flex: 2; padding: 12px; font-size: 0.95rem;">
            <span>Lưu Mật Khẩu Mới</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <script src="/public/js/login.js"></script>
  <script>
    function switchAuthTab(tab) {
      const loginPanel = document.getElementById('authLoginPanel');
      const regPanel = document.getElementById('authRegisterPanel');
      const btnLog = document.getElementById('tabBtnLogin');
      const btnReg = document.getElementById('tabBtnRegister');

      if (tab === 'register') {
        loginPanel.style.display = 'none';
        regPanel.style.display = 'block';
        btnReg.style.background = 'var(--c-text-main)';
        btnReg.style.color = '#FFF';
        btnReg.style.fontWeight = '800';
        btnLog.style.background = 'transparent';
        btnLog.style.color = 'var(--c-text-dim)';
        btnLog.style.fontWeight = '700';
      } else {
        loginPanel.style.display = 'block';
        regPanel.style.display = 'none';
        btnLog.style.background = 'var(--c-text-main)';
        btnLog.style.color = '#FFF';
        btnLog.style.fontWeight = '800';
        btnReg.style.background = 'transparent';
        btnReg.style.color = 'var(--c-text-dim)';
        btnReg.style.fontWeight = '700';
      }
    }

    function quickFill(email, pwd) {
      switchAuthTab('login');
      document.getElementById('email').value = email;
      document.getElementById('password').value = pwd;
      document.getElementById('email').focus();
    }

    function fillSampleCard() {
      document.getElementById('regCardUrl').value = '/images/cards/the_hoc_sinh_chuyen_stem.jpg';
      const preview = document.getElementById('cardPreviewBox');
      preview.innerHTML = '<span style="font-size:0.65rem; font-weight:800; color:#047857; text-align:center;">✓ THẺ HỢP LỆ</span>';
      preview.style.background = '#ECFDF5';
      preview.style.borderColor = '#A7F3D0';
    }

    async function handleRegisterSubmit(e) {
      e.preventDefault();
      const btn = document.getElementById('btnRegisterSubmit');
      const alertBox = document.getElementById('regAlertBox');
      alertBox.style.display = 'none';

      const hoTen = document.getElementById('regHoTen').value.trim();
      const email = document.getElementById('regEmail').value.trim();
      const matKhau = document.getElementById('regPass').value;
      const lop = document.getElementById('regClass').value;
      const anhTheHocSinh = document.getElementById('regCardUrl').value.trim();
      const autoVerifyCard = document.querySelector('input[name="autoVerifyCard"]:checked').value === 'true';

      btn.disabled = true;
      btn.innerHTML = 'Đang quét thẻ &amp; khởi tạo hồ sơ...';

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            hoTen, email, matKhau, lop,
            truongHoc: 'THPT Chuyên STEM',
            anhTheHocSinh,
            autoVerifyCard
          })
        });

        const data = await res.json();
        alertBox.style.display = 'block';

        if (res.ok && data.success) {
          if (data.autoApproved) {
            alertBox.style.background = 'rgba(4, 120, 87, 0.1)';
            alertBox.style.color = '#047857';
            alertBox.style.border = '1.5px solid rgba(4, 120, 87, 0.3)';
            alertBox.innerHTML = `<strong>Thành công:</strong> ${data.message} Đang chuyển sang trang Đăng nhập...`;
            
            setTimeout(() => {
              switchAuthTab('login');
              document.getElementById('email').value = email;
              document.getElementById('password').value = matKhau;
              document.getElementById('email').focus();
            }, 1800);
          } else {
            alertBox.style.background = 'rgba(245, 158, 11, 0.1)';
            alertBox.style.color = '#B45309';
            alertBox.style.border = '1.5px solid rgba(245, 158, 11, 0.3)';
            alertBox.innerHTML = `<strong>Chờ duyệt:</strong> ${data.message}`;
          }
          document.getElementById('registerForm').reset();
        } else {
          alertBox.style.background = 'var(--c-error-bg)';
          alertBox.style.color = 'var(--c-error)';
          alertBox.style.border = '1.5px solid rgba(239, 68, 68, 0.3)';
          alertBox.innerHTML = `<strong>Lỗi đăng ký:</strong> ${data.message}`;
        }
      } catch (err) {
        alertBox.style.display = 'block';
        alertBox.style.background = 'var(--c-error-bg)';
        alertBox.style.color = 'var(--c-error)';
        alertBox.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span>Đăng Ký &amp; Xác Thực Thẻ Học Sinh</span> <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      }
    }

    // XỬ LÝ MODAL QUÊN MẬT KHẨU
    const forgotModal = document.getElementById('forgotModal');
    const btnOpenForgot = document.getElementById('btnOpenForgotModal');
    const btnCloseForgot = document.getElementById('btnCloseForgotModal');
    const btnSendOtp = document.getElementById('btnSendOtp');
    const btnSubmitReset = document.getElementById('btnSubmitReset');
    const btnBackToEmail = document.getElementById('btnBackToEmail');

    const stepForgotEmail = document.getElementById('stepForgotEmail');
    const stepResetPass = document.getElementById('stepResetPass');
    const forgotAlert = document.getElementById('forgotAlert');
    const resetAlert = document.getElementById('resetAlert');

    let currentResetEmail = '';

    btnOpenForgot.addEventListener('click', () => {
      forgotModal.style.display = 'flex';
      stepForgotEmail.style.display = 'block';
      stepResetPass.style.display = 'none';
      forgotAlert.style.display = 'none';
      resetAlert.style.display = 'none';
      document.getElementById('forgotEmail').value = document.getElementById('email').value || '';
      document.getElementById('forgotEmail').focus();
    });

    btnCloseForgot.addEventListener('click', () => {
      forgotModal.style.display = 'none';
    });

    forgotModal.addEventListener('click', (e) => {
      if (e.target === forgotModal) {
        forgotModal.style.display = 'none';
      }
    });

    btnBackToEmail.addEventListener('click', () => {
      stepForgotEmail.style.display = 'block';
      stepResetPass.style.display = 'none';
    });

    btnSendOtp.addEventListener('click', async () => {
      forgotAlert.style.display = 'none';
      const email = document.getElementById('forgotEmail').value.trim();

      if (!email) {
        forgotAlert.textContent = 'Vui lòng nhập địa chỉ email.';
        forgotAlert.style.display = 'block';
        forgotAlert.style.background = '#FFF1F2';
        forgotAlert.style.color = '#BE123C';
        return;
      }

      btnSendOtp.disabled = true;
      btnSendOtp.textContent = 'Đang kiểm tra...';

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          currentResetEmail = data.email;
          document.getElementById('dispDemoOtp').textContent = data.otp;
          document.getElementById('inputOtpCode').value = data.otp;
          stepForgotEmail.style.display = 'none';
          stepResetPass.style.display = 'block';
          document.getElementById('inputNewPassword').focus();
        } else {
          forgotAlert.textContent = data.message || 'Không tìm thấy tài khoản.';
          forgotAlert.style.display = 'block';
          forgotAlert.style.background = '#FFF1F2';
          forgotAlert.style.color = '#BE123C';
        }
      } catch (err) {
        forgotAlert.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
        forgotAlert.style.display = 'block';
        forgotAlert.style.background = '#FFF1F2';
        forgotAlert.style.color = '#BE123C';
      } finally {
        btnSendOtp.disabled = false;
        btnSendOtp.textContent = 'Gửi Mã Xác Thực OTP';
      }
    });

    btnSubmitReset.addEventListener('click', async () => {
      resetAlert.style.display = 'none';
      const otp = document.getElementById('inputOtpCode').value.trim();
      const newPassword = document.getElementById('inputNewPassword').value;
      const confirmPassword = document.getElementById('inputConfirmPassword').value;

      if (!otp || !newPassword || !confirmPassword) {
        resetAlert.textContent = 'Vui lòng nhập đầy đủ mã OTP và mật khẩu mới.';
        resetAlert.style.display = 'block';
        resetAlert.style.background = '#FFF1F2';
        resetAlert.style.color = '#BE123C';
        return;
      }

      if (newPassword.length < 6) {
        resetAlert.textContent = 'Mật khẩu mới phải có tối thiểu 6 ký tự.';
        resetAlert.style.display = 'block';
        resetAlert.style.background = '#FFF1F2';
        resetAlert.style.color = '#BE123C';
        return;
      }

      if (newPassword !== confirmPassword) {
        resetAlert.textContent = 'Mật khẩu xác nhận không khớp.';
        resetAlert.style.display = 'block';
        resetAlert.style.background = '#FFF1F2';
        resetAlert.style.color = '#BE123C';
        return;
      }

      btnSubmitReset.disabled = true;
      btnSubmitReset.textContent = 'Đang lưu...';

      try {
        const res = await fetch('/api/auth/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: currentResetEmail,
            otp,
            newPassword
          })
        });
        const data = await res.json();

        if (res.ok && data.success) {
          alert('Đặt lại mật khẩu thành công! Hãy đăng nhập bằng mật khẩu mới.');
          forgotModal.style.display = 'none';
          document.getElementById('email').value = currentResetEmail;
          document.getElementById('password').value = newPassword;
          document.getElementById('btnLogin').focus();
        } else {
          resetAlert.textContent = data.message || 'Mã OTP không chính xác.';
          resetAlert.style.display = 'block';
          resetAlert.style.background = '#FFF1F2';
          resetAlert.style.color = '#BE123C';
        }
      } catch (err) {
        resetAlert.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
        resetAlert.style.display = 'block';
        resetAlert.style.background = '#FFF1F2';
        resetAlert.style.color = '#BE123C';
      } finally {
        btnSubmitReset.disabled = false;
        btnSubmitReset.textContent = 'Lưu Mật Khẩu Mới';
      }
    });
  </script>
  <script src="/js/theme-engine.js"></script>
</body>
</html>
