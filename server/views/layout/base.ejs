<%#
  base.ejs — Layout chung (dùng với EJS layouts nếu cần)
  Hiện tại mỗi view tự include CSS trực tiếp.
  File này là template base dự phòng cho future refactor.
-%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
