<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hồ Sơ Cá Nhân | STEM Robotic Edu</title>
  <link rel="stylesheet" href="/css/theme.css">
  <style>
    .profile-layout {
      max-width: 1100px;
      margin: 40px auto;
      padding: 0 24px;
    }
    .profile-grid {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 32px;
      margin-top: 24px;
    }
    @media (max-width: 860px) {
      .profile-grid {
        grid-template-columns: 1fr;
      }
    }
    .avatar-wrapper {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid var(--c-text-main);
      box-shadow: 4px 4px 0 var(--c-primary);
      overflow: hidden;
      background: #E0E7FF;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }
    .avatar-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  </style>
</head>
<body>
  <!-- Nền Blobs lơ lửng -->
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <!-- NAVBAR ĐỒNG BỘ TOÀN HỆ THỐNG -->
  <header class="main-navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <div class="nav-brand-symbol">
          <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <div class="nav-brand-text">STEM Robotic</div>
          <div class="nav-brand-tag">Hồ Sơ Cá Nhân &amp; Tài Khoản</div>
        </div>
      </a>

      <ul class="nav-links">
        <li>
          <a href="<%= user.VaiTro === 'Admin' ? '/admin' : (user.VaiTro === 'Giáo viên' ? '/teacher' : '/student') %>" class="nav-link">
            ← Quay Lại Không Gian <%= user.VaiTro %>
          </a>
        </li>
        <li>
          <a href="/community" class="nav-link">Cộng Đồng</a>
        </li>
        <li>
          <a href="/logout" class="btn btn-secondary btn-sm" style="color: var(--c-secondary); border-color: rgba(239, 68, 68, 0.3);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Đăng xuất
          </a>
        </li>
      </ul>
    </div>
  </header>

  <main class="profile-layout">
    <!-- Breadcrumb -->
    <div style="font-size: 0.85rem; color: var(--c-text-dim); margin-bottom: 20px; font-weight: 600;">
      <a href="/" style="color: var(--c-text-dim);">Trang chủ</a>
      <span style="margin: 0 8px;">/</span>
      <span>Tài khoản</span>
      <span style="margin: 0 8px;">/</span>
      <span style="color: var(--c-primary);">Hồ sơ cá nhân &amp; Cài đặt bảo mật</span>
    </div>

    <!-- Alert Box -->
    <div id="profileAlert" style="display:none; margin-bottom: 24px; padding: 14px 20px; border-radius: var(--radius-sm); font-size: 0.95rem; font-weight: 600;"></div>

    <div class="profile-grid">
      <!-- CỘT TRÁI: THẺ THÔNG TIN TỔNG QUAN -->
      <div>
        <div class="bento-card bouncy-up visible" style="border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary); text-align: center; display: flex; flex-direction: column; align-items: center;">
          <div class="avatar-wrapper" id="profileAvatarPreview">
            <% if (profile.AnhDaiDien && profile.AnhDaiDien.trim().length > 0) { %>
              <img src="<%= profile.AnhDaiDien %>" alt="Avatar" id="userAvatarImg" onerror="this.src=''; this.parentElement.innerHTML='<svg width=\'54\' height=\'54\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'#5A52FF\' stroke-width=\'2\'><path d=\'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\'/><circle cx=\'12\' cy=\'7\' r=\'4\'/></svg>'">
            <% } else { %>
              <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#5A52FF" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            <% } %>
          </div>

          <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 4px;" id="dispHoTen"><%= profile.HoTen %></h2>
          <p style="color: var(--c-text-dim); font-size: 0.9rem; margin-bottom: 12px;"><%= profile.Email %></p>

          <div style="display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px;">
            <span class="tech-chip" style="background: rgba(90, 82, 255, 0.12); color: var(--c-primary); font-weight: 700;">
              <%= profile.VaiTro %>
            </span>
            <span class="tech-chip" style="background: rgba(4, 120, 87, 0.1); color: #047857; font-weight: 700;">
              <span class="telemetry-pulse"></span>
              <%= profile.TrangThai || 'Đang hoạt động' %>
            </span>
          </div>

          <!-- Divider -->
          <div style="width: 100%; border-top: 1.5px dashed rgba(11, 15, 25, 0.12); margin: 16px 0;"></div>

          <!-- Thông số hoạt động -->
          <div style="width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; text-align: left;">
            <div style="background: var(--c-bg); padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid rgba(11, 15, 25, 0.06);">
              <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--c-text-dim);">Bài đã nộp</div>
              <div style="font-size: 1.4rem; font-weight: 800; font-family: var(--f-heading); color: var(--c-text-main);">
                <%= stats.TongBaiNop || 0 %>
              </div>
            </div>
            <div style="background: var(--c-bg); padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid rgba(11, 15, 25, 0.06);">
              <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--c-text-dim);">Điểm cao nhất</div>
              <div style="font-size: 1.4rem; font-weight: 800; font-family: var(--f-heading); color: #047857;">
                <%= stats.DiemCaoNhat !== null ? stats.DiemCaoNhat : '--' %>/10
              </div>
            </div>
          </div>

          <!-- Thông tin Lớp học & Nhà trường -->
          <div style="width: 100%; margin-top: 14px; background: rgba(90, 82, 255, 0.05); border: 1.5px dashed rgba(90, 82, 255, 0.25); border-radius: 14px; padding: 12px 14px; text-align: left; font-size: 0.85rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span style="font-weight: 700; color: var(--c-text-dim);">Lớp học:</span>
              <strong style="color: var(--c-primary); font-size: 0.95rem;"><%= profile.Lop || '10/1' %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span style="font-weight: 700; color: var(--c-text-dim);">Trường:</span>
              <strong><%= profile.TruongHoc || 'THPT Chuyên STEM' %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <span style="font-weight: 700; color: var(--c-text-dim);">GVCN:</span>
              <strong>TS. Đặng Hùng Vĩ</strong>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: 700; color: var(--c-text-dim);">Thẻ học sinh:</span>
              <span class="tech-chip" style="margin: 0; padding: 2px 8px; font-size: 0.72rem; background: rgba(4, 120, 87, 0.12); color: #047857; font-weight: 800;">
                <%= profile.TrangThaiXacThucThe || 'Đã xác thực' %>
              </span>
            </div>
          </div>

          <div style="width: 100%; margin-top: 14px; font-size: 0.8rem; color: var(--c-text-dim); text-align: left;">
            <span>Mã học sinh: <strong><%= profile.MaDinhDanhHS || ('HS10-01-' + String(profile.MaNguoiDung).padStart(3, '0')) %></strong></span><br>
            <span>Ngày đăng ký: <strong><%= profile.NgayTao ? new Date(profile.NgayTao).toLocaleDateString('vi-VN') : '14/11/2026' %></strong></span>
          </div>
        </div>
      </div>

      <!-- CỘT PHẢI: FORM CẬP NHẬT HỒ SƠ & BẢO MẬT -->
      <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Form cập nhật thông tin cá nhân -->
        <div class="bento-card bouncy-up visible" style="border: 2px solid var(--c-text-main); box-shadow: 4px 4px 0 var(--c-primary);">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
            <div class="b-icon-box" style="width: 42px; height: 42px; margin-bottom: 0; color: var(--c-primary); background: rgba(90, 82, 255, 0.1);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">Thông Tin Cá Nhân</h3>
              <p style="font-size: 0.82rem; color: var(--c-text-dim); margin: 0;">Cập nhật họ tên hiển thị và thông tin liên hệ của bạn</p>
            </div>
          </div>

          <form id="profileForm">
            <div class="form-group" style="margin-bottom: 16px;">
              <label for="inputHoTen" class="form-label">Họ và tên hiển thị <span style="color: var(--c-secondary);">*</span></label>
              <input type="text" id="inputHoTen" class="form-control" value="<%= profile.HoTen %>" required placeholder="Nhập họ và tên đầy đủ">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
              <div class="form-group">
                <label for="inputEmail" class="form-label">Email tài khoản (Cố định)</label>
                <input type="email" id="inputEmail" class="form-control" value="<%= profile.Email %>" disabled style="background: rgba(11, 15, 25, 0.05); color: var(--c-text-dim); cursor: not-allowed;">
              </div>
              <div class="form-group">
                <label for="inputSoDienThoai" class="form-label">Số điện thoại liên hệ</label>
                <input type="tel" id="inputSoDienThoai" class="form-control" value="<%= profile.SoDienThoai || '' %>" placeholder="Ví dụ: 0912345678">
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
              <label for="inputAnhDaiDien" class="form-label">Đường dẫn ảnh đại diện (URL)</label>
              <input type="url" id="inputAnhDaiDien" class="form-control" value="<%= profile.AnhDaiDien || '' %>" placeholder="https://example.com/avatar.jpg">
              <small style="color: var(--c-text-dim); font-size: 0.78rem; display: block; margin-top: 4px;">Dán liên kết ảnh trực tiếp để làm ảnh đại diện trên hệ thống và bảng vinh danh</small>
            </div>

            <!-- Divider Đổi Mật Khẩu -->
            <div style="border-top: 1.5px dashed rgba(11, 15, 25, 0.12); padding-top: 20px; margin-bottom: 20px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span style="font-weight: 800; font-size: 0.95rem;">Đổi Mật Khẩu Bảo Mật (Tùy chọn)</span>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                <div class="form-group">
                  <label for="inputMatKhauCu" class="form-label" style="font-size: 0.8rem;">Mật khẩu hiện tại</label>
                  <input type="password" id="inputMatKhauCu" class="form-control" placeholder="••••••">
                </div>
                <div class="form-group">
                  <label for="inputMatKhauMoi" class="form-label" style="font-size: 0.8rem;">Mật khẩu mới</label>
                  <input type="password" id="inputMatKhauMoi" class="form-control" placeholder="Tối thiểu 6 ký tự">
                </div>
                <div class="form-group">
                  <label for="inputXacNhanMatKhau" class="form-label" style="font-size: 0.8rem;">Nhập lại mật khẩu</label>
                  <input type="password" id="inputXacNhanMatKhau" class="form-control" placeholder="Khớp mật khẩu mới">
                </div>
              </div>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
              <button type="submit" id="btnSaveProfile" class="btn-playful btn-playful-primary magnet-btn" style="padding: 12px 28px; font-size: 0.95rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                Lưu Thay Đổi Hồ Sơ
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script>
    const form = document.getElementById('profileForm');
    const alertBox = document.getElementById('profileAlert');
    const btnSave = document.getElementById('btnSaveProfile');

    function showAlert(msg, isSuccess) {
      alertBox.textContent = msg;
      alertBox.style.display = 'block';
      if (isSuccess) {
        alertBox.style.background = '#ECFDF5';
        alertBox.style.color = '#047857';
        alertBox.style.border = '1.5px solid #A7F3D0';
      } else {
        alertBox.style.background = '#FFF1F2';
        alertBox.style.color = '#BE123C';
        alertBox.style.border = '1.5px solid #FECDD3';
      }
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.style.display = 'none';

      const hoTen = document.getElementById('inputHoTen').value.trim();
      const soDienThoai = document.getElementById('inputSoDienThoai').value.trim();
      const anhDaiDien = document.getElementById('inputAnhDaiDien').value.trim();
      const matKhauHienTai = document.getElementById('inputMatKhauCu').value;
      const matKhauMoi = document.getElementById('inputMatKhauMoi').value;
      const xacNhanMatKhau = document.getElementById('inputXacNhanMatKhau').value;

      if (!hoTen) {
        showAlert('Họ và tên không được để trống.', false);
        return;
      }

      if (matKhauMoi) {
        if (!matKhauHienTai) {
          showAlert('Vui lòng nhập mật khẩu hiện tại để xác nhận đổi mật khẩu.', false);
          return;
        }
        if (matKhauMoi.length < 6) {
          showAlert('Mật khẩu mới phải có tối thiểu 6 ký tự.', false);
          return;
        }
        if (matKhauMoi !== xacNhanMatKhau) {
          showAlert('Mật khẩu xác nhận không khớp với mật khẩu mới.', false);
          return;
        }
      }

      btnSave.disabled = true;
      btnSave.textContent = 'Đang lưu...';

      try {
        const res = await fetch('/api/auth/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            hoTen,
            soDienThoai,
            anhDaiDien,
            matKhauHienTai,
            matKhauMoi
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          showAlert(data.message || 'Cập nhật thông tin hồ sơ thành công!', true);
          document.getElementById('dispHoTen').textContent = hoTen;
          // Xóa trường mật khẩu sau khi đổi thành công
          document.getElementById('inputMatKhauCu').value = '';
          document.getElementById('inputMatKhauMoi').value = '';
          document.getElementById('inputXacNhanMatKhau').value = '';

          // Cập nhật avatar preview nếu có
          if (anhDaiDien) {
            document.getElementById('profileAvatarPreview').innerHTML = `<img src="${anhDaiDien}" alt="Avatar" onerror="this.parentElement.innerHTML='<svg width=\\'54\\' height=\\'54\\' viewBox=\\'0 0 24 24\\' fill=\\'none\\' stroke=\\'#5A52FF\\' stroke-width=\\'2\\'><path d=\\'M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\\'/><circle cx=\\'12\\' cy=\\'7\\' r=\\'4\\'/></svg>'">`;
          }
        } else {
          showAlert(data.message || 'Cập nhật thất bại. Vui lòng kiểm tra lại.', false);
        }
      } catch (err) {
        showAlert('Lỗi kết nối máy chủ: ' + err.message, false);
      } finally {
        btnSave.disabled = false;
        btnSave.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg> Lưu Thay Đổi Hồ Sơ`;
      }
    });
  </script>
  <script src="/js/theme-engine.js"></script>
</body>
</html>
